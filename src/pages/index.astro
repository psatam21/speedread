    .reading-methods { padding: clamp(4rem, 9vw, 7rem) 0; background: var(--color-bg); }
    .reading-methods-heading { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.7fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
    .section-label { margin: 0 0 0.75rem; color: var(--color-primary); font-weight: 700; }
