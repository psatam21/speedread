    .outcomes-heading { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; }
    .outcomes-heading h2 { max-width: min(18ch, 100%); margin: 0; font-size: clamp(2.2rem, 5vw, 3.75rem); line-height: 1.05; letter-spacing: -0.04em; text-wrap: balance; }
