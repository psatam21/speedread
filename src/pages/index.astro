    .hero-import-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
    .hero-import-option {
      min-height: 8.5rem;
      padding: 1.15rem 1.2rem 1.25rem;
      text-align: left;
      border: 0;
      border-right: 1px solid var(--color-border);
