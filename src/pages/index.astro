  <!-- Core JavaScript Script Loader & App Logic -->
  <script is:inline src="/reader-core.js"></script>
  <script is:inline src="/brisk-features.js"></script>
  <script is:inline>
    // State management
    const state = {
      text: "",
      words: [],
      wordObjects: [],
      currentIndex: 0,
      wpm: 350,
      isPlaying: false,
      mode: 'rsvp', // rsvp, phrase, focus, flow, bionic, standard
      theme: 'light',
      font: 'sans',
      fontSize: 24,
      sourceLabel: '',
      ttsActive: false,
      timer: null,
      ttsUtterance: null,
      ttsChunks: [],
      ttsChunkIndex: 0,
      ttsRunId: 0,
      isPremium: false,
      libraryId: null,
      lastRetentionIndex: 0,
      retentionOpen: false,
      chapters: [],
      stats: {
        wordsRead: 0,
        timeSpent: 0,
        streak: 0,
        lastReadDate: ""
      }
    };

    const BF = () => window.BriskFeatures || null;

    // ── Device-bound premium ──────────────────────────────────────────
    let accountUser = null;
    window.addEventListener('briskread:account', (event) => {
      accountUser = event.detail?.user || null;
      if (event.detail?.premium) {
        state.isPremium = true;
        applyPremiumUI();
      }
      const copy = document.getElementById('account-purchase-copy');
      const signInButton = document.getElementById('btn-pricing-signin');
      if (copy) {
        copy.textContent = accountUser
          ? `Signed in as ${accountUser.email}. Your purchase will attach to this account.`
          : 'Sign in before checkout so Lifetime Premium is attached to your account automatically.';
      }
      signInButton?.classList.toggle('hidden', Boolean(accountUser));
      // Cross-device library / queue sync
      if (accountUser) {
        pullAndMergeWorkspace();
      } else {
        BF()?.setSyncHandler(null);
        setSyncStatus('Sign in to sync library across devices');
      }
    });

    const getDeviceId = () => {
      let id = localStorage.getItem('device_id');
      if (!id) {
        id = (typeof crypto !== 'undefined' && crypto.randomUUID)
          ? crypto.randomUUID()
          : `d-${Date.now()}-${Math.random().toString(36).slice(2, 12)}`;
        localStorage.setItem('device_id', id);
      }
      return id;
    };

    const getDeviceLabel = () => {
      const ua = navigator.userAgent || '';
      let browser = 'Browser';
      if (/Edg\//.test(ua)) browser = 'Edge';
      else if (/Chrome\//.test(ua)) browser = 'Chrome';
      else if (/Firefox\//.test(ua)) browser = 'Firefox';
      else if (/Safari\//.test(ua)) browser = 'Safari';
      let os = 'Device';
      if (/Windows/.test(ua)) os = 'Windows';
      else if (/Mac OS|Macintosh/.test(ua)) os = 'Mac';
      else if (/Android/.test(ua)) os = 'Android';
      else if (/iPhone|iPad/.test(ua)) os = 'iOS';
      return `${browser} on ${os}`;
    };

    const getStoredLicenseKey = () => localStorage.getItem('license_key') || '';
    /** Device session only — never fall back to raw license key for APIs */
    const getDeviceSession = () => localStorage.getItem('premium_token') || '';

    const clearPremiumLocal = () => {
      localStorage.removeItem('is_premium');
      localStorage.removeItem('premium_token');
      state.isPremium = false;
    };

    const renderDeviceList = (devices = [], maxDevices = 5) => {
      const wrap = document.getElementById('device-list-wrap');
      const list = document.getElementById('device-list');
      const count = document.getElementById('device-count');
      if (!wrap || !list) return;
      if (!devices.length) {
        wrap.classList.add('hidden');
        return;
      }
      wrap.classList.remove('hidden');
      if (count) count.textContent = `${devices.length} / ${maxDevices}`;
      const currentId = getDeviceId();
      list.innerHTML = devices.map((d) => {
        const label = (d.label || 'Device').replace(/</g, '&lt;');
        const current = d.id === currentId || d.is_current;
        const idAttr = String(d.id).replace(/"/g, '');
        return `<li class="device-item${current ? ' is-current' : ''}">
          <span class="device-item-label">${label}${current ? ' <em>(this device)</em>' : ''}</span>
          ${current ? '' : `<button type="button" class="btn btn-secondary btn-sm btn-revoke-device" data-device-id="${idAttr}">Revoke</button>`}
        </li>`;
      }).join('');
    };

    const unlockPremium = ({ licenseKey, sessionToken, devices, maxDevices }) => {
      if (licenseKey) localStorage.setItem('license_key', licenseKey);
      if (sessionToken) {
        localStorage.setItem('premium_token', sessionToken);
        localStorage.setItem('is_premium', 'true');
        state.isPremium = true;
      }
      if (devices) {
        try { localStorage.setItem('premium_devices', JSON.stringify({ devices, maxDevices: maxDevices || 5 })); } catch (_) {}
        renderDeviceList(devices, maxDevices || 5);
      }
      applyPremiumUI();
    };

    const applyPremiumUI = () => {
      try { renderWorkspace(); } catch (_) { /* workspace may not be ready yet */ }
      const licenseDisplay = document.getElementById('license-display');
      const licenseKeyDisplay = document.getElementById('license-key-display');
      const storedKey = getStoredLicenseKey();

      if (storedKey && licenseKeyDisplay) {
        licenseKeyDisplay.value = storedKey;
        if (licenseDisplay) licenseDisplay.classList.remove('hidden');
      }

      try {
        const cached = JSON.parse(localStorage.getItem('premium_devices') || 'null');
        if (cached?.devices) renderDeviceList(cached.devices, cached.maxDevices || 5);
      } catch (_) {}

      if (state.isPremium) {
        document.querySelectorAll('.ads-section').forEach(el => el.classList.add('hidden'));

        const buyBtn = document.getElementById('btn-buy-premium');
        const claimBtn = document.getElementById('btn-claim-lifetime');
        if (buyBtn) {
          buyBtn.textContent = accountUser ? 'Lifetime Premium active' : 'Premium active on this device';
          buyBtn.disabled = true;
          buyBtn.classList.remove('hidden');
          buyBtn.classList.add('btn-premium-active');
        }
        if (claimBtn) claimBtn.classList.add('hidden');

        const tag = document.getElementById('lifetime-pricing-tag');
        if (tag) {
          tag.textContent = 'Active';
          tag.classList.add('tag-success');
        }

        const heading = document.querySelector('.license-heading');
        if (heading) heading.textContent = 'Your license & devices';
        const hint = document.querySelector('.license-hint');
        if (hint) hint.textContent = 'Keep the key private. Activate on up to 5 devices. Revoke unused devices to free slots.';
      }
    };

    /** Live founding seat counter on Lifetime card (cap 50). */
    const FOUNDING_CAP = 50;
    let foundingSeats = { cap: FOUNDING_CAP, claimed: null, remaining: null, open: true };

    const applyFoundingSeatUI = (stats) => {
      if (!stats || stats.claimed == null) return;
      foundingSeats = {
        cap: stats.cap || FOUNDING_CAP,
        claimed: stats.claimed,
        remaining: stats.remaining ?? Math.max(0, (stats.cap || FOUNDING_CAP) - stats.claimed),
        open: stats.open !== false && (stats.remaining ?? 0) > 0,
      };

      const countEl = document.getElementById('lifetime-seat-count');
      const detailEl = document.getElementById('lifetime-seat-detail');
      const fillEl = document.getElementById('lifetime-seat-fill');
      const tagEl = document.getElementById('lifetime-pricing-tag');
      const priceVal = document.getElementById('lifetime-price-value');
      const priceTerm = document.getElementById('lifetime-price-term');
      const priceStrike = document.getElementById('lifetime-price-strike');
      const claimBtn = document.getElementById('btn-claim-lifetime');
      const buyBtn = document.getElementById('btn-buy-premium');
      const guarantee = document.getElementById('lifetime-guarantee');
      const footnote = document.getElementById('lifetime-footnote');
      const meter = document.getElementById('lifetime-seat-meter');

      const { cap, claimed, remaining, open } = foundingSeats;
      const pct = Math.min(100, Math.round((claimed / cap) * 100));

      if (countEl) countEl.textContent = `${claimed} / ${cap} claimed · ${remaining} left`;
      if (fillEl) fillEl.style.width = `${pct}%`;
      if (detailEl) {
        detailEl.textContent = open
          ? `Lifetime is free for a limited time — ${remaining} free seat${remaining === 1 ? '' : 's'} left. Create an account to unlock automatically.`
          : 'Free seats are full. Lifetime is $9 one-time forever.';
      }
      if (meter) meter.classList.toggle('seat-meter-full', !open);

      if (state.isPremium) return;

      if (open) {
        if (tagEl) {
          tagEl.textContent = 'Lifetime · free limited time';
          tagEl.classList.remove('tag-success');
        }
        if (priceVal) priceVal.textContent = 'Free';
        if (priceTerm) priceTerm.textContent = 'for the first 50 accounts · forever';
        if (priceStrike) {
          priceStrike.textContent = '$9';
          priceStrike.classList.remove('hidden');
        }
        if (claimBtn) {
          claimBtn.classList.remove('hidden');
          claimBtn.textContent = remaining <= 10
            ? `Claim free Lifetime — ${remaining} left`
            : 'Create free account — unlock Lifetime';
        }
        if (buyBtn) buyBtn.classList.add('hidden');
        if (guarantee) {
          guarantee.innerHTML = `<strong>Limited free seats.</strong> Create an account while seats remain — Lifetime unlocks automatically. After ${cap}, Lifetime is $9 one-time with a 30-day money-back guarantee.`;
        }
        if (footnote) footnote.textContent = 'No card required for free seats. Same account restores Premium on your other devices.';
      } else {
        if (tagEl) {
          tagEl.textContent = 'Lifetime · $9';
          tagEl.classList.remove('tag-success');
        }
        if (priceVal) priceVal.textContent = '$9';
        if (priceTerm) priceTerm.textContent = 'one-time · forever';
        if (priceStrike) {
          priceStrike.textContent = '~$15/mo apps';
          priceStrike.classList.remove('hidden');
        }
        if (claimBtn) claimBtn.classList.add('hidden');
        if (buyBtn) {
          buyBtn.classList.remove('hidden');
          buyBtn.disabled = false;
          buyBtn.classList.remove('btn-premium-active');
          buyBtn.textContent = 'Get Lifetime — $9';
        }
        if (guarantee) {
          guarantee.innerHTML = '<strong>30-day money-back guarantee.</strong> Email us within 30 days for a full refund, no reason required.';
        }
        if (footnote) footnote.textContent = 'Sign in once at checkout. Premium restores on your other devices with the same account.';
      }
    };

    const loadFoundingSeats = async () => {
      try {
        const supabase = globalThis.briskreadSupabase;
        if (supabase) {
          const { data, error } = await supabase.rpc('founding_seat_stats');
          if (!error && data) {
            applyFoundingSeatUI(data);
            return;
          }
        }
      } catch (_) { /* fall through */ }

      try {
        const res = await fetch('/api/founding-seats');
        if (res.ok) applyFoundingSeatUI(await res.json());
        else if (document.getElementById('lifetime-seat-count')) {
          document.getElementById('lifetime-seat-count').textContent = 'Seat count unavailable';
        }
      } catch (_) {
        const countEl = document.getElementById('lifetime-seat-count');
        if (countEl) countEl.textContent = 'Seat count unavailable';
      }
    };

    loadFoundingSeats();
    window.addEventListener('briskread:account', () => {
      // Refresh count after a grant may have consumed a seat
      window.setTimeout(loadFoundingSeats, 400);
    });

    /**
     * Validate premium without burning an extra device slot.
     * - Extension handoff already provides a device session → trust it (no re-bind).
     * - Web-native session present → keep offline-capable; re-bind only if missing session.
     * - Forged is_premium without license → strip.
     */
    const revalidatePremium = async () => {
      const license = getStoredLicenseKey();
      const session = getDeviceSession();
      const forgedFlag = localStorage.getItem('is_premium') === 'true' && !license && !session;
      if (forgedFlag) {
        clearPremiumLocal();
        applyPremiumUI();
        return;
      }

      // Session from extension or prior activate: do not re-POST activate (would double-bind)
      if (session) {
        state.isPremium = true;
        localStorage.setItem('is_premium', 'true');
        applyPremiumUI();
        return;
      }

      if (!license) return;

      try {
        const res = await fetch('/api/activate-license', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            license_key: license,
            device_id: getDeviceId(),
            device_label: getDeviceLabel(),
          }),
        });
        const data = await res.json();
        if (res.ok && data.ok && data.token) {
          unlockPremium({
            licenseKey: data.license_key || license,
            sessionToken: data.token,
            devices: data.devices,
            maxDevices: data.max_devices,
          });
        } else if (data.code === 'DEVICE_LIMIT') {
          localStorage.removeItem('premium_token');
          localStorage.setItem('is_premium', 'false');
          state.isPremium = false;
          if (data.devices) renderDeviceList(data.devices, data.max_devices || 5);
          applyPremiumUI();
          const status = document.getElementById('license-status');
          if (status) status.textContent = data.error || 'Device limit reached. Revoke another device.';
        } else if (data.code === 'INVALID_KEY' || res.status === 401) {
          localStorage.removeItem('license_key');
          clearPremiumLocal();
          applyPremiumUI();
        }
      } catch (_) {
        state.isPremium = localStorage.getItem('is_premium') === 'true' && !!getDeviceSession();
        applyPremiumUI();
      }
    };

    const loadState = () => {
      state.wpm = parseInt(localStorage.getItem('wpm') || '350');
      state.theme = localStorage.getItem('theme') || 'light';
      state.font = localStorage.getItem('font') || 'sans';
      state.fontSize = parseInt(localStorage.getItem('fontSize') || '24');
      // Require device session — bare license key or forged flag is not enough
      state.isPremium = localStorage.getItem('is_premium') === 'true' && !!getDeviceSession();
      
      const statsJson = localStorage.getItem('stats');
      if (statsJson) {
        state.stats = JSON.parse(statsJson);
      } else {
        state.stats = { wordsRead: 0, timeSpent: 0, streak: 0, lastReadDate: "" };
      }
      
      document.getElementById('slider-wpm').value = state.wpm;
      document.getElementById('wpm-display').textContent = state.wpm;
      
      document.getElementById('slider-font-size').value = state.fontSize;
      document.getElementById('font-size-display').textContent = state.fontSize;
      
      document.getElementById('select-font').value = state.font;
      document.documentElement.setAttribute('data-font', state.font);
      
      updateStatsUI();
      applyPremiumUI();
      revalidatePremium();
    };

    const updateStatsUI = () => {
      document.getElementById('stats-words').textContent = state.stats.wordsRead.toLocaleString();
      document.getElementById('stats-time').textContent = Math.round(state.stats.timeSpent) + 'm';
      
      // Compare against the same 240 WPM baseline used in the reading scenarios.
      const traditionalTime = state.stats.wordsRead / 240;
      const briskreadTime = state.stats.timeSpent; // actual reading time
      const timeSaved = Math.max(0, traditionalTime - briskreadTime);
      document.getElementById('stats-saved').textContent = Math.round(timeSaved) + 'm';
      
      // Validate streak
      const today = new Date().toDateString();
      if (state.stats.lastReadDate === today) {
        // Already read today, streak is valid
      } else {
        const yesterday = new Date();
        yesterday.setDate(yesterday.getDate() - 1);
        if (state.stats.lastReadDate === yesterday.toDateString()) {
          // Read yesterday, streak is valid
        } else if (state.stats.lastReadDate !== "") {
          // Broke streak
          state.stats.streak = 0;
        }
      }
      document.getElementById('stats-streak').textContent = state.stats.streak;
      const streakNum = document.getElementById('dashboard-streak-num');
      if (streakNum) streakNum.textContent = String(state.stats.streak);
      document.getElementById('dashboard-streak-pill')?.classList.toggle('is-hot', state.stats.streak >= 3);
    };

    let statsSyncInFlight = false;
    const syncReadingStats = async () => {
      if (statsSyncInFlight) return;
      const supabase = globalThis.briskreadSupabase;
      if (!supabase) return;
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;

      const lastSynced = Number(localStorage.getItem('supabase_synced_words') || 0);
      const unsyncedWords = Math.floor(state.stats.wordsRead - lastSynced);
      if (unsyncedWords < 100) return;

      statsSyncInFlight = true;
      const wordsRead = Math.min(unsyncedWords, 1000000);
      const { error } = await supabase.from('reading_sessions').insert({
        user_id: session.user.id,
        words_read: wordsRead,
        reading_wpm: state.wpm,
        baseline_wpm: 240,
        seconds_spent: Math.max(1, Math.round((wordsRead / state.wpm) * 60)),
      });
      if (!error) localStorage.setItem('supabase_synced_words', String(lastSynced + wordsRead));
      statsSyncInFlight = false;
    };

    const saveStats = () => {
      localStorage.setItem('stats', JSON.stringify(state.stats));
      updateStatsUI();
      void syncReadingStats();
    };

    const {
      getOrpIndex,
      getPhraseParts,
      getFlowContext,
      clampReaderIndex,
      getPlaybackStart,
      getIndexFromPercent,
      chunkForTTS,
    } = window.BriskReadReaderCore;

    // Parse text to word mappings with coordinate tracking
    const parseText = (textVal) => {
      state.text = textVal;
      state.words = textVal.trim().split(/\s+/).filter(w => w.length > 0);
      
      state.wordObjects = [];
      const wordRegex = /\S+/g;
      let match;
      while ((match = wordRegex.exec(textVal)) !== null) {
        state.wordObjects.push({
          word: match[0],
          startIndex: match.index,
          endIndex: match.index + match[0].length
        });
      }
      state.currentIndex = 0;
    };

    const updateDocumentContext = () => {
      const hasDocument = Boolean(state.text.trim());
      const source = state.sourceLabel || 'Document';
      const wordCount = state.words.length.toLocaleString();
      const status = hasDocument ? `Loaded: ${source} · ${wordCount} words` : 'No document loaded yet';
      document.getElementById('document-status').textContent = status;
      document.getElementById('ai-document-status').textContent = hasDocument
        ? `Ready to work with ${source} (${wordCount} words).`
        : 'Load a document above, then summarize it or ask questions about it.';
      document.getElementById('btn-ai-summary').disabled = !hasDocument;
      document.getElementById('btn-ai-chat').disabled = !hasDocument;
    };

    let ttsVisualQueue = [];
    let ttsVisualTimer = null;

    const renderQueuedTTSWord = () => {
      ttsVisualTimer = null;
      const nextIndex = ttsVisualQueue.shift();
      if (nextIndex === undefined || !state.isPlaying) return;

      state.currentIndex = nextIndex;
      state.stats.wordsRead += 1;
      state.stats.timeSpent += 1 / state.wpm;
      if (state.stats.wordsRead % 50 === 0) saveStats();
      renderRSVPWord();

      if (ttsVisualQueue.length) {
        ttsVisualTimer = setTimeout(renderQueuedTTSWord, Math.max(16, 60000 / state.wpm));
      }
    };

    const queueTTSVisualWord = (matchedIndex) => {
      const lastIndex = ttsVisualQueue.length ? ttsVisualQueue[ttsVisualQueue.length - 1] : state.currentIndex;
      for (let index = lastIndex + 1; index <= matchedIndex; index += 1) {
        ttsVisualQueue.push(index);
      }
      if (!ttsVisualTimer && ttsVisualQueue.length) renderQueuedTTSWord();
    };

    // Display the current word or phrase at the fixed ORP
    const renderRSVPWord = () => {
      if (!state.words.length || state.currentIndex >= state.words.length) return;
      const word = state.words[state.currentIndex];
      if (!word) return;

      const orpIdx = getOrpIndex(word);
      const parts = state.mode === 'phrase'
        ? getPhraseParts(state.words, state.currentIndex)
        : { left: word.substring(0, orpIdx), orp: word.charAt(orpIdx), right: word.substring(orpIdx + 1) };

      // Render segments
      document.getElementById('word-left').textContent = parts.left;
      document.getElementById('word-orp').textContent = parts.orp;
      document.getElementById('word-right').textContent = parts.right;

      // Update progress sliders
      const percentage = Math.round((state.currentIndex / Math.max(1, state.words.length - 1)) * 100);
      document.querySelectorAll('[data-reader-scrubber]').forEach((slider) => { slider.value = percentage; });
      document.getElementById('reading-percentage').textContent = `Word ${state.currentIndex + 1} / ${state.words.length} (${percentage}%)`;
      
      // Est. remaining time
      const wordsLeft = state.words.length - state.currentIndex;
      const minLeft = Math.ceil(wordsLeft / state.wpm);
      document.getElementById('reading-time-left').textContent = `${minLeft} min remaining`;
      if (state.mode === 'focus') updateFocusWord();
      if (state.mode === 'flow') renderFlowWord();

      // Persist resume position + retention prompts (throttled via % 25)
      if (state.libraryId && state.currentIndex % 25 === 0) {
        persistReaderProgress(percentage);
      }
      maybeOfferRetention();
    };

    const persistReaderProgress = (pct) => {
      const api = BF();
      if (!api || !state.libraryId) return;
      const percentage = pct != null
        ? pct
        : Math.round((state.currentIndex / Math.max(1, state.words.length - 1)) * 100);
      api.updateProgress(state.libraryId, {
        index: state.currentIndex,
        mode: state.mode,
        wpm: state.wpm,
        pct: percentage,
      });
    };

    const refreshChapterSelect = () => {
      const api = BF();
      const select = document.getElementById('chapter-select');
      if (!select || !api) return;
      state.chapters = api.detectChapters(state.text, state.words);
      select.innerHTML = state.chapters.map((ch) =>
        `<option value="${ch.wordIndex}">${ch.title.replace(/</g, '')} · ${ch.pct}%</option>`
      ).join('') || '<option value="0">Beginning</option>';
    };

    const updateReaderChrome = () => {
      const titleEl = document.getElementById('reader-doc-title');
      const metaEl = document.getElementById('reader-meta');
      if (titleEl) titleEl.textContent = state.sourceLabel || 'Reader';
      if (metaEl) {
        const rem = BF()?.remainingEstimate(state.currentIndex, state.words.length, state.wpm);
        metaEl.textContent = state.words.length
          ? `${state.words.length.toLocaleString()} words · ~${rem?.minutesLeft || 0} min left`
          : '';
      }
    };

    const renderWorkspace = () => {
      const api = BF();
      if (!api) return;

      const library = api.listLibrary();
      const queue = api.listQueue();
      const libList = document.getElementById('library-list');
      const queueList = document.getElementById('queue-list');
      const libEmpty = document.getElementById('library-empty');
      const queueEmpty = document.getElementById('queue-empty');
      const capHint = document.getElementById('library-cap-hint');
      const qSum = document.getElementById('queue-summary');

      if (capHint) {
        capHint.textContent = state.isPremium
          ? 'Unlimited'
          : `${library.length} / ${api.FREE_LIBRARY_CAP} free slots`;
      }
      const qs = api.queueSummary(state.wpm);
      if (qSum) {
        qSum.textContent = qs.count
          ? `${qs.count} queued · ~${qs.minutes} min at ${state.wpm} WPM`
          : 'Queue empty';
      }

      if (libList) {
        libList.innerHTML = library.map((item) => {
          const pct = item.progress?.pct || 0;
          const safeTitle = (item.title || 'Untitled').replace(/</g, '&lt;');
          return `<li class="workspace-item" data-lib-id="${item.id}">
            <div class="workspace-item-main">
              <strong>${safeTitle}</strong>
              <span class="muted">${(item.wordCount || 0).toLocaleString()} words · ${pct}% done</span>
            </div>
            <div class="workspace-item-actions">
              <button type="button" class="btn btn-primary btn-sm" data-action="open-lib">Open</button>
              <button type="button" class="btn btn-secondary btn-sm" data-action="queue-lib">Up next</button>
              <button type="button" class="btn btn-ghost btn-sm" data-action="del-lib" title="Remove">✕</button>
            </div>
          </li>`;
        }).join('');
        libEmpty?.classList.toggle('hidden', library.length > 0);
      }

      if (queueList) {
        queueList.innerHTML = queue.map((entry) => {
          const safeTitle = (entry.title || 'Untitled').replace(/</g, '&lt;');
          const done = entry.status === 'done';
          return `<li class="workspace-item${done ? ' is-done' : ''}" data-queue-id="${entry.id}" data-lib-id="${entry.libraryId || ''}">
            <div class="workspace-item-main">
              <strong>${safeTitle}</strong>
              <span class="muted">~${entry.estimatedMinutes || 1} min · ${(entry.wordCount || 0).toLocaleString()} words${done ? ' · done' : ''}</span>
            </div>
            <div class="workspace-item-actions">
              <button type="button" class="btn btn-primary btn-sm" data-action="open-queue" ${entry.libraryId ? '' : 'disabled'}>Open</button>
              <button type="button" class="btn btn-secondary btn-sm" data-action="toggle-queue">${done ? 'Undo' : 'Done'}</button>
              <button type="button" class="btn btn-ghost btn-sm" data-action="del-queue" title="Remove">✕</button>
            </div>
          </li>`;
        }).join('');
        queueEmpty?.classList.toggle('hidden', queue.length > 0);
      }
    };

    const renderProfiles = () => {
      const api = BF();
      const wrap = document.getElementById('profile-pills');
      const hint = document.getElementById('profile-hint');
      if (!api || !wrap) return;
      const active = api.getActiveProfile();
      const activeId = active?.id || null;
      wrap.innerHTML = api.listProfiles().map((p) =>
        `<button type="button" class="profile-pill${p.id === activeId ? ' is-active' : ''}${p.saved ? ' is-saved' : ''}" data-profile="${p.id}" title="${(p.description || '').replace(/"/g, '')}">${p.label}</button>`
      ).join('');
      if (hint) {
        hint.textContent = active?.settings
          ? `${active.label} is set to your saved speed/mode. Click Save current settings to update it.`
          : 'Optional: pick a name, set speed/mode in the reader, then save.';
      }
      // Retention radios
      const settings = api.getSettings();
      const auto = document.getElementById('retention-mode-auto');
      const manual = document.getElementById('retention-mode-manual');
      if (auto) auto.checked = settings.retentionMode !== 'manual';
      if (manual) manual.checked = settings.retentionMode === 'manual';
    };

    /** Apply only user-saved profile settings — never invent mode/WPM defaults. */
    const applyProfile = (profile, { silent } = {}) => {
      if (!profile) return;
      const s = profile.settings;
      if (!s) {
        if (!silent) renderProfiles();
        return;
      }
      if (s.wpm) {
        state.wpm = s.wpm;
        const wpmSlider = document.getElementById('slider-wpm');
        const wpmDisplay = document.getElementById('wpm-display');
        if (wpmSlider) wpmSlider.value = s.wpm;
        if (wpmDisplay) wpmDisplay.textContent = s.wpm;
        localStorage.setItem('wpm', String(s.wpm));
      }
      if (s.fontSize) {
        state.fontSize = s.fontSize;
        const fs = document.getElementById('slider-font-size');
        const fd = document.getElementById('font-size-display');
        if (fs) fs.value = s.fontSize;
        if (fd) fd.textContent = s.fontSize;
        localStorage.setItem('fontSize', String(s.fontSize));
        document.querySelectorAll('.standard-reader-view, .rsvp-word-container').forEach((view) => {
          view.style.fontSize = `${state.fontSize / 6}rem`;
        });
      }
      if (s.font) {
        state.font = s.font;
        const sel = document.getElementById('select-font');
        if (sel) sel.value = s.font;
        document.documentElement.setAttribute('data-font', s.font);
        localStorage.setItem('font', s.font);
      }
      if (s.mode) {
        if (state.words.length) setMode(s.mode);
        else state.mode = s.mode;
      }
      if (!silent) renderProfiles();
    };

    const openRetentionModal = (check) => {
      if (!check || state.retentionOpen) return;
      state.retentionOpen = true;
      const wasPlaying = state.isPlaying;
      if (wasPlaying) pauseReader();
      state._retentionWasPlaying = wasPlaying;
      state._retentionCheck = check;

      const modal = document.getElementById('retention-modal');
      const body = document.getElementById('retention-body');
      if (!modal || !body) return;
      modal.hidden = false;
      modal.classList.remove('hidden');

      body.innerHTML = check.questions.map((q) => {
        const opts = (q.options || []).map((opt) =>
          `<label class="retention-opt"><input type="radio" name="ret-${q.id}" value="${String(opt).replace(/"/g, '&quot;')}" /> <span>${String(opt).replace(/</g, '&lt;')}</span></label>`
        ).join('');
        return `<div class="retention-q" data-qid="${q.id}">
          <p class="retention-prompt">${q.prompt}</p>
          <div class="retention-opts">${opts}</div>
        </div>`;
      }).join('');
    };

    const closeRetentionModal = ({ resume } = {}) => {
      const modal = document.getElementById('retention-modal');
      if (modal) {
        modal.hidden = true;
        modal.classList.add('hidden');
      }
      state.retentionOpen = false;
      if (resume && state._retentionWasPlaying) playRSVP();
      state._retentionWasPlaying = false;
      state._retentionCheck = null;
    };

    const maybeOfferRetention = () => {
      const api = BF();
      if (!api || state.retentionOpen || !state.isPlaying) return;
      if (!api.shouldOfferRetention(state.currentIndex, state.lastRetentionIndex)) return;
      const check = api.buildRetentionCheck({
        text: state.text,
        words: state.words,
        fromIndex: state.lastRetentionIndex,
        toIndex: state.currentIndex,
      });
      if (!check) {
        state.lastRetentionIndex = state.currentIndex;
        return;
      }
      state.lastRetentionIndex = state.currentIndex;
      openRetentionModal(check);
    };

    const saveCurrentToLibrary = ({ queueAfter, quiet } = {}) => {
      const api = BF();
      if (!api || !state.text.trim()) {
        if (!quiet) alert('Load a document first.');
        return null;
      }
      const percentage = Math.round((state.currentIndex / Math.max(1, state.words.length - 1)) * 100);
      const result = api.upsertLibrary({
        id: state.libraryId,
        title: state.sourceLabel || api.truncateTitle(state.text),
        text: state.text,
        sourceType: 'reader',
        isPremium: state.isPremium,
        progress: {
          index: state.currentIndex,
          mode: state.mode,
          wpm: state.wpm,
          pct: percentage,
        },
        profileId: api.getActiveProfile()?.id,
      });
      if (!result.ok) {
        if (!quiet) alert(result.reason || 'Could not save.');
        return null;
      }
      state.libraryId = result.item.id;
      if (queueAfter) {
        const q = api.addToQueue({
          libraryId: result.item.id,
          title: result.item.title,
          wordCount: result.item.wordCount,
          wpm: state.wpm,
        });
        if (!q.ok && q.reason && !quiet) alert(q.reason);
      }
      renderWorkspace();
      return result.item;
    };

    const openLibraryItem = (id, { fromStart } = {}) => {
      const api = BF();
      const item = api?.getLibraryItem(id);
      if (!item?.text) return;
      initReaderSession(item.text, item.title || 'Library', {
        libraryId: item.id,
        resumeIndex: fromStart ? 0 : (item.progress?.index || 0),
        mode: item.progress?.mode,
        wpm: item.progress?.wpm,
        skipAutosave: true,
      });
    };

    const exportCurrentMarkdown = async () => {
      const api = BF();
      if (!api) return;
      if (state.text.trim() && !state.libraryId) saveCurrentToLibrary();
      const md = api.exportMarkdown({
        libraryId: state.libraryId,
        meta: {
          title: state.sourceLabel || 'BriskRead export',
          summary: '',
        },
      });
      const slug = (state.sourceLabel || 'briskread').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40);
      api.downloadText(`${slug || 'briskread'}-export.md`, md);
      try {
        await api.copyText(md);
      } catch (_) { /* optional */ }
    };

    const highlightCurrent = () => {
      const api = BF();
      if (!api || !state.words.length) return;
      if (!state.libraryId) saveCurrentToLibrary();
      const start = state.currentIndex;
      const end = Math.min(state.words.length, start + (state.mode === 'phrase' ? 3 : 1));
      const text = state.words.slice(start, end).join(' ');
      const res = api.addHighlight({
        libraryId: state.libraryId,
        text,
        wordIndex: start,
      });
      if (res.ok) {
        const btn = document.getElementById('btn-highlight-word');
        if (btn) {
          const prev = btn.textContent;
          btn.textContent = 'Saved';
          setTimeout(() => { btn.textContent = prev; }, 1200);
        }
      }
    };

    // Main RSVP playback loop
    const playRSVP = () => {
      state.currentIndex = getPlaybackStart(state.currentIndex, state.words.length);
      renderRSVPWord();
      state.isPlaying = true;
      ttsVisualQueue = [];
      clearTimeout(ttsVisualTimer);
      ttsVisualTimer = null;
      document.getElementById('btn-rsvp-play').textContent = "⏸ Pause";
      if (state.ttsActive) {
        speakWithTTS();
      } else {
        runRSVPTimer();
      }

      // Record streak activity
      const today = new Date().toDateString();
      if (state.stats.lastReadDate !== today) {
        if (state.stats.lastReadDate === new Date(Date.now() - 86400000).toDateString()) {
          state.stats.streak += 1;
        } else if (state.stats.streak === 0) {
          state.stats.streak = 1;
        }
        state.stats.lastReadDate = today;
        saveStats();
      }
    };

    const runRSVPTimer = () => {
      if (!state.isPlaying) return;

      if (state.currentIndex >= state.words.length) {
        pauseReader();
        state.currentIndex = state.words.length;
        document.querySelectorAll('[data-reader-scrubber]').forEach((slider) => { slider.value = '100'; });
        document.getElementById('reading-percentage').textContent = `Complete · ${state.words.length} words`;
        document.getElementById('reading-time-left').textContent = 'Complete';
        saveStats();
        return;
      }

      const chunkSize = 1;
      const word = state.words[Math.min(state.words.length - 1, state.currentIndex + chunkSize - 1)];
      const baseDelay = (60 / state.wpm) * 1000 * chunkSize;
      
      // Intelligent pause delay mapping for punctuation
      let delay = baseDelay;
      if (word) {
        if (/[.!?]$/.test(word)) delay = baseDelay * 1.8;
        else if (/[,;:]$/.test(word)) delay = baseDelay * 1.3;
      }

      // Record reading stats in memory
      state.stats.wordsRead += chunkSize;
      state.stats.timeSpent += (delay / 60000); // convert delay to fractional minutes
      
      // Save stats to disk only every 50 words to prevent I/O blocking
      if (state.stats.wordsRead % 50 === 0) {
        saveStats();
      }

      renderRSVPWord();
      state.currentIndex += chunkSize;

      // Never compress delayed frames into zero-delay callbacks: every word needs a paint.
      state.timer = setTimeout(runRSVPTimer, delay);
    };

    const pauseReader = () => {
      state.isPlaying = false;
      document.getElementById('btn-rsvp-play').textContent = "▶ Play";
      clearTimeout(state.timer);
      clearTimeout(ttsVisualTimer);
      // Invalidate the in-flight chunk sequence so its callbacks stop queueing more.
      state.ttsRunId = (state.ttsRunId || 0) + 1;
      ttsVisualTimer = null;
      ttsVisualQueue = [];
      if (window.speechSynthesis) {
        window.speechSynthesis.cancel();
      }
      // Save stats + resume position immediately on pause
      saveStats();
      persistReaderProgress();
    };

    const seekReader = (index) => {
      pauseReader();
      if (!state.words.length) return;
      state.currentIndex = clampReaderIndex(index, state.words.length);
      renderRSVPWord();
    };

    // Text-to-Speech Synchronization using Web Speech API
    const speakWithTTS = () => {
      if (!window.speechSynthesis) {
        alert("Text to speech is not supported in this browser.");
        return;
      }
      const wasBusy = window.speechSynthesis.speaking || window.speechSynthesis.pending;
      window.speechSynthesis.cancel();
      // cancel() is asynchronous in Chrome — queuing a new utterance in the same tick
      // (or even next tick) can hit it mid-teardown and get silently dropped/interrupted.
      // Give it a beat to actually finish before speaking again.
      setTimeout(() => doSpeak(), wasBusy ? 150 : 0);
    };

    // Pick the voice to speak with. Remote voices (localService === false) stream from
    // Google's servers and routinely die mid-sentence with 'interrupted'; local system
    // voices are far more reliable, so they win unless the user picked one explicitly.
    const pickTTSVoice = () => {
      const voices = window.speechSynthesis.getVoices();
      if (!voices.length) return null;

      const chosenName = document.getElementById('select-voice').value;
      if (chosenName) {
        const exact = voices.find(v => v.name === chosenName);
        if (exact) return exact;
        // Fall through rather than assigning undefined, which breaks playback outright.
      }

      const english = voices.filter(v => v.lang.startsWith('en'));
      const pool = english.length ? english : voices;
      const local = pool.filter(v => v.localService !== false);
      return local.find(v => /Natural|Neural/i.test(v.name)) || local[0] || pool[0];
    };

    const doSpeak = () => {
      // Play/pause may have been toggled during the cancel() settle delay.
      if (!state.isPlaying || !state.ttsActive) return;

      const startIndexOffset = state.wordObjects[state.currentIndex]?.startIndex || 0;
      // Offsets stay relative to the ORIGINAL text so boundary events map back to words.
      state.ttsChunks = chunkForTTS(state.text.slice(startIndexOffset), startIndexOffset);
      state.ttsChunkIndex = 0;
      // Bumped on every fresh playback; stale callbacks compare against it and bail.
      state.ttsRunId = (state.ttsRunId || 0) + 1;
      speakChunk(state.ttsRunId);
    };

    const speakChunk = (runId) => {
      if (runId !== state.ttsRunId || !state.isPlaying || !state.ttsActive) return;

      const chunk = state.ttsChunks[state.ttsChunkIndex];
      if (!chunk) { // every chunk spoken — the document is finished
        pauseReader();
        state.currentIndex = state.words.length;
        saveStats();
        return;
      }

      const utterance = new SpeechSynthesisUtterance(chunk.text);
      state.ttsUtterance = utterance; // also keeps it alive; unreferenced utterances get GC'd mid-speech
      utterance.rate = Math.min(3.0, Math.max(0.5, state.wpm / 150)); // ~150 WPM is rate 1.0
      utterance.pitch = parseFloat(document.getElementById('slider-pitch').value || '1.0');

      const voice = pickTTSVoice();
      if (voice) utterance.voice = voice;

      utterance.onboundary = (event) => {
        if (runId !== state.ttsRunId || event.name !== 'word' || !state.isPlaying) return;
        const charIndex = event.charIndex + chunk.offset;

        // Find matching word based on character coordinates
        let matchedIdx = -1;
        for (let i = 0; i < state.wordObjects.length; i++) {
          const w = state.wordObjects[i];
          if (charIndex >= w.startIndex && charIndex < w.endIndex) {
            matchedIdx = i;
            break;
          }
        }

        // Fallback: if charIndex falls on space/punctuation, align to the word immediately preceding it
        if (matchedIdx === -1) {
          matchedIdx = state.wordObjects.findIndex(w => w.startIndex > charIndex) - 1;
        }

        if (matchedIdx !== -1) queueTTSVisualWord(matchedIdx);
      };

      utterance.onend = () => {
        if (runId !== state.ttsRunId) return;
        state.ttsChunkIndex += 1;
        speakChunk(runId);
      };

      utterance.onerror = (e) => {
        if (runId !== state.ttsRunId) return;
        // We cancel deliberately on pause/seek/restart; those aren't real failures.
        if (e.error === 'interrupted' || e.error === 'canceled') return;
        console.error('TTS speech error', e.error, e);
        pauseReader();
      };

      window.speechSynthesis.speak(utterance);
    };

    // Escape HTML special chars so pasted/extracted text can't be rendered as markup
    const escapeHtml = (str) => str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    // Render Bionic Reading format
    const renderBionicText = () => {
      const formatted = state.words.map(word => {
        if (word.length <= 1) return escapeHtml(word);
        let fixLen = Math.ceil(word.length * 0.4);
        if (word.length === 3) fixLen = 2;
        const fixPart = escapeHtml(word.slice(0, fixLen));
        const sacPart = escapeHtml(word.slice(fixLen));
        return `<strong class="bionic-fixation">${fixPart}</strong><span class="bionic-saccade">${sacPart}</span>`;
      }).join(' ');

      const bionicView = document.getElementById('bionic-text-view');
      if (!bionicView) return;
      bionicView.classList.remove('focus-reader-viewport');
      bionicView.innerHTML = formatted;
    };

    // Render Standard Reader highlighted sentences
    const renderStandardText = () => {
      // Split text by sentences
      const sentences = state.text.match(/[^.!?]+[.!?]+(\s|$)/g) || [state.text];
      const html = sentences.map((sentence, idx) => {
        return `<span class="reader-sentence" data-sentence-index="${idx}">${escapeHtml(sentence)}</span>`;
      }).join('');
      
      const view = document.getElementById('standard-text-view');
      view.classList.remove('focus-reader-viewport');
      view.classList.add('is-page-mode');
      view.style.transform = '';
      view.innerHTML = html;

      // Click to jump logic
      view.querySelectorAll('.reader-sentence').forEach(el => {
        el.addEventListener('click', (e) => {
          view.querySelectorAll('.reader-sentence').forEach(s => s.classList.remove('active'));
          el.classList.add('active');
          
          // Map sentence jump back to RSVP word index
          const sText = el.textContent.trim().split(/\s+/)[0];
          const matchedWordIdx = state.words.findIndex(w => w.startsWith(sText));
          if (matchedWordIdx !== -1) {
            state.currentIndex = matchedWordIdx;
            renderRSVPWord();
          }
        });
      });
    };

    const FOCUS_EYE_RATIO = 0.42;

    const renderFocusText = () => {
      const view = document.getElementById('standard-text-view');
      if (!view) return;
      view.classList.add('focus-reader-viewport');
      view.classList.remove('is-page-mode');
      const track = document.createElement('div');
      track.className = 'focus-track';
      track.id = 'focus-track';
      state.words.forEach((word, index) => {
        const span = document.createElement('span');
        span.className = 'focus-word';
        span.dataset.wordIndex = index.toString();
        span.textContent = `${word} `;
        track.appendChild(span);
      });
      const eye = document.createElement('div');
      eye.className = 'focus-eye-line';
      eye.setAttribute('aria-hidden', 'true');
      view.replaceChildren(eye, track);
      view.onclick = (event) => {
        const word = event.target.closest('.focus-word');
        if (!word) return;
        state.currentIndex = Number(word.dataset.wordIndex);
        renderRSVPWord();
      };
      // After layout, size vertical padding so first/last lines can sit on the eye line
      requestAnimationFrame(() => {
        const eyeY = view.clientHeight * FOCUS_EYE_RATIO;
        track.style.paddingTop = `${Math.max(0, eyeY - 12)}px`;
        track.style.paddingBottom = `${Math.max(0, view.clientHeight - eyeY - 12)}px`;
        updateFocusWord();
      });
    };

    const readTranslateY = (el) => {
      if (!el) return 0;
      const raw = el.style.transform || '';
      const m = raw.match(/translate3d\(\s*[^,]+,\s*([-\d.]+)px/);
      if (m) return Number(m[1]) || 0;
      const m2 = raw.match(/translateY\(\s*([-\d.]+)px/);
      return m2 ? Number(m2[1]) || 0 : 0;
    };

    const updateFocusWord = () => {
      const view = document.getElementById('standard-text-view');
      if (!view) return;
      const track = view.querySelector('.focus-track') || view;
      const previous = view.querySelector('.focus-word.active');
      if (previous) previous.classList.remove('active');
      const current = view.querySelector(`[data-word-index="${state.currentIndex}"]`);
      if (!current) return;
      current.classList.add('active');
      // Line detection using layout geometry (stable with transforms)
      const lineTop = current.offsetTop;
      view.querySelectorAll('.focus-word').forEach((word) => {
        word.classList.toggle('active-line', Math.abs(word.offsetTop - lineTop) < 3);
      });
      // Fixed eye line: nudge transform so the active word sits at ~42% of the viewport.
      // As the highlight advances, the next line slides into that same place.
      const viewRect = view.getBoundingClientRect();
      const wordRect = current.getBoundingClientRect();
      const eyeAbs = viewRect.top + view.clientHeight * FOCUS_EYE_RATIO;
      const wordMid = wordRect.top + wordRect.height / 2;
      const nextY = readTranslateY(track) + (eyeAbs - wordMid);
      track.style.transform = `translate3d(0, ${nextY}px, 0)`;
      if (view.scrollTop !== 0) view.scrollTop = 0;
    };

    const renderFlowWord = () => {
      const context = getFlowContext(state.words, state.currentIndex);
      const orpIndex = getOrpIndex(context.word);
      document.getElementById('flow-previous-line').textContent = context.previous;
      document.getElementById('flow-left-context').textContent = context.left;
      document.getElementById('flow-word-left').textContent = context.word.slice(0, orpIndex);
      document.getElementById('flow-word-orp').textContent = context.word.charAt(orpIndex);
      document.getElementById('flow-word-right').textContent = context.word.slice(orpIndex + 1);
      document.getElementById('flow-right-context').textContent = context.right;
      document.getElementById('flow-next-line').textContent = context.next;
    };

    // Setup active mode panes
    const setMode = (modeName) => {
      state.mode = modeName;
      document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.mode === modeName);
      });

      const readerScreen = document.getElementById('reader-screen');
      if (readerScreen) readerScreen.dataset.readerMode = modeName;

      document.getElementById('rsvp-pane').classList.toggle('hidden', !['rsvp', 'phrase'].includes(modeName));
      document.getElementById('flow-pane').classList.toggle('hidden', modeName !== 'flow');
      document.getElementById('bionic-pane').classList.toggle('hidden', modeName !== 'bionic');
      document.getElementById('standard-pane').classList.toggle('hidden', !['focus', 'standard'].includes(modeName));

      const descriptions = {
        rsvp: 'One word at a fixed focal point for maximum speed.',
        phrase: 'Three-word groups preserve more context while reducing eye movement.',
        focus: 'One line stays locked to the centre mark; the next line slides into that same place.',
        flow: 'Keep a fixed focal point while nearby words and lines move through context.',
        bionic: 'Bold word beginnings guide your eyes through the full text.',
        standard: 'A clean, distraction-free page for self-paced reading.',
      };
      document.getElementById('mode-description').textContent = descriptions[modeName];

      if (modeName === 'bionic') {
        renderBionicText();
      } else if (modeName === 'focus') {
        renderFocusText();
        renderRSVPWord();
      } else if (modeName === 'flow') {
        renderRSVPWord();
      } else if (modeName === 'standard') {
        renderStandardText();
      } else {
        renderRSVPWord();
      }
    };

    // Lazy load libraries client-side on demand
    const loadScript = (url) => {
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = url;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    };

    let isJSZipLoaded = false;
    let isPDFJSLoaded = false;
    let isTesseractLoaded = false;

    // Load PDF parser
    const handlePDFUpload = async (file) => {
      const status = document.getElementById('file-status');
      try {
        if (!isPDFJSLoaded) {
          status.textContent = "Downloading PDF parser...";
          await loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js');
          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          isPDFJSLoaded = true;
        }

        status.textContent = "Parsing PDF text content...";
        const reader = new FileReader();
        reader.onerror = () => { status.textContent = "Could not read this PDF file."; };
        reader.onload = async (event) => {
          try {
            const typedarray = new Uint8Array(event.target.result);
            const pdf = await pdfjsLib.getDocument(typedarray).promise;
            let fullText = '';
            const maxPages = Math.min(200, pdf.numPages);

            for (let i = 1; i <= maxPages; i++) {
              const page = await pdf.getPage(i);
              const textContent = await page.getTextContent();
              fullText += textContent.items
                .map((item) => `${item.str}${item.hasEOL ? '\n' : ' '}`)
                .join('') + '\n\n';
              document.getElementById('upload-progress-bar').style.width = `${Math.round((i / maxPages) * 100)}%`;
            }

            if (!fullText.trim()) {
              status.textContent = "No selectable text found. Running on-device OCR…";
              const ocrText = await extractPDFWithOCR(pdf, maxPages, status);
              if (ocrText.trim()) {
                status.textContent = `OCR loaded ${maxPages} page${maxPages === 1 ? '' : 's'}.`;
                initReaderSession(ocrText, file.name, sessionOptsFromImport('upload'));
              } else {
                status.textContent = "No text could be read from this PDF.";
              }
              return;
            }

            status.textContent = `Loaded ${maxPages} page${maxPages === 1 ? '' : 's'}.`;
            initReaderSession(fullText, file.name, sessionOptsFromImport('upload'));
          } catch (err) {
            status.textContent = "Could not extract text from this PDF. Try Image OCR for scanned pages.";
            console.error(err);
          }
        };
        reader.readAsArrayBuffer(file);
      } catch (err) {
        status.textContent = "Could not load the PDF parser. Please try again.";
        console.error(err);
      }
    };

    // Load EPUB parser
    const handleEPUBUpload = async (file) => {
      if (!isJSZipLoaded) {
        document.getElementById('file-status').textContent = "Downloading EPUB decompression parser...";
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js');
        isJSZipLoaded = true;
      }

      document.getElementById('file-status').textContent = "Extracting book pages...";
      try {
        const reader = new FileReader();
        reader.onload = async function(e) {
          const zip = await JSZip.loadAsync(e.target.result);
          let htmlFiles = [];
          zip.forEach((path, zFile) => {
            if (path.endsWith('.html') || path.endsWith('.xhtml')) {
              htmlFiles.push(zFile);
            }
          });

          // Order logically
          htmlFiles.sort((a, b) => a.name.localeCompare(b.name, undefined, {numeric: true}));

          let fullText = '';
          for (let i = 0; i < htmlFiles.length; i++) {
            const content = await htmlFiles[i].async('text');
            const parser = new DOMParser();
            const doc = parser.parseFromString(content, 'text/html');
            doc.querySelectorAll('script, style').forEach(el => el.remove());
            fullText += doc.body.innerText + '\n\n';
            
            const percent = Math.round((i / htmlFiles.length) * 100);
            document.getElementById('upload-progress-bar').style.width = percent + '%';
          }

          initReaderSession(fullText, file.name, sessionOptsFromImport('upload'));
        };
        reader.readAsArrayBuffer(file);
      } catch (err) {
        alert("Failed to decompress and parse EPUB book.");
        console.error(err);
      }
    };

    const getOCRWorker = async (status) => {
      if (!isTesseractLoaded) {
        status.textContent = "Downloading OCR engine…";
        await loadScript('https://cdn.jsdelivr.net/npm/tesseract.js@5.0.3/dist/tesseract.min.js');
        isTesseractLoaded = true;
      }
      return Tesseract.createWorker('eng');
    };

    const extractPDFWithOCR = async (pdf, maxPages, status) => {
      const worker = await getOCRWorker(status);
      let text = '';
      try {
        for (let i = 1; i <= maxPages; i++) {
          status.textContent = `Reading scanned page ${i} of ${maxPages}…`;
          const page = await pdf.getPage(i);
          const viewport = page.getViewport({ scale: 2 });
          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
          const result = await worker.recognize(canvas);
          text += `${result.data.text}\n\n`;
          document.getElementById('upload-progress-bar').style.width = `${Math.round((i / maxPages) * 100)}%`;
        }
      } finally {
        await worker.terminate();
      }
      return text;
    };

    // OCR engine handler
    const handleOCRUpload = async (file) => {
      document.getElementById('ocr-progress').classList.remove('hidden');
      document.getElementById('ocr-progress-bar').style.width = '10%';
      const status = document.getElementById('ocr-status');
      document.getElementById('ocr-progress-bar').style.width = '30%';

      try {
        const worker = await getOCRWorker(status);
        status.textContent = "Extracting text from image locally…";
        document.getElementById('ocr-progress-bar').style.width = '50%';
        const ret = await worker.recognize(file);
        document.getElementById('ocr-progress-bar').style.width = '90%';
        
        const extractedText = ret.data.text;
        await worker.terminate();

        document.getElementById('ocr-progress-bar').style.width = '100%';
        if (extractedText.trim().length === 0) {
          alert("Could not identify any text in this image.");
          document.getElementById('ocr-progress').classList.add('hidden');
          return;
        }

        initReaderSession(extractedText, file.name, sessionOptsFromImport('ocr'));
      } catch (err) {
        alert("OCR parsing failed.");
        console.error(err);
        document.getElementById('ocr-progress').classList.add('hidden');
      }
    };

    // Load parsed text into reader session
    // options: libraryId, resumeIndex, mode, wpm, skipAutosave,
    //          saveToLibrary (default true), addToQueue (default false), sourceUrl, sourceType
    const initReaderSession = (text, sourceLabel = 'Document', options = {}) => {
      if (!text || text.trim().length === 0) {
        alert("No valid text extracted.");
        return;
      }
      
      // Enforce free tier limits: 3000 words limit on uploads
      const tempWords = text.trim().split(/\s+/);
      if (tempWords.length > 3000 && !state.isPremium) {
        const upgrade = confirm(`Your document has ${tempWords.length.toLocaleString()} words. The free tier limits reading to 3,000 words to cover AdSense/hosting costs. Upgrade to Lifetime Premium ($9 one-time) for unlimited length and an ad-free workspace.`);
        if (upgrade) {
          setTimeout(() => {
            const pricing = document.querySelector('.pricing-card');
            if (pricing) {
              pricing.scrollIntoView({ behavior: 'smooth' });
              pricing.style.outline = "3px solid var(--color-primary)";
              pricing.style.outlineOffset = "4px";
              setTimeout(() => {
                pricing.style.outline = "none";
              }, 4000);
            }
          }, 200);
        }
        return;
      }
      
      parseText(text);
      state.sourceLabel = sourceLabel;
      state.libraryId = options.libraryId || null;
      state.lastRetentionIndex = options.resumeIndex || 0;
      updateDocumentContext();
      
      // Reset reader panels
      const readerScreen = document.getElementById('reader-screen');
      readerScreen.classList.remove('hidden');

      const profile = BF()?.getActiveProfile();
      const savedMode = profile?.settings?.mode;
      const modeToUse = options.mode || savedMode || state.mode || 'rsvp';
      if (options.wpm) {
        state.wpm = options.wpm;
        const wpmSlider = document.getElementById('slider-wpm');
        const wpmDisplay = document.getElementById('wpm-display');
        if (wpmSlider) wpmSlider.value = options.wpm;
        if (wpmDisplay) wpmDisplay.textContent = options.wpm;
      } else if (profile?.settings?.wpm && !options.skipProfile) {
        applyProfile(profile, { silent: true });
      }
      setMode(modeToUse);

      const resumeAt = Math.min(
        Math.max(0, Number(options.resumeIndex) || 0),
        Math.max(0, state.words.length - 1)
      );
      state.currentIndex = resumeAt;
      refreshChapterSelect();
      updateReaderChrome();
      renderRSVPWord();

      const saveToLibrary = options.saveToLibrary !== false && !options.skipAutosave;
      const addToQueue = !!options.addToQueue;

      if (saveToLibrary || addToQueue) {
        if (addToQueue && saveToLibrary) {
          const item = saveCurrentToLibrary({ queueAfter: true, quiet: true });
          if (item) state.libraryId = item.id;
        } else if (saveToLibrary) {
          const item = saveCurrentToLibrary({ quiet: true });
          if (item) state.libraryId = item.id;
        } else if (addToQueue) {
          // Queue requires a library entry for full-text export later
          const item = saveCurrentToLibrary({ queueAfter: true, quiet: true });
          if (item) state.libraryId = item.id;
        }
      } else if (state.libraryId) {
        BF()?.setActiveLibraryId(state.libraryId);
      }

      // Scroll smoothly to the reading card
      readerScreen.scrollIntoView({ behavior: 'smooth' });
    };

    const readImportOpts = (prefix) => ({
      saveToLibrary: document.getElementById(`opt-${prefix}-library`)?.checked !== false,
      addToQueue: !!document.getElementById(`opt-${prefix}-queue`)?.checked,
    });

    const sessionOptsFromImport = (prefix, extra = {}) => {
      const opts = readImportOpts(prefix);
      return {
        saveToLibrary: opts.saveToLibrary,
        addToQueue: opts.addToQueue,
        sourceType: prefix,
        ...extra,
      };
    };

    /** Extract readable text from HTML string returned by /api/extract */
    const extractArticleFromHtml = (html, pageUrl) => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      doc.querySelectorAll('script, style, noscript, svg, iframe, nav, footer, header, form, aside, [role="navigation"], [role="banner"], [role="contentinfo"]').forEach((el) => el.remove());

      const title =
        doc.querySelector('meta[property="og:title"]')?.getAttribute('content') ||
        doc.querySelector('title')?.textContent ||
        doc.querySelector('h1')?.textContent ||
        'Web Article';

      const root =
        doc.querySelector('article') ||
        doc.querySelector('[role="main"]') ||
        doc.querySelector('main') ||
        doc.querySelector('.post-content, .entry-content, .article-body, .story-body, #content') ||
        doc.body;

      if (!root) return { title: title.trim(), text: '' };

      const blocks = Array.from(
        root.querySelectorAll('p, h1, h2, h3, h4, li, blockquote, pre, figcaption')
      );
      let parts = blocks
        .map((el) => (el.innerText || el.textContent || '').replace(/\s+/g, ' ').trim())
        .filter((t) => t.length > 25);

      // Deduplicate near-identical lines
      const seen = new Set();
      parts = parts.filter((t) => {
        const key = t.slice(0, 80).toLowerCase();
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });

      let body = parts.join('\n\n');
      if (body.length < 120) {
        // Fallback: full text of root with light cleanup
        body = (root.innerText || root.textContent || '')
          .replace(/\n{3,}/g, '\n\n')
          .trim();
      }

      return {
        title: title.replace(/\s+/g, ' ').trim().slice(0, 200),
        text: body,
        url: pageUrl || '',
      };
    };

    let workspaceSyncTimer = null;
    let workspaceSyncing = false;

    const setSyncStatus = (msg) => {
      const el = document.getElementById('workspace-sync-status');
      if (el) el.textContent = msg || '';
    };

    const pushWorkspaceToCloud = async (store) => {
      const supabase = globalThis.briskreadSupabase;
      if (!supabase || !accountUser?.id) return;
      if (workspaceSyncing) return;
      workspaceSyncing = true;
      try {
        const payload = store || BF()?.getStoreSnapshot();
        if (!payload) return;
        const { error } = await supabase.from('reading_workspace').upsert({
          user_id: accountUser.id,
          payload,
          updated_at: new Date().toISOString(),
        }, { onConflict: 'user_id' });
        if (error) {
          // Table may not exist yet until migration is applied
          setSyncStatus(error.message?.includes('reading_workspace')
            ? 'Cloud sync: run Supabase migration reading_workspace'
            : `Sync push failed: ${error.message}`);
        } else {
          setSyncStatus(`Synced · ${new Date().toLocaleTimeString()}`);
        }
      } catch (err) {
        setSyncStatus('Sync offline');
      } finally {
        workspaceSyncing = false;
      }
    };

    const scheduleWorkspacePush = (store) => {
      if (!accountUser?.id) return;
      clearTimeout(workspaceSyncTimer);
      workspaceSyncTimer = setTimeout(() => pushWorkspaceToCloud(store), 800);
    };

    const pullAndMergeWorkspace = async () => {
      const api = BF();
      const supabase = globalThis.briskreadSupabase;
      if (!api || !supabase || !accountUser?.id) {
        setSyncStatus(accountUser ? '' : 'Sign in to sync library across devices');
        return;
      }
      setSyncStatus('Syncing…');
      try {
        const { data, error } = await supabase
          .from('reading_workspace')
          .select('payload, updated_at')
          .eq('user_id', accountUser.id)
          .maybeSingle();

        if (error) {
          setSyncStatus(error.code === '42P01' || /relation|does not exist/i.test(error.message || '')
            ? 'Cloud sync needs DB migration (reading_workspace)'
            : `Sync: ${error.message}`);
          // Still register push so local saves queue for when table exists
          api.setSyncHandler((store) => scheduleWorkspacePush(store));
          return;
        }

        const local = api.getStoreSnapshot();
        if (data?.payload) {
          const remote = data.payload;
          const merged = api.mergeStores(local, remote);
          api.replaceStore(merged);
          renderWorkspace();
          renderProfiles();
        }
        api.setSyncHandler((store) => scheduleWorkspacePush(store));
        await pushWorkspaceToCloud(api.getStoreSnapshot());
      } catch (err) {
        setSyncStatus('Could not reach cloud sync');
        api.setSyncHandler((store) => scheduleWorkspacePush(store));
      }
    };

    // Clean reader closure
    const closeReaderSession = () => {
      pauseReader();
      persistReaderProgress();
      document.getElementById('reader-screen').classList.add('hidden');
      renderWorkspace();
    };

    const populateVoices = () => {
      if (!window.speechSynthesis) return;
      
      const voiceSelect = document.getElementById('select-voice');
      if (!voiceSelect) return;
      
      const previous = voiceSelect.value;
      voiceSelect.innerHTML = '<option value="">Default System Voice</option>';

      // Remote voices (localService === false — Chrome's "Google ..." set) stream from
      // Google's servers and abort mid-sentence, so they are not offered at all.
      const isNatural = (voice) => /Natural|Neural/i.test(voice.name);
      const voices = window.speechSynthesis.getVoices().filter(v => v.localService !== false);

      // Higher-quality local voices (e.g. "Microsoft Aria Natural") first.
      voices.sort((a, b) => {
        if (isNatural(a) !== isNatural(b)) return isNatural(a) ? -1 : 1;
        return a.name.localeCompare(b.name);
      });

      voices.forEach(voice => {
        const option = document.createElement('option');
        option.value = voice.name;
        option.textContent = isNatural(voice)
          ? `✨ [Natural] ${voice.name} (${voice.lang})`
          : `${voice.name} (${voice.lang})`;
        voiceSelect.appendChild(option);
      });

      // Keep the current pick across rebuilds instead of silently resetting it.
      voiceSelect.value = voices.some(v => v.name === previous) ? previous : '';
    };

    if (window.speechSynthesis) {
      // Chrome can carry a wedged "speaking" queue over from a previous session on the
      // same page/tab; force-clear it before this session ever calls speak().
      window.speechSynthesis.cancel();
      // Chrome can fire voiceschanged mid-utterance, and calling getVoices() (inside
      // populateVoices) while speech is in flight silently cancels it as "interrupted".
      // Skip the rebuild while actively speaking so a fresh play never gets killed.
      window.speechSynthesis.onvoiceschanged = () => {
        if (window.speechSynthesis.speaking) return;
        populateVoices();
      };
    }

    // ---------------- EVENT LIFECYCLES ----------------
    document.addEventListener('DOMContentLoaded', () => {
      loadState();
      populateVoices();

      // Navigation tabs trigger
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
          
          btn.classList.add('active');
          document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');
        });
      });

      // Demo button loader
      document.getElementById('btn-demo').addEventListener('click', () => {
        const demo = "Rapid Serial Visual Presentation (RSVP) is a reading technique that flashes words in a single location on the screen. By removing horizontal eye movements, readers can quickly scan literature and dramatically decrease strain. Bionic Reading bold highlights the prefix structure of letters, guiding your focus down lines seamlessly. Synced Audio combines with RSVP to form a multi-channel learning experience, ensuring high focus at faster speeds.";
        const textInput = document.getElementById('text-input');
        textInput.value = demo;
        textInput.dispatchEvent(new Event('input', { bubbles: true }));
      });

      document.getElementById('btn-hero-demo')?.addEventListener('click', () => {
        document.getElementById('btn-demo')?.click();
        document.getElementById('btn-load-paste')?.click();
        // Pitch is dual-channel — turn Audio Sync on so the sample is heard + seen
        setTimeout(() => {
          if (!state.ttsActive) {
            document.getElementById('btn-rsvp-tts')?.click();
          }
          if (!state.isPlaying) {
            document.getElementById('btn-rsvp-play')?.click();
          }
        }, 120);
      });

      const previewWords = ['Finish', 'more', 'reading', 'with', 'less', 'friction', 'and', 'keep', 'your', 'focus', 'from', 'first', 'page', 'to', 'final', 'point'];
      let previewIndex = 0;
      let heroPreviewTimer;
      let heroPreviewPlaying = true;
      const heroPlayButton = document.getElementById('hero-play');
      const renderHeroPreview = () => {
        const word = previewWords[previewIndex++ % previewWords.length];
        const orpIndex = getOrpIndex(word);
        document.getElementById('hero-word-left').textContent = word.slice(0, orpIndex);
        document.getElementById('hero-word-orp').textContent = word.charAt(orpIndex);
        document.getElementById('hero-word-right').textContent = word.slice(orpIndex + 1);
        document.querySelector('.hero-word').classList.remove('is-changing');
        requestAnimationFrame(() => document.querySelector('.hero-word').classList.add('is-changing'));
      };
      // Focus preview: same fixed-eye-line behaviour as the real reader
      const heroFocusHost = document.getElementById('hero-focus-demo');
      const heroFocusTrack = document.getElementById('hero-focus-track');
      const heroFocusWords = (
        'Removing horizontal eye movement lets you read a whole paragraph without losing your place. ' +
        'The active line stays locked to the centre mark while the next line slides into that same place. ' +
        'Your eyes rest; the text does the work so focus mode feels like a teleprompter for reading.'
      ).split(/\s+/).filter(Boolean);
      const heroFocusFrag = document.createDocumentFragment();
      heroFocusWords.forEach((word, index) => {
        const span = document.createElement('span');
        span.className = 'focus-word';
        span.dataset.wordIndex = String(index);
        span.textContent = `${word} `;
        heroFocusFrag.appendChild(span);
      });
      if (heroFocusTrack) heroFocusTrack.replaceChildren(heroFocusFrag);
      const heroFocusSpans = heroFocusTrack
        ? [...heroFocusTrack.querySelectorAll('.focus-word')]
        : [];
      let heroFocusIndex = 0;
      const HERO_FOCUS_EYE = 0.42;
      const layoutHeroFocusPadding = () => {
        if (!heroFocusHost || !heroFocusTrack) return;
        const eyeY = heroFocusHost.clientHeight * HERO_FOCUS_EYE;
        heroFocusTrack.style.paddingTop = `${Math.max(0, eyeY - 10)}px`;
        heroFocusTrack.style.paddingBottom = `${Math.max(0, heroFocusHost.clientHeight - eyeY - 10)}px`;
      };
      const readHeroTY = (el) => {
        const raw = el?.style?.transform || '';
        const m = raw.match(/translate3d\(\s*[^,]+,\s*([-\d.]+)px/);
        return m ? Number(m[1]) || 0 : 0;
      };
      const renderHeroFocus = () => {
        if (!heroFocusHost || !heroFocusTrack || !heroFocusSpans.length) return;
        // Only drive focus animation while that slide is visible
        const focusSlide = document.querySelector('[data-hero-slide="focus"]');
        if (focusSlide && !focusSlide.classList.contains('is-active')) {
          heroFocusIndex += 1;
          return;
        }
        const idx = heroFocusIndex % heroFocusSpans.length;
        const current = heroFocusSpans[idx];
        heroFocusSpans.forEach((s) => s.classList.remove('active', 'active-line'));
        if (current) {
          current.classList.add('active');
          const lineTop = current.offsetTop;
          heroFocusSpans.forEach((word) => {
            word.classList.toggle('active-line', Math.abs(word.offsetTop - lineTop) < 3);
          });
          const viewRect = heroFocusHost.getBoundingClientRect();
          const wordRect = current.getBoundingClientRect();
          const eyeAbs = viewRect.top + heroFocusHost.clientHeight * HERO_FOCUS_EYE;
          const wordMid = wordRect.top + wordRect.height / 2;
          const nextY = readHeroTY(heroFocusTrack) + (eyeAbs - wordMid);
          heroFocusTrack.style.transform = `translate3d(0, ${nextY}px, 0)`;
        }
        heroFocusIndex += 1;
      };
      // Double rAF so offsetTop is correct after first paint in the dark mock
      requestAnimationFrame(() => requestAnimationFrame(() => {
        layoutHeroFocusPadding();
        renderHeroFocus();
      }));

      const heroTick = () => { renderHeroPreview(); renderHeroFocus(); };

      const updateHeroPlayback = () => {
        clearInterval(heroPreviewTimer);
        heroPlayButton.textContent = heroPreviewPlaying ? 'Ⅱ' : '▶';
        heroPlayButton.setAttribute('aria-pressed', String(heroPreviewPlaying));
        heroPlayButton.setAttribute('aria-label', heroPreviewPlaying ? 'Pause reading preview' : 'Play reading preview');
        if (heroPreviewPlaying) heroPreviewTimer = setInterval(heroTick, 60000 / Number(document.getElementById('hero-wpm-slider').value));
      };

      // Rotate Flash -> Focus so both headline modes are seen without scrolling.
      const heroSlides = [...document.querySelectorAll('[data-hero-slide]')];
      const heroDots = [...document.querySelectorAll('[data-hero-dot]')];
      let heroSlideIndex = 0;
      let heroRotateTimer;
      const showHeroSlide = (next) => {
        heroSlideIndex = (next + heroSlides.length) % heroSlides.length;
        heroSlides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === heroSlideIndex);
          slide.classList.toggle('is-leaving', i !== heroSlideIndex);
        });
        heroDots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === heroSlideIndex);
          dot.setAttribute('aria-selected', String(i === heroSlideIndex));
        });
      };
      const startHeroRotation = () => {
        clearInterval(heroRotateTimer);
        // Auto-rotation is motion the user did not ask for; honour the OS setting.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        heroRotateTimer = setInterval(() => showHeroSlide(heroSlideIndex + 1), 5000);
      };
      heroDots.forEach((dot, i) => dot.addEventListener('click', () => {
        showHeroSlide(i);
        startHeroRotation(); // restart the clock so a manual pick gets a full 5s
      }));
      startHeroRotation();
      document.getElementById('hero-wpm-slider').addEventListener('input', (event) => {
        const wpm = Number(event.target.value);
        const baseline = 240;
        const paceGain = Math.round(((wpm / baseline) - 1) * 100);
        const minutesSaved = Math.max(0, Math.round((5000 / baseline) - (5000 / wpm)));
        document.getElementById('hero-wpm-output').textContent = wpm;
        document.getElementById('hero-compare-wpm').textContent = wpm;
        document.getElementById('hero-pace-gain').textContent = `${paceGain >= 0 ? '+' : ''}${paceGain}%`;
        document.getElementById('hero-time-saved').textContent = `${minutesSaved} min`;
        updateHeroPlayback();
      });
      heroPlayButton.addEventListener('click', () => {
        heroPreviewPlaying = !heroPreviewPlaying;
        updateHeroPlayback();
      });
      updateHeroPlayback();

      document.querySelectorAll('[data-open-tab]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          document.querySelector(`.tab-btn[data-tab="${trigger.dataset.openTab}"]`)?.click();
          document.getElementById('importer-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // Load pasted text
      document.getElementById('btn-load-paste').addEventListener('click', () => {
        const pasteVal = document.getElementById('text-input').value;
        if (!pasteVal.trim()) {
          alert("Please paste some text to begin.");
          return;
        }
        const opts = readImportOpts('paste');
        initReaderSession(pasteVal, 'Pasted text', {
          saveToLibrary: opts.saveToLibrary,
          addToQueue: opts.addToQueue,
          sourceType: 'paste',
        });
      });

      document.getElementById('text-input').addEventListener('input', (event) => {
        const pastedText = event.target.value.trim();
        if (pastedText) {
          parseText(pastedText);
          state.sourceLabel = 'Pasted text';
          updateDocumentContext();
        } else if (state.sourceLabel === 'Pasted text') {
          parseText('');
          state.sourceLabel = '';
          updateDocumentContext();
        }
      });

      // Close button
      document.getElementById('btn-close-reader').addEventListener('click', closeReaderSession);

      // Workspace: library / queue / profiles / export / retention
      document.getElementById('btn-save-library')?.addEventListener('click', () => {
        const item = saveCurrentToLibrary();
        if (item) {
          const btn = document.getElementById('btn-save-library');
          if (btn) {
            const prev = btn.textContent;
            btn.textContent = 'Saved';
            setTimeout(() => { btn.textContent = prev; }, 1200);
          }
        }
      });
      document.getElementById('btn-add-queue')?.addEventListener('click', () => {
        const item = saveCurrentToLibrary({ queueAfter: true });
        if (item) renderWorkspace();
      });
      document.getElementById('btn-export-md')?.addEventListener('click', () => { exportCurrentMarkdown(); });
      document.getElementById('btn-highlight-word')?.addEventListener('click', () => { highlightCurrent(); });
      document.getElementById('btn-retention-check')?.addEventListener('click', () => {
        const api = BF();
        if (!api || !state.words.length) return;
        const from = Math.max(0, state.currentIndex - api.RETENTION_CHUNK);
        const check = api.buildRetentionCheck({
          text: state.text,
          words: state.words,
          fromIndex: from,
          toIndex: state.currentIndex || Math.min(state.words.length, api.RETENTION_CHUNK),
        });
        if (check) openRetentionModal(check);
        else alert('Read a bit more first — check-ins need ~40+ words of context.');
      });
      document.getElementById('btn-retention-skip')?.addEventListener('click', () => {
        closeRetentionModal({ resume: true });
      });
      document.getElementById('btn-retention-save')?.addEventListener('click', () => {
        const api = BF();
        const check = state._retentionCheck;
        if (!api || !check) {
          closeRetentionModal({ resume: true });
          return;
        }
        const answers = {};
        let correct = 0;
        let total = 0;
        check.questions.forEach((q) => {
          const picked = document.querySelector(`input[name="ret-${q.id}"]:checked`);
          const val = picked?.value || '';
          answers[q.id] = val;
          if (q.answer != null) {
            total += 1;
            if (val === q.answer) correct += 1;
          }
        });
        if (!state.libraryId) saveCurrentToLibrary({ quiet: true });
        api.saveRetention({
          libraryId: state.libraryId,
          fromIndex: check.fromIndex,
          toIndex: check.toIndex,
          answers,
          terms: check.terms,
          score: total ? `${correct}/${total}` : null,
        });
        closeRetentionModal({ resume: true });
      });
      document.getElementById('chapter-select')?.addEventListener('change', (e) => {
        const idx = Number(e.target.value) || 0;
        seekReader(idx);
      });
      document.getElementById('profile-pills')?.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-profile]');
        if (!btn) return;
        const api = BF();
        const res = api?.setActiveProfile(btn.dataset.profile);
        if (res?.ok) applyProfile(res.profile);
      });
      document.getElementById('btn-save-profile')?.addEventListener('click', () => {
        const api = BF();
        if (!api) return;
        let id = api.getActiveProfile()?.id;
        if (!id) {
          id = 'news';
          api.setActiveProfile(id);
        }
        api.saveProfileSettings(id, {
          mode: state.mode,
          wpm: state.wpm,
          fontSize: state.fontSize,
          tts: state.ttsActive,
          font: state.font,
        });
        renderProfiles();
        const btn = document.getElementById('btn-save-profile');
        if (btn) {
          const prev = btn.textContent;
          btn.textContent = 'Saved';
          setTimeout(() => { btn.textContent = prev; }, 1200);
        }
      });
      document.querySelectorAll('input[name="retention-mode"]').forEach((el) => {
        el.addEventListener('change', () => {
          if (!el.checked) return;
          BF()?.updateSettings({ retentionMode: el.value, retentionChunk: 1000 });
          renderProfiles();
        });
      });
      document.getElementById('btn-export-queue')?.addEventListener('click', () => {
        const api = BF();
        if (!api) return;
        const md = api.exportQueueMarkdown({ includeDone: false, includeFullText: true });
        api.downloadText(`briskread-queue-${new Date().toISOString().slice(0, 10)}.md`, md);
      });
      document.getElementById('library-list')?.addEventListener('click', (e) => {
        const li = e.target.closest('[data-lib-id]');
        if (!li) return;
        const id = li.dataset.libId;
        const action = e.target.closest('[data-action]')?.dataset.action;
        const api = BF();
        if (action === 'open-lib') openLibraryItem(id);
        else if (action === 'queue-lib') {
          const item = api?.getLibraryItem(id);
          if (!item) return;
          const q = api.addToQueue({
            libraryId: item.id,
            title: item.title,
            wordCount: item.wordCount,
            wpm: state.wpm,
          });
          if (!q.ok && q.reason) alert(q.reason);
          renderWorkspace();
        } else if (action === 'del-lib') {
          if (confirm('Delete this document from your library?')) {
            api?.removeLibrary(id);
            if (state.libraryId === id) state.libraryId = null;
            renderWorkspace();
          }
        }
      });
      document.getElementById('queue-list')?.addEventListener('click', (e) => {
        const li = e.target.closest('[data-queue-id]');
        if (!li) return;
        const qid = li.dataset.queueId;
        const libId = li.dataset.libId;
        const action = e.target.closest('[data-action]')?.dataset.action;
        const api = BF();
        if (action === 'open-queue' && libId) openLibraryItem(libId);
        else if (action === 'toggle-queue') {
          const entry = api?.listQueue().find((q) => q.id === qid);
          api?.setQueueStatus(qid, entry?.status === 'done' ? 'pending' : 'done');
          renderWorkspace();
        } else if (action === 'del-queue') {
          api?.removeFromQueue(qid);
          renderWorkspace();
        }
      });
      document.getElementById('btn-clear-done-queue')?.addEventListener('click', () => {
        const api = BF();
        api?.listQueue().filter((q) => q.status === 'done').forEach((q) => api.removeFromQueue(q.id));
        renderWorkspace();
      });

      renderProfiles();
      renderWorkspace();
      const activeProfile = BF()?.getActiveProfile();
      if (activeProfile?.settings) applyProfile(activeProfile, { silent: true });
      if (accountUser) pullAndMergeWorkspace();
      else setSyncStatus('Sign in to sync library across devices');

      // Mode switch
      document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          setMode(btn.dataset.mode);
        });
      });

      // Keep Focus/Page pane eye-line correct when the viewport resizes (mobile rotate, keyboard, etc.)
      let focusResizeTimer = null;
      window.addEventListener('resize', () => {
        if (state.mode !== 'focus' && state.mode !== 'standard') return;
        clearTimeout(focusResizeTimer);
        focusResizeTimer = setTimeout(() => {
          if (typeof updateFocusWord === 'function') updateFocusWord();
        }, 80);
      });

      // Playback buttons
      const playBtn = document.getElementById('btn-rsvp-play');
      playBtn.addEventListener('click', () => {
        if (state.isPlaying) {
          pauseReader();
        } else {
          playRSVP();
        }
      });

      document.getElementById('btn-rsvp-restart').addEventListener('click', () => seekReader(0));
      document.getElementById('btn-rsvp-prev').addEventListener('click', () => {
        const currentIndex = state.currentIndex >= state.words.length ? state.words.length - 1 : state.currentIndex;
        seekReader(currentIndex - 10);
      });
      document.getElementById('btn-rsvp-next').addEventListener('click', () => seekReader(state.currentIndex + 10));
      document.getElementById('btn-rsvp-end').addEventListener('click', () => seekReader(state.words.length - 1));

      // TTS audio toggler
      const ttsBtn = document.getElementById('btn-rsvp-tts');
      ttsBtn.addEventListener('click', () => {
        state.ttsActive = !state.ttsActive;
        ttsBtn.textContent = state.ttsActive ? "Audio Sync: On" : "Audio Sync: Off";
        ttsBtn.classList.toggle('active', state.ttsActive);
        if (state.isPlaying) {
          pauseReader();
          playRSVP();
        }
      });

      // Fullscreen mode toggler
      const fsBtn = document.getElementById('btn-fullscreen');
      fsBtn.addEventListener('click', () => {
        // Fullscreen the whole reader card, not just the word display: the playback
        // controls, mode switcher and tuners live outside .reader-display-container,
        // so fullscreening that alone left no way to pause or change speed.
        if (!document.fullscreenElement) {
          document.getElementById('reader-screen').requestFullscreen().catch(err => {
            alert(`Could not enter fullscreen: ${err.message}`);
          });
        } else {
          document.exitFullscreen();
        }
      });

      // Escape and F11 exit without going through our button, so track the real state.
      document.addEventListener('fullscreenchange', () => {
        const active = Boolean(document.fullscreenElement);
        fsBtn.textContent = active ? 'Exit fullscreen' : 'Fullscreen';
        fsBtn.classList.toggle('active', active);
      });

      // WPM Slider handler
      const wpmSlider = document.getElementById('slider-wpm');
      wpmSlider.addEventListener('input', (e) => {
        state.wpm = parseInt(e.target.value);
        document.getElementById('wpm-display').textContent = state.wpm;
        localStorage.setItem('wpm', state.wpm.toString());
        if (state.isPlaying && state.ttsActive) {
          // Restart speech to adjust pitch/rate changes
          pauseReader();
          playRSVP();
        }
      });

      // Voice Selector handler
      document.getElementById('select-voice').addEventListener('change', () => {
        if (state.isPlaying && state.ttsActive) {
          pauseReader();
          playRSVP();
        }
      });

      // Pitch Slider handler
      const pitchSlider = document.getElementById('slider-pitch');
      pitchSlider.addEventListener('input', (e) => {
        const pitch = parseFloat(e.target.value);
        document.getElementById('pitch-display').textContent = pitch.toFixed(1);
        if (state.isPlaying && state.ttsActive) {
          pauseReader();
          playRSVP();
        }
      });

      // Find and Replace Action
      document.getElementById('btn-run-replace').addEventListener('click', () => {
        const findVal = document.getElementById('input-find').value.trim();
        const replaceVal = document.getElementById('input-replace').value;
        if (!findVal) return alert("Please enter text to find.");
        
        const textarea = document.getElementById('text-input');
        const originalText = textarea.value;
        // Escape regex special characters for safety literal replacement
        const escapedFind = findVal.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
        const regex = new RegExp(escapedFind, 'g');
        const cleanText = originalText.replace(regex, replaceVal);
        
        textarea.value = cleanText;
        alert(`Replaced all occurrences of "${findVal}" with "${replaceVal}"!`);
      });

      // Font slider handler
      const sizeSlider = document.getElementById('slider-font-size');
      sizeSlider.addEventListener('input', (e) => {
        state.fontSize = parseInt(e.target.value);
        document.getElementById('font-size-display').textContent = state.fontSize;
        document.querySelectorAll('.rsvp-word-container, .standard-reader-view').forEach((view) => {
          view.style.fontSize = state.fontSize / 6 + 'rem';
        });
        localStorage.setItem('fontSize', state.fontSize.toString());
      });

      // Font Family Selector
      const fontSelect = document.getElementById('select-font');
      fontSelect.addEventListener('change', (e) => {
        state.font = e.target.value;
        document.documentElement.setAttribute('data-font', state.font);
        localStorage.setItem('font', state.font);
      });

      // Theme badge selectors
      document.querySelectorAll('.theme-badge').forEach(badge => {
        badge.addEventListener('click', () => {
          state.theme = badge.dataset.theme;
          document.documentElement.setAttribute('data-theme', state.theme);
          localStorage.setItem('theme', state.theme);
        });
      });

      // Reading Position slider
      document.querySelectorAll('[data-reader-scrubber]').forEach((progressSlider) => progressSlider.addEventListener('input', (e) => {
        pauseReader();
        state.currentIndex = getIndexFromPercent(Number(e.target.value), state.words.length);
        renderRSVPWord();
      }));

      // File drag-and-drop detection
      const dropzone = document.getElementById('file-dropzone');
      dropzone.addEventListener('click', () => document.getElementById('file-input').click());
      
      const fileInput = document.getElementById('file-input');
      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          document.getElementById('file-progress').classList.remove('hidden');
          const filename = file.name.toLowerCase();
          if (filename.endsWith('.pdf')) {
            handlePDFUpload(file);
          } else if (filename.endsWith('.epub')) {
            handleEPUBUpload(file);
          } else {
            // Text file
            const reader = new FileReader();
            reader.onload = (event) => initReaderSession(event.target.result, file.name, sessionOptsFromImport('upload'));
            reader.readAsText(file);
          }
        }
      });

      // Image OCR Drag and drop
      const ocrZone = document.getElementById('ocr-dropzone');
      ocrZone.addEventListener('click', () => document.getElementById('ocr-input').click());
      
      const ocrInput = document.getElementById('ocr-input');
      ocrInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) handleOCRUpload(file);
      });

      // URL parser text loader
      document.getElementById('btn-load-url').addEventListener('click', async () => {
        let url = (document.getElementById('url-input').value || '').trim();
        if (!url) return alert('Please enter a valid URL.');
        if (!/^https?:\/\//i.test(url)) url = `https://${url}`;

        const btn = document.getElementById('btn-load-url');
        const statusEl = document.getElementById('url-extract-status');
        btn.textContent = 'Extracting…';
        btn.disabled = true;
        if (statusEl) statusEl.textContent = 'Fetching page…';

        try {
          const response = await fetch(`/api/extract?url=${encodeURIComponent(url)}`);
          const json = await response.json().catch(() => ({}));

          if (!response.ok) {
            const detail = json.error || json.detail || `HTTP ${response.status}`;
            if (response.status === 404) {
              throw new Error(
                'Extract API not found (404). On local Astro dev, /api/extract only works with Vercel (vercel dev) or production. Use paste, or deploy/preview on Vercel.'
              );
            }
            throw new Error(detail);
          }

          if (!json.contents) throw new Error(json.error || 'Empty response from extractor');

          const article = extractArticleFromHtml(json.contents, url);
          btn.textContent = 'Extract Text';
          btn.disabled = false;

          if (!article.text || article.text.length < 80) {
            if (statusEl) statusEl.textContent = 'Little text found — try paste, or a simpler article URL.';
            alert('Could not extract clean body content. Many sites block extractors or load content with JavaScript. Paste the article text instead.');
            return;
          }

          if (statusEl) statusEl.textContent = `Loaded “${article.title}” (${article.text.split(/\s+/).length.toLocaleString()} words)`;
          const opts = readImportOpts('url');
          initReaderSession(`${article.title}\n\n${article.text}`, article.title, {
            saveToLibrary: opts.saveToLibrary,
            addToQueue: opts.addToQueue,
            sourceType: 'url',
            sourceUrl: url,
          });
        } catch (err) {
          console.error(err);
          btn.textContent = 'Extract Text';
          btn.disabled = false;
          if (statusEl) statusEl.textContent = err.message || 'Extract failed';
          alert(err.message || 'Failed to load webpage content.');
        }
      });

      document.getElementById('btn-save-key').addEventListener('click', () => {
        const key = document.getElementById('ai-key').value;
        if (key) {
          localStorage.setItem('gemini_key', key);
          alert("Gemini key saved locally!");
        }
      });
      
      const getGeminiKey = () => localStorage.getItem('gemini_key') || "";
      document.getElementById('ai-key').value = getGeminiKey();

      async function getGeminiModels(key) {
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models?key=${key}`);
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data?.error?.message || `Unable to list Gemini models (${res.status})`);
        const available = new Set((data.models || []).filter((model) => model.supportedGenerationMethods?.includes('generateContent')).map((model) => model.name.replace('models/', '')));
        const preferred = ['gemini-3.5-flash', 'gemini-3-flash-preview', 'gemini-2.5-flash-lite', 'gemini-2.5-flash'];
        const models = [...preferred.filter((name) => available.has(name)), ...[...available].filter((name) => name.startsWith('gemini') && !preferred.includes(name))];
        if (!models.length) throw new Error('This API key has no supported Gemini text model. Enable Gemini API access in Google AI Studio.');
        return models;
      }

      // AI is bring-your-own-key for everyone. The old hosted proxy only accepted
      // Supabase JWTs, so anyone who activated via a license key got a 401 on a
      // feature they had paid for. Deleting the proxy deletes that whole class of bug.
      async function callGemini(bodyPayload) {
        const key = getGeminiKey();
        if (!key) throw new Error('NO_KEY');
        const models = await getGeminiModels(key);
        let lastError;
        for (const model of models) {
          const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(bodyPayload),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) return data;
          lastError = data?.error?.message || `Gemini request failed (${res.status})`;
          if (res.status !== 404) break;
        }
        throw new Error(lastError);
      }

      // Helper to ensure text is loaded before running AI operations
      const ensureTextLoaded = () => {
        if (!state.text || state.text.trim() === '') {
          const pasteVal = document.getElementById('text-input').value;
          if (pasteVal.trim()) {
            parseText(pasteVal);
            state.sourceLabel = 'Pasted text';
            updateDocumentContext();
            return true;
          }
          alert("Please paste text or upload a file first!");
          return false;
        }
        return true;
      };

      document.getElementById('btn-ai-summary').addEventListener('click', async () => {
        if (!ensureTextLoaded()) return;
        if (!getGeminiKey()) return alert("Add your free Gemini API key above to use AI summary and chat.");
        
        const summaryBtn = document.getElementById('btn-ai-summary');
        summaryBtn.textContent = "Summarizing...";
        
        try {
          // Slice top content to stay within standard limits
          const textChunk = state.text.slice(0, 8000);
          const data = await callGemini({
            contents: [{
              parts: [{ text: `Generate a concise speed-reading summary with bullet points for this text:\n\n${textChunk}` }]
            }]
          });
          
          const summaryText = data.candidates?.[0]?.content?.parts?.[0]?.text;
          if (!summaryText) throw new Error('Gemini returned no summary text.');
          
          document.getElementById('ai-response-box').classList.remove('hidden');
          document.getElementById('ai-response-title').textContent = "AI summary";
          document.getElementById('ai-summary-view').classList.remove('hidden');
          document.getElementById('ai-chat-view').classList.add('hidden');
          document.getElementById('ai-response-text').innerText = summaryText;
          summaryBtn.textContent = "Generate summary";
        } catch (err) {
          if (err.message === 'NO_KEY') return alert("Please enter and save your Gemini API Key first, or upgrade to Premium.");
          alert(`AI Summarization failed: ${err.message}`);
          summaryBtn.textContent = "Generate summary";
          console.error(err);
        }
      });

      document.getElementById('btn-ai-chat').addEventListener('click', () => {
        if (!ensureTextLoaded()) return;
        if (!getGeminiKey()) return alert("Add your free Gemini API key above to use AI summary and chat.");
        
        document.getElementById('ai-response-box').classList.remove('hidden');
        document.getElementById('ai-response-title').textContent = "Chat with document";
        document.getElementById('ai-summary-view').classList.add('hidden');
        document.getElementById('ai-chat-view').classList.remove('hidden');
        
        const chatHistory = document.getElementById('chat-history');
        chatHistory.innerHTML = `<div class="chat-message assistant">I've parsed your document (${state.words.length} words). Ask me any questions, and I will extract the answers for you!</div>`;
        chatHistory.scrollTop = chatHistory.scrollHeight;
      });

      document.getElementById('btn-send-chat').addEventListener('click', async () => {
        if (!getGeminiKey()) return alert("Add your free Gemini API key above to use AI summary and chat.");
        
        const inputEl = document.getElementById('chat-user-input');
        const query = inputEl.value.trim();
        if (!query) return;
        
        inputEl.value = '';
        
        const chatHistory = document.getElementById('chat-history');
        // Escape HTML to prevent basic XSS
        const escapeHtml = (str) => str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        
        chatHistory.innerHTML += `<div class="chat-message user">${escapeHtml(query)}</div>`;
        chatHistory.scrollTop = chatHistory.scrollHeight;
        
        const loadingId = 'chat-loading-' + Date.now();
        chatHistory.innerHTML += `<div class="chat-message assistant" id="${loadingId}">Typing...</div>`;
        chatHistory.scrollTop = chatHistory.scrollHeight;
        
        try {
          const docTextSlice = state.text.slice(0, 15000);
          const data = await callGemini({
            contents: [{
              parts: [{ 
                text: `You are an AI speed reading assistant. The user has loaded this document in their reader:\n\n---\n${docTextSlice}\n---\n\nAnswer the user's question accurately based on the document text. Keep your answer clear and concise (under 3-4 sentences).\n\nUser Question: ${query}`
              }]
            }]
          });
          
          const reply = data.candidates?.[0]?.content?.parts?.[0]?.text;
          if (!reply) throw new Error('Gemini returned no chat response.');
          
          const loadingEl = document.getElementById(loadingId);
          if (loadingEl) loadingEl.remove();
          
          chatHistory.innerHTML += `<div class="chat-message assistant">${escapeHtml(reply)}</div>`;
          chatHistory.scrollTop = chatHistory.scrollHeight;
        } catch (err) {
          const loadingEl = document.getElementById(loadingId);
          if (loadingEl) loadingEl.remove();
          
          chatHistory.innerHTML += `<div class="chat-message assistant error">${escapeHtml(`Gemini failed: ${err.message}`)}</div>`;
          chatHistory.scrollTop = chatHistory.scrollHeight;
          console.error(err);
        }
      });

      document.getElementById('chat-user-input').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          document.getElementById('btn-send-chat').click();
        }
      });

      document.getElementById('btn-close-ai-box').addEventListener('click', () => {
        document.getElementById('ai-response-box').classList.add('hidden');
      });

      // Keyboard navigation rules
      document.addEventListener('keydown', (e) => {
        // Skip shortcuts if writing in text inputs
        if (document.activeElement.tagName === 'TEXTAREA' || document.activeElement.tagName === 'INPUT') {
          return;
        }

        // Spacebar play-pause toggle
        if (e.code === 'Space') {
          e.preventDefault();
          if (state.isPlaying) pauseReader();
          else playRSVP();
        }
        
        // Escape Close Reader
        if (e.code === 'Escape' && !document.getElementById('reader-screen').classList.contains('hidden')) {
          closeReaderSession();
        }

        // Speeds Adjusters (ArrowUp/Down)
        if (e.code === 'ArrowUp') {
          e.preventDefault();
          state.wpm = Math.min(1000, state.wpm + 50);
          document.getElementById('slider-wpm').value = state.wpm;
          document.getElementById('wpm-display').textContent = state.wpm;
          localStorage.setItem('wpm', state.wpm.toString());
        }
        if (e.code === 'ArrowDown') {
          e.preventDefault();
          state.wpm = Math.max(100, state.wpm - 50);
          document.getElementById('slider-wpm').value = state.wpm;
          document.getElementById('wpm-display').textContent = state.wpm;
          localStorage.setItem('wpm', state.wpm.toString());
        }

        // Timeline jumps (ArrowLeft/Right)
        if (e.code === 'ArrowLeft') {
          const currentIndex = state.currentIndex >= state.words.length ? state.words.length - 1 : state.currentIndex;
          seekReader(currentIndex - 10);
        }
        if (e.code === 'ArrowRight') {
          seekReader(state.currentIndex + 10);
        }

        // Theme shortcuts cycle: D key
        if (e.key.toLowerCase() === 'd') {
          const themes = ['light', 'sepia', 'dark', 'amoled'];
          let currentIdx = themes.indexOf(state.theme);
          let nextIdx = (currentIdx + 1) % themes.length;
          state.theme = themes[nextIdx];
          document.documentElement.setAttribute('data-theme', state.theme);
          localStorage.setItem('theme', state.theme);
        }
      });

      // ── Share achievement card ──────────────────────────────────────
      let shareCardDataUrl = '';
      let shareCardBlob = null;
      let shareCaption = '';

      const roundRect = (ctx, x, y, w, h, r) => {
        const radius = Math.min(r, w / 2, h / 2);
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.arcTo(x + w, y, x + w, y + h, radius);
        ctx.arcTo(x + w, y + h, x, y + h, radius);
        ctx.arcTo(x, y + h, x, y, radius);
        ctx.arcTo(x, y, x + w, y, radius);
        ctx.closePath();
      };

      const buildShareCaption = (stats) => {
        const host = location.origin || 'https://briskread.com';
        const parts = [
          `I just speed-read ${stats.wordsRead.toLocaleString()} words on BriskRead`,
          stats.timeSaved > 0 ? `saved ~${stats.timeSaved} min vs normal reading` : null,
          stats.streak > 0 ? `${stats.streak}-day streak` : null,
          `at ${stats.speed} WPM.`,
          `Try it free → ${host}`,
        ].filter(Boolean);
        return parts.join(' · ');
      };

      const generateShareCard = async () => {
        const stats = {
          wordsRead: state.stats.wordsRead,
          speed: state.wpm,
          timeSaved: Math.round(Math.max(0, (state.stats.wordsRead / 240) - state.stats.timeSpent)),
          streak: state.stats.streak || 0,
          timeSpent: Math.round(state.stats.timeSpent || 0),
        };
        shareCaption = buildShareCaption(stats);

        // Square card — works for WhatsApp, IG stories crop, X media
        const W = 1080;
        const H = 1080;
        const canvas = document.createElement('canvas');
        canvas.width = W;
        canvas.height = H;
        const ctx = canvas.getContext('2d');

        // Background
        const bg = ctx.createLinearGradient(0, 0, W, H);
        bg.addColorStop(0, '#07080a');
        bg.addColorStop(0.45, '#12121c');
        bg.addColorStop(1, '#1a1a2e');
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, W, H);

        // Soft brand glow
        const glow = ctx.createRadialGradient(W * 0.75, H * 0.2, 20, W * 0.75, H * 0.2, 420);
        glow.addColorStop(0, 'rgba(94, 106, 210, 0.45)');
        glow.addColorStop(1, 'rgba(94, 106, 210, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, W, H);

        // Subtle dots
        ctx.fillStyle = 'rgba(255,255,255,0.04)';
        for (let i = 0; i < 40; i++) {
          const x = (i * 97) % W;
          const y = (i * 53) % H;
          ctx.beginPath();
          ctx.arc(x, y, 1.5, 0, Math.PI * 2);
          ctx.fill();
        }

        // Card frame
        ctx.strokeStyle = 'rgba(255,255,255,0.08)';
        ctx.lineWidth = 2;
        roundRect(ctx, 48, 48, W - 96, H - 96, 36);
        ctx.stroke();

        // Brand mark
        ctx.fillStyle = '#5e6ad2';
        roundRect(ctx, 96, 110, 56, 56, 14);
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.font = '700 28px system-ui, -apple-system, sans-serif';
        ctx.fillText('⚡', 108, 148);

        ctx.fillStyle = 'rgba(255,255,255,0.55)';
        ctx.font = '650 22px system-ui, -apple-system, sans-serif';
        ctx.letterSpacing = '0.12em';
        ctx.fillText('BRISKREAD', 172, 128);
        ctx.letterSpacing = '0';

        ctx.fillStyle = '#ffffff';
        ctx.font = '600 44px system-ui, -apple-system, sans-serif';
        ctx.fillText('Reading milestone', 172, 172);

        // Hero number
        ctx.fillStyle = 'rgba(255,255,255,0.5)';
        ctx.font = '600 26px system-ui, -apple-system, sans-serif';
        ctx.fillText('WORDS SPEED-READ', 96, 300);

        ctx.fillStyle = '#a8b0f2';
        ctx.font = '700 120px system-ui, -apple-system, sans-serif';
        const wordsLabel = stats.wordsRead.toLocaleString();
        ctx.fillText(wordsLabel, 96, 420);

        // Stat chips
        const chips = [
          { label: 'PACE', value: `${stats.speed} WPM` },
          { label: 'TIME SAVED', value: `${stats.timeSaved} min` },
          { label: 'STREAK', value: `${stats.streak} day${stats.streak === 1 ? '' : 's'}` },
        ];
        const chipW = 280;
        const chipH = 120;
        const gap = 24;
        const startX = 96;
        const chipY = 500;
        chips.forEach((chip, i) => {
          const x = startX + i * (chipW + gap);
          ctx.fillStyle = 'rgba(255,255,255,0.05)';
          roundRect(ctx, x, chipY, chipW, chipH, 20);
          ctx.fill();
          ctx.strokeStyle = 'rgba(255,255,255,0.08)';
          ctx.lineWidth = 1.5;
          roundRect(ctx, x, chipY, chipW, chipH, 20);
          ctx.stroke();
          ctx.fillStyle = 'rgba(255,255,255,0.45)';
          ctx.font = '650 18px system-ui, -apple-system, sans-serif';
          ctx.fillText(chip.label, x + 24, chipY + 42);
          ctx.fillStyle = '#ffffff';
          ctx.font = '700 36px system-ui, -apple-system, sans-serif';
          ctx.fillText(chip.value, x + 24, chipY + 88);
        });

        // Footer bar
        ctx.fillStyle = 'rgba(94, 106, 210, 0.18)';
        roundRect(ctx, 96, 700, W - 192, 200, 24);
        ctx.fill();

        ctx.fillStyle = '#ffffff';
        ctx.font = '600 34px system-ui, -apple-system, sans-serif';
        ctx.fillText('Read the backlog once.', 128, 770);

        ctx.fillStyle = 'rgba(255,255,255,0.65)';
        ctx.font = '500 24px system-ui, -apple-system, sans-serif';
        ctx.fillText('RSVP · Bionic · PDF · private by default', 128, 820);

        ctx.fillStyle = '#a8b0f2';
        ctx.font = '650 26px system-ui, -apple-system, sans-serif';
        const host = (location.hostname || 'briskread.com').replace(/^www\./, '');
        ctx.fillText(host, 128, 870);

        shareCardDataUrl = canvas.toDataURL('image/png');
        const shareImg = document.getElementById('share-card-img');
        if (shareImg) {
          shareImg.src = shareCardDataUrl;
          shareImg.hidden = false;
        }

        // Blob for native share / download
        shareCardBlob = await new Promise((resolve) => {
          canvas.toBlob((b) => resolve(b), 'image/png');
        });
      };

      const setShareStatus = (msg) => {
        const el = document.getElementById('share-status');
        if (el) el.textContent = msg || '';
      };

      const openShareModal = async () => {
        setShareStatus('Building your card…');
        await generateShareCard();
        const modal = document.getElementById('share-modal');
        modal.classList.remove('hidden');
        setShareStatus('');
        // Show native share only when device can share files or text
        const nativeBtn = document.getElementById('btn-share-native');
        if (nativeBtn) {
          const canShare = typeof navigator.share === 'function';
          nativeBtn.classList.toggle('hidden', !canShare);
        }
      };

      document.getElementById('btn-share-stats').addEventListener('click', () => {
        openShareModal().catch(() => setShareStatus('Could not build the card. Try again.'));
      });

      document.getElementById('btn-close-modal').addEventListener('click', () => {
        document.getElementById('share-modal').classList.add('hidden');
        setShareStatus('');
      });

      document.getElementById('share-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) {
          e.currentTarget.classList.add('hidden');
          setShareStatus('');
        }
      });

      document.getElementById('btn-share-download')?.addEventListener('click', () => {
        if (!shareCardDataUrl) return;
        const a = document.createElement('a');
        a.href = shareCardDataUrl;
        a.download = `briskread-milestone-${Date.now()}.png`;
        a.click();
        setShareStatus('Image downloaded.');
      });

      document.getElementById('btn-share-copy')?.addEventListener('click', async () => {
        if (!shareCardBlob) {
          setShareStatus('Card not ready yet — open share again.');
          return;
        }
        try {
          if (!navigator.clipboard || typeof ClipboardItem === 'undefined') {
            setShareStatus('Copy image is not supported in this browser. Use Download instead.');
            return;
          }
          // Some browsers require a Promise for the blob payload
          const item = new ClipboardItem({
            'image/png': shareCardBlob instanceof Blob
              ? Promise.resolve(shareCardBlob)
              : shareCardBlob,
          });
          await navigator.clipboard.write([item]);
          setShareStatus('Image copied — paste it into WhatsApp, X, Slack, email, etc.');
        } catch (err) {
          // Fallback: try fetching the data URL as a blob again
          try {
            const res = await fetch(shareCardDataUrl);
            const blob = await res.blob();
            await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
            setShareStatus('Image copied — paste it wherever you like.');
          } catch {
            setShareStatus('Could not copy image (browser blocked it). Use Download instead.');
          }
        }
      });

      document.getElementById('btn-share-whatsapp')?.addEventListener('click', () => {
        const text = encodeURIComponent(shareCaption || buildShareCaption({
          wordsRead: state.stats.wordsRead,
          speed: state.wpm,
          timeSaved: Math.round(Math.max(0, (state.stats.wordsRead / 240) - state.stats.timeSpent)),
          streak: state.stats.streak || 0,
        }));
        window.open(`https://wa.me/?text=${text}`, '_blank', 'noopener,noreferrer');
        setShareStatus('WhatsApp opened with your caption. Attach the image if you want the card too.');
      });

      document.getElementById('btn-share-x')?.addEventListener('click', () => {
        const text = encodeURIComponent(shareCaption || 'Speed-reading with BriskRead');
        const url = encodeURIComponent(location.origin || 'https://briskread.com');
        window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank', 'noopener,noreferrer');
        setShareStatus('X compose opened. Attach the downloaded image for a stronger post.');
      });

      document.getElementById('btn-share-linkedin')?.addEventListener('click', () => {
        const url = encodeURIComponent(location.origin || 'https://briskread.com');
        window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, '_blank', 'noopener,noreferrer');
        setShareStatus('LinkedIn opened. Download the image and upload it to your post for the full card.');
      });

      document.getElementById('btn-share-native')?.addEventListener('click', async () => {
        if (!navigator.share) {
          setShareStatus('Native share is not available on this browser.');
          return;
        }
        try {
          const file = shareCardBlob
            ? new File([shareCardBlob], 'briskread-milestone.png', { type: 'image/png' })
            : null;
          const payload = {
            title: 'My BriskRead milestone',
            text: shareCaption,
            url: location.origin || 'https://briskread.com',
          };
          if (file && navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ ...payload, files: [file] });
          } else {
            await navigator.share(payload);
          }
          setShareStatus('Shared.');
        } catch (err) {
          if (err && err.name === 'AbortError') {
            setShareStatus('');
            return;
          }
          setShareStatus('Share cancelled or not supported. Try download + WhatsApp / X instead.');
        }
      });
      
      document.getElementById('btn-pricing-signin')?.addEventListener('click', () => {
        window.location.href = '/account?next=%2F%23pricing';
      });

      // Dodo Payments checkout
      document.getElementById('btn-buy-premium').addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        btn.textContent = 'Redirecting to checkout...';
        try {
          const supabase = globalThis.briskreadSupabase;
          const { data: { session } } = supabase ? await supabase.auth.getSession() : { data: { session: null } };
          if (!session) {
            window.location.href = '/account?next=%2F%23pricing';
            return;
          }
          const res = await fetch('/api/create-checkout', {
            method: 'POST',
            headers: { Authorization: `Bearer ${session.access_token}` },
          });
          const data = await res.json();
          if (!data.checkout_url) throw new Error(data.error || 'No checkout URL returned');
          window.location.href = data.checkout_url;
        } catch (err) {
          alert('Could not start checkout. Please try again shortly.');
          console.error(err);
          btn.disabled = false;
          btn.textContent = 'Get Lifetime — $9';
        }
      });

      const activateOnThisDevice = async (licenseKey, revokeDeviceId) => {
        const status = document.getElementById('license-status');
        const body = {
          license_key: licenseKey,
          device_id: getDeviceId(),
          device_label: getDeviceLabel(),
        };
        if (revokeDeviceId) body.revoke_device_id = revokeDeviceId;

        const res = await fetch('/api/activate-license', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();

        if (data.code === 'DEVICE_LIMIT' && data.devices) {
          renderDeviceList(data.devices, data.max_devices || 5);
          status.textContent = data.error + ' Click Revoke on a device below, then Activate again.';
          localStorage.setItem('license_key', licenseKey);
          if (document.getElementById('license-key-display')) {
            document.getElementById('license-key-display').value = licenseKey;
            document.getElementById('license-display').classList.remove('hidden');
          }
          return data;
        }

        if (!res.ok || !data.ok) {
          status.textContent = data.error || 'Invalid license key.';
          return data;
        }

        unlockPremium({
          licenseKey: data.license_key || licenseKey,
          sessionToken: data.token,
          devices: data.devices,
          maxDevices: data.max_devices,
        });
        status.textContent = 'Premium unlocked on this device (slot secured).';
        return data;
      };

      document.getElementById('btn-activate-license').addEventListener('click', async () => {
        const input = document.getElementById('license-key-input');
        const status = document.getElementById('license-status');
        const licenseKey = (input.value || getStoredLicenseKey() || '').trim();
        if (!licenseKey) {
          status.textContent = 'Paste your license key first.';
          return;
        }
        status.textContent = 'Binding this device…';
        try {
          await activateOnThisDevice(licenseKey);
          input.value = '';
        } catch (err) {
          console.error(err);
          status.textContent = 'Activation failed. Check your connection and try again.';
        }
      });

      document.getElementById('device-list').addEventListener('click', async (e) => {
        const btn = e.target.closest('.btn-revoke-device');
        if (!btn) return;
        const revokeId = btn.getAttribute('data-device-id');
        const license = getStoredLicenseKey() || document.getElementById('license-key-input').value.trim();
        if (!license || !revokeId) return;
        const status = document.getElementById('license-status');
        status.textContent = 'Revoking device…';
        try {
          await activateOnThisDevice(license, revokeId);
          status.textContent = 'Device revoked. This device is now activated.';
        } catch (err) {
          console.error(err);
          status.textContent = 'Could not revoke device.';
        }
      });

      document.getElementById('btn-copy-license').addEventListener('click', async () => {
        const val = document.getElementById('license-key-display').value;
        if (!val) return;
        try {
          await navigator.clipboard.writeText(val);
          document.getElementById('license-status').textContent = 'License key copied — store it offline, do not share publicly.';
        } catch {
          document.getElementById('license-key-display').select();
          document.execCommand('copy');
          document.getElementById('license-status').textContent = 'License key selected — copy manually if needed.';
        }
      });

      // Return from Dodo checkout → license + bind this device
      const returnParams = new URLSearchParams(window.location.search);
      if (returnParams.get('checkout') === 'return' && returnParams.get('payment_id')) {
        const paymentId = returnParams.get('payment_id');
        const qs = new URLSearchParams({
          payment_id: paymentId,
          device_id: getDeviceId(),
          device_label: getDeviceLabel(),
        });
        fetch(`/api/verify-payment?${qs}`)
          .then(r => r.json())
          .then((data) => {
            history.replaceState(null, '', window.location.pathname);
            if (data.ok) {
              if (data.account_linked) {
                state.isPremium = true;
                applyPremiumUI();
                alert('Payment confirmed. Lifetime Premium is now attached to your BriskRead account.');
                return;
              }
              unlockPremium({
                licenseKey: data.license_key,
                sessionToken: data.token,
                devices: data.devices,
                maxDevices: data.max_devices,
              });
              if (!data.token) {
                alert(data.warning || 'Payment confirmed. Save your license key, then click Activate device if Premium is not active yet.');
              } else {
                alert('Payment confirmed! Premium is active on this device. Save your license key offline for other devices (max 5).');
              }
              const panel = document.getElementById('license-panel');
              if (panel) panel.scrollIntoView({ behavior: 'smooth' });
            } else {
              alert('We could not confirm this payment. If you were charged, contact support with your receipt.');
            }
          })
          .catch(() => history.replaceState(null, '', window.location.pathname));
      }

      // Chrome extension handoff (content-handoff.js + retries / custom event)
      const applyExtensionPremium = () => {
        if (localStorage.getItem('premium_token')) {
          localStorage.setItem('is_premium', 'true');
          state.isPremium = true;
          applyPremiumUI();
          return true;
        }
        return false;
      };

      const loadExtensionHandoff = () => {
        try {
          const raw = sessionStorage.getItem('sr_extension_article');
          if (!raw) return false;
          sessionStorage.removeItem('sr_extension_article');
          const data = JSON.parse(raw);
          const title = (data.title || '').trim();
          const text = (data.text || '').trim();
          applyExtensionPremium();
          if (!text || text.length < 40) {
            // URL-only handoff: fall through to ?url=
            if (data.url) {
              const urlInput = document.getElementById('url-input');
              if (urlInput) {
                urlInput.value = data.url;
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                document.querySelector('.tab-btn[data-tab="url"]')?.classList.add('active');
                document.getElementById('tab-url')?.classList.add('active');
                document.getElementById('btn-load-url')?.click();
                return true;
              }
            }
            return false;
          }
          const combined = title ? `${title}\n\n${text}` : text;
          history.replaceState(null, '', window.location.pathname);
          initReaderSession(combined, title || 'Chrome extension article');
          return true;
        } catch (e) {
          console.warn('Extension handoff failed', e);
          return false;
        }
      };

      const runExtensionBoot = () => {
        if (loadExtensionHandoff()) return;
        const autoUrl = returnParams.get('url');
        if (autoUrl) {
          const urlInput = document.getElementById('url-input');
          if (urlInput) {
            urlInput.value = autoUrl;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelector('.tab-btn[data-tab="url"]')?.classList.add('active');
            document.getElementById('tab-url')?.classList.add('active');
            history.replaceState(null, '', window.location.pathname + window.location.hash);
            document.getElementById('btn-load-url')?.click();
          }
        }
        if (returnParams.get('source') === 'extension' || sessionStorage.getItem('sr_from_extension')) {
          sessionStorage.removeItem('sr_from_extension');
          applyExtensionPremium();
        }
      };

      runExtensionBoot();
      // Late handoff if content script wins the race after DOMContentLoaded
      window.addEventListener('sr-extension-handoff', () => {
        applyExtensionPremium();
        loadExtensionHandoff();
      });
      setTimeout(runExtensionBoot, 250);
    });
  </script>

