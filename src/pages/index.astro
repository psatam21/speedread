      outline: none;
      font-size: 0.95rem;
      transition: all 150ms ease;
    }
    .url-input-container input:focus {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px var(--color-primary-shadow);
    }
    .input-hint {
      font-size: 0.85rem;
      color: var(--color-text-subtle);
      margin-top: 0.5rem;
    }
    
    .ai-config {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .ai-workspace {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem 1.5rem;
      align-items: end;
      border-top: 1px solid var(--color-border);
      margin-top: 1.5rem;
      padding-top: 1.5rem;
    }
    .ai-workspace-copy h3 { font-size: 1rem; margin-bottom: 0.25rem; }
    .ai-workspace-copy p { color: var(--color-text-muted); font-size: 0.9rem; }
    .gemini-guide { margin-top: 0.7rem; color: var(--color-text-muted); font-size: 0.85rem; }
    .gemini-guide summary { color: var(--color-primary); cursor: pointer; font-weight: 700; }
    .gemini-guide ol { margin: 0.65rem 0 0.4rem 1.2rem; line-height: 1.55; }
    .gemini-guide p { margin: 0; }
    .ai-workspace .ai-config, .ai-workspace #ai-response-box { grid-column: 1 / -1; }
    .ai-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
    .ai-actions .btn:disabled { cursor: not-allowed; }
    .key-input-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }
    @media (max-width: 640px) {
      .importer-heading, .ai-workspace { grid-template-columns: 1fr; display: grid; }
      .document-status { max-width: none; text-align: left; }
      .key-input-row { flex-wrap: wrap; }
      .key-input-row input { min-width: 100%; }
      .mode-switcher { overflow-x: auto; scrollbar-width: none; }
      .mode-switcher::-webkit-scrollbar { display: none; }
      .mode-btn { flex: 0 0 auto; min-height: 2.75rem; padding: 0.65rem 0.9rem; }
      .reader-display-container { overflow: hidden; }
      .playback-controls { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
      .control-btn { min-height: 2.75rem; padding: 0.55rem 0.4rem; font-size: 0.78rem; }
      .control-btn.play-btn { grid-column: span 2; padding: 0.55rem 0.75rem; }
      #btn-rsvp-tts { grid-column: span 2; }
      #btn-fullscreen { grid-column: 1 / -1; }
      .tuner-grid, .tuner-card { min-width: 0; }
      .tuner-card input, .tuner-card select { width: 100%; min-width: 0; }
      .find-replace-grid { grid-template-columns: 1fr; }
      .find-replace-grid > * { width: 100%; min-width: 0; }
      .dashboard-card, .pricing-card { padding: 1.25rem; }
      .stat-box { padding: 1rem 0.65rem; }
      .stat-value { font-size: 1.65rem; }
      .stat-label { font-size: 0.7rem; }
    }
    .key-input-row input {
      flex: 1;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      background-color: var(--color-bg-subtle);
      color: var(--color-text);
      outline: none;
      font-size: 0.95rem;
      transition: all 150ms ease;
    }
    .key-input-row input:focus {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px var(--color-primary-shadow);
    }
    .api-link {
      font-size: 0.9rem;
      white-space: nowrap;
      font-weight: 600;
    }
    
    /* Reader Layouts */
    .reader-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border);
    }
    .mode-switcher {
      display: flex;
      gap: 0.2rem;
      padding: 0.25rem;
      background: var(--color-bg-subtle);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
    }
    .mode-btn {
      flex: 1;
      background: transparent;
      border: 1px solid transparent;
      color: var(--color-text-subtle);
      padding: 0.5rem 0.4rem;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      border-radius: var(--radius-sm);
      transition: background-color 120ms ease, color 120ms ease;
      font-family: var(--font-sans);
    }
    .mode-btn:hover {
      color: var(--color-text);
    }
    .mode-btn.active {
      background-color: var(--color-bg-card);
      color: var(--color-text);
      border-color: var(--color-border);
    }
    .mode-description {
      margin: 0.55rem 0 0;
      color: var(--color-text-muted);
      font-size: 0.8rem;
      text-align: center;
    }
    
    .reader-progress-scrubber {
      display: block;
      width: 100%;
      margin-top: 1rem;
      accent-color: var(--color-primary);
      cursor: ew-resize;
      touch-action: pan-y;
    }
    
    .controls-hud {
      border-top: 1px solid var(--color-border);
      padding-top: 1.25rem;
    }
    .playback-controls {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      align-items: center;
    }
    .control-btn {
      background-color: var(--color-bg-subtle);
      color: var(--color-text);
      border: 1px solid var(--color-border);
      padding: 0.5rem 1rem;
      border-radius: var(--radius-md);
      font-weight: 600;
      cursor: pointer;
      transition: all 150ms ease;
    }
    .control-btn:hover {
      background-color: var(--color-border);
    }
    .control-btn.play-btn {
      background: var(--color-primary);
      color: #ffffff;
      border-color: var(--color-primary);
      padding: 0.65rem 1.75rem;
      font-size: 1rem;
    }
    .control-btn.play-btn:hover {
      background: var(--color-primary-hover);
      border-color: var(--color-primary-hover);
    }
    .control-btn.active {
      background-color: var(--color-accent);
      color: #ffffff;
      border-color: var(--color-accent);
    }
    
    .tuner-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.25rem;
    }
    @media (min-width: 768px) {
      .tuner-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    .tuner-card {
      background-color: var(--color-bg-subtle);
      padding: 0.75rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .tuner-card label {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-text-subtle);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .tuner-card select {
      padding: 0.4rem;
      background-color: var(--color-bg-card);
      color: var(--color-text);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      outline: none;
      font-size: 0.85rem;
      font-weight: 600;
    }
    .tuner-hint {
      font-size: 0.7rem;
      color: var(--color-text-subtle);
      margin-top: 0.15rem;
      line-height: 1.2;
    }
    .theme-picker {
      display: flex;
      gap: 0.35rem;
    }
    .theme-badge {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid var(--color-border);
      cursor: pointer;
      font-size: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }
    .theme-badge.light { background-color: #ffffff; color: #000; }
    .theme-badge.sepia { background-color: #f4ecd8; color: #433422; border-color: #d9cbaf; }
    .theme-badge.dark { background-color: #0f172a; color: #fff; border-color: #334155; }
    .theme-badge.amoled { background-color: #000000; color: #fff; border-color: #262626; }
    
    .timeline-row {
      margin-top: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .timeline-row input[type="range"] {
      width: 100%;
    }
    .timeline-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--color-text-subtle);
    }
    
    .ads-section {
      margin-top: 0;
      padding: 2rem 0;
      scroll-margin-top: 6rem;
      border-block: 1px solid var(--color-border);
      background: var(--color-bg-subtle);
    }
    .ads-section.hidden {
      display: none !important;
    }

    .license-panel {
      border-top: 1px solid var(--color-border);
      padding-top: 1.25rem;
    }
    .account-purchase-panel {
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg-subtle);
    }
    .account-purchase-panel strong { display: block; color: var(--color-text); font-size: 0.82rem; }
    .account-purchase-panel p { margin: 0.35rem 0 0.8rem; color: var(--color-text-muted); font-size: 0.75rem; line-height: 1.5; }
    .license-heading {
      font-size: 0.95rem;
      margin-bottom: 0.35rem;
    }
    .license-hint {
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
    }
    .license-row {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .license-row input {
      flex: 1;
      min-width: 160px;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      background: var(--color-bg-subtle);
      color: var(--color-text);
      font-family: ui-monospace, monospace;
      font-size: 0.8rem;
    }
    .license-status {
      font-size: 0.8rem;
      margin-top: 0.5rem;
      min-height: 1.2em;
    }
    .license-display {
      margin-top: 1rem;
    }
    .license-display label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-bottom: 0.35rem;
    }
    .device-list-wrap {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }
    .device-list-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
    }
    .device-count {
      font-variant-numeric: tabular-nums;
      color: var(--color-primary);
    }
    .device-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin: 0;
      padding: 0;
    }
    .device-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.55rem 0.75rem;
      background: var(--color-bg-subtle);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
    }
    .device-item.is-current {
      border-color: var(--color-success);
      background: var(--color-success-muted);
    }
    .device-item-label em {
      font-style: normal;
      color: var(--color-success);
      font-weight: 600;
      font-size: 0.75rem;
    }
    .device-help {
      font-size: 0.75rem;
      margin-top: 0.5rem;
    }
    .btn-premium-active {
      background: var(--color-success) !important;
      box-shadow: none !important;
    }
    .pricing-tag.tag-success {
      background-color: var(--color-success) !important;
    }
    .seo-steps, .seo-usecases {
      margin: 0.75rem 0 1.25rem 1.25rem;
      color: var(--color-text-muted);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      line-height: 1.65;
    }
    .seo-text kbd {
      background: var(--color-bg-subtle);
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      padding: 0.05rem 0.35rem;
      font-size: 0.85em;
    }
    
    /* Compare section */
    .compare-section {
      padding: 0.5rem 0 0.25rem;
    }
    .compare-scroll {
      margin-top: 1.25rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-bg-card);
    }
    .compare-table {
      width: 100%;
      min-width: 52rem;
      border-collapse: collapse;
      font-size: 0.84rem;
      line-height: 1.45;
    }
    .compare-table th,
    .compare-table td {
      padding: 0.75rem 0.85rem;
      text-align: left;
      border-bottom: 1px solid var(--color-border);
      vertical-align: top;
      color: var(--color-text-muted);
    }
    .compare-table thead th {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-text);
      background: var(--color-bg-subtle);
      position: sticky;
      top: 0;
      white-space: nowrap;
    }
    .compare-table tbody th {
      font-weight: 650;
      color: var(--color-text);
      background: var(--color-bg-card);
      min-width: 8.5rem;
    }
    .compare-table tr:last-child th,
    .compare-table tr:last-child td {
      border-bottom: none;
    }
    .compare-table .compare-you {
      background: color-mix(in srgb, var(--color-primary-muted) 55%, var(--color-bg-card));
      color: var(--color-text);
      font-weight: 550;
    }
    .compare-table thead .compare-you {
      color: var(--color-primary);
    }
    .compare-honest {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 1.25rem;
    }
    @media (min-width: 768px) {
      .compare-honest {
        grid-template-columns: 1fr 1fr;
      }
    }
    .compare-honest > div {
      padding: 1.1rem 1.2rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-bg-card);
    }
    .compare-honest h3 {
      margin: 0 0 0.65rem;
      font-size: 1rem;
      letter-spacing: -0.02em;
    }
    .compare-honest ul {
      margin: 0;
      padding-left: 1.1rem;
      color: var(--color-text-muted);
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .compare-cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 1.15rem;
    }

    /* Pricing intro + free/lifetime grid */
    .pricing-section-intro {
      margin-bottom: 1.25rem;
      max-width: 44rem;
    }
    .pricing-section-title {
      margin: 0.25rem 0 0.5rem;
      font-size: clamp(1.35rem, 2.5vw, 1.75rem);
      letter-spacing: -0.03em;
    }
    .pricing-section-lede {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.55;
    }
    .pricing-claim-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: stretch;
      margin-top: 1.35rem;
    }
    @media (min-width: 900px) {
      .pricing-claim-grid {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      }
    }
    .compare-table-lifetime {
      min-width: 40rem;
    }
    .compare-honest-inline {
      margin: 0.85rem 0 0;
      font-size: 0.88rem;
      line-height: 1.5;
      max-width: 52rem;
    }
    .compare-honest-inline a {
      color: var(--color-primary);
      font-weight: 550;
    }
    .seat-meter {
      margin-top: 1rem;
      padding: 0.85rem 0.95rem;
      border-radius: var(--radius-md);
      border: 1px solid color-mix(in srgb, var(--color-primary) 30%, var(--color-border));
      background: color-mix(in srgb, var(--color-primary-muted) 45%, var(--color-bg-card));
    }
    .seat-meter-full {
      border-color: var(--color-border);
      background: var(--color-bg-subtle);
    }
    .seat-meter-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .seat-meter-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-primary);
    }
    .seat-meter-full .seat-meter-label {
      color: var(--color-text-muted);
    }
    .seat-meter-count {
      font-size: 0.88rem;
      font-weight: 650;
      color: var(--color-text);
      font-variant-numeric: tabular-nums;
    }
    .seat-meter-track {
      margin-top: 0.55rem;
      height: 0.45rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-border) 80%, transparent);
      overflow: hidden;
    }
    .seat-meter-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--color-primary), color-mix(in srgb, var(--color-primary) 70%, #fff));
      transition: width 0.45s var(--ease-out, ease);
    }
    .seat-meter-full .seat-meter-fill {
      background: var(--color-text-muted);
    }
    .seat-meter-detail {
      margin: 0.55rem 0 0;
      font-size: 0.78rem;
      line-height: 1.45;
    }

    /* Pricing & Analytics layout */
    .pricing-analytics-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    @media (min-width: 768px) {
      .pricing-analytics-grid {
        grid-template-columns: 1fr;
      }
    }
    .dashboard-card, .pricing-card {
      padding: 1.75rem;
      border-radius: var(--radius-lg);
      background-color: var(--color-bg-card);
      border: 1px solid var(--color-border);
    }
    .dashboard-card {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse 80% 50% at 100% 0%, var(--color-primary-muted), transparent 55%),
        var(--color-bg-card);
    }
    .dashboard-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
    }
    .dashboard-kicker {
      margin: 0 0 0.35rem;
      color: var(--color-primary);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .dashboard-card h3 {
      margin: 0;
      font-size: 1.35rem;
      font-weight: 650;
      letter-spacing: -0.02em;
    }
    .dashboard-lede {
      margin: 0.4rem 0 0;
      max-width: 36ch;
      font-size: 0.88rem;
      line-height: 1.45;
    }
    .dashboard-streak-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      flex-shrink: 0;
      padding: 0.45rem 0.75rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: var(--color-bg-subtle);
      font-size: 0.78rem;
      color: var(--color-text-muted);
      white-space: nowrap;
    }
    .dashboard-streak-pill strong {
      color: var(--color-text);
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .dashboard-streak-pill.is-hot {
      border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
      background: var(--color-primary-muted);
      color: var(--color-primary);
    }
    .dashboard-streak-pill.is-hot strong { color: var(--color-primary); }
    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    .stat-box {
      position: relative;
      background-color: var(--color-bg);
      padding: 1.1rem 1rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--color-border);
      text-align: left;
      transition: border-color 160ms var(--ease-out), transform 160ms var(--ease-out);
    }
    .stat-box:hover {
      border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
      transform: translateY(-1px);
    }
    .stat-box-highlight {
      border-color: color-mix(in srgb, var(--color-primary) 28%, var(--color-border));
      background: color-mix(in srgb, var(--color-primary-muted) 55%, var(--color-bg));
    }
    .stat-icon {
      display: grid;
      place-items: center;
      width: 1.85rem;
      height: 1.85rem;
      margin-bottom: 0.65rem;
      border-radius: 8px;
      background: var(--color-primary-muted);
      color: var(--color-primary);
    }
    .stat-icon svg { width: 1rem; height: 1rem; }
    .stat-value {
      display: block;
      font-size: clamp(1.55rem, 3vw, 1.9rem);
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--color-text);
      letter-spacing: -0.03em;
      margin-bottom: 0.2rem;
      font-variant-numeric: tabular-nums;
    }
    .stat-box-highlight .stat-value { color: var(--color-primary); }
    .stat-label {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--color-text-subtle);
      letter-spacing: 0.02em;
    }
    .dashboard-actions {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.55rem;
    }
    .dashboard-actions .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
    }
    .dashboard-share-hint {
      margin: 0;
      font-size: 0.78rem;
      text-align: center;
    }
    @media (max-width: 520px) {
      .dashboard-head { flex-direction: column; }
    }
    
    .pricing-card {
      position: relative;
      overflow: hidden;
    }
    .premium-badge {
      border-color: var(--color-primary);
    }
    .pricing-tag {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      background-color: var(--color-primary-muted);
      color: var(--color-primary);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* Workspace — matches marketing sections, not a settings console */
    .workspace-shell {
      margin-top: 0.5rem;
    }
    .workspace-intro {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem 1.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.15rem;
    }
    .workspace-intro h2 {
      margin: 0 0 0.35rem;
      font-size: clamp(1.35rem, 2.4vw, 1.75rem);
      letter-spacing: -0.03em;
      font-weight: 700;
    }
    .workspace-lede {
      margin: 0;
      max-width: 36rem;
      color: var(--color-text-muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }
    .workspace-status-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      justify-content: flex-end;
    }
    .workspace-pill {
      display: inline-flex;
      align-items: center;
      min-height: 1.85rem;
      padding: 0.25rem 0.7rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: var(--color-bg-card);
      color: var(--color-text-muted);
      font-size: 0.75rem;
      font-weight: 600;
    }
    .workspace-pill:empty { display: none; }
    .workspace-pill-muted {
      color: var(--color-text-subtle);
      background: transparent;
    }
    .workspace-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }
    @media (max-width: 800px) {
      .workspace-grid { grid-template-columns: 1fr; }
      .workspace-intro { align-items: flex-start; }
      .workspace-status-pills { justify-content: flex-start; }
    }
    .workspace-panel {
      padding: 1.15rem 1.2rem 1.2rem;
      border-radius: var(--radius-xl);
      min-height: 12rem;
      display: flex;
      flex-direction: column;
    }
    .workspace-panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.65rem;
      margin-bottom: 0.85rem;
    }
    .workspace-panel-head h3 {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .workspace-panel-sub {
      margin: 0.2rem 0 0;
      color: var(--color-text-subtle);
      font-size: 0.75rem;
      line-height: 1.35;
    }
    .workspace-panel-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }
    .btn-ghost {
      border: 0;
      background: transparent;
      color: var(--color-text-muted);
      font-weight: 600;
      box-shadow: none;
    }
    .btn-ghost:hover {
      color: var(--color-primary);
      background: var(--color-primary-muted);
    }
    .workspace-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      max-height: 260px;
      overflow: auto;
      flex: 1;
    }
    .workspace-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
      padding: 0.7rem 0.8rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: color-mix(in srgb, var(--color-bg) 55%, var(--color-bg-card));
      transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    }
    .workspace-item:hover {
      border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    }
    .workspace-item.is-done { opacity: 0.5; }
    .workspace-item-main {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
      flex: 1;
    }
    .workspace-item-main strong {
      font-size: 0.88rem;
      font-weight: 650;
      letter-spacing: -0.01em;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .workspace-item-main .muted { font-size: 0.72rem; color: var(--color-text-subtle); }
    .workspace-item-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      flex-shrink: 0;
    }
    .workspace-item-actions .btn {
      min-height: 2rem;
      padding-inline: 0.65rem;
      font-size: 0.75rem;
    }
    .workspace-empty {
      margin-top: auto;
      padding: 1.1rem 0.25rem 0.35rem;
      text-align: left;
    }
    .workspace-empty.hidden { display: none; }
    .workspace-empty strong {
      display: block;
      font-size: 0.88rem;
      font-weight: 650;
      margin-bottom: 0.25rem;
    }
    .workspace-empty p {
      margin: 0;
      color: var(--color-text-subtle);
      font-size: 0.8rem;
      line-height: 1.45;
      max-width: 28ch;
    }

    .workspace-advanced {
      margin-top: 0.9rem;
      border-radius: var(--radius-xl);
      padding: 0;
      overflow: hidden;
    }
    .workspace-advanced > summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.95rem 1.2rem;
      user-select: none;
    }
    .workspace-advanced > summary::-webkit-details-marker { display: none; }
    .workspace-advanced > summary span {
      font-size: 0.9rem;
      font-weight: 650;
      letter-spacing: -0.01em;
    }
    .workspace-advanced > summary small {
      color: var(--color-text-subtle);
      font-size: 0.78rem;
      font-weight: 500;
    }
    .workspace-advanced[open] > summary {
      border-bottom: 1px solid var(--color-border);
    }
    .workspace-advanced-body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem 1.25rem;
      padding: 1.1rem 1.2rem 1.25rem;
    }
    @media (max-width: 800px) {
      .workspace-advanced-body { grid-template-columns: 1fr; }
    }
    .workspace-adv-block {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      align-items: flex-start;
    }
    .workspace-adv-copy h4 {
      margin: 0 0 0.25rem;
      font-size: 0.88rem;
      font-weight: 700;
    }
    .workspace-adv-copy p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.8rem;
      line-height: 1.45;
    }
    .profile-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .profile-pill {
      border: 1px solid var(--color-border);
      background: var(--color-bg-card);
      color: var(--color-text);
      border-radius: 999px;
      padding: 0.4rem 0.9rem;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    }
    .profile-pill:hover {
      border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
    }
    .profile-pill.is-active {
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: #fff;
    }
    .profile-pill.is-saved:not(.is-active) {
      border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
      background: var(--color-primary-muted);
    }
    .retention-segment {
      display: inline-flex;
      flex-wrap: wrap;
      padding: 0.2rem;
      gap: 0.2rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: var(--color-bg);
    }
    .retention-seg {
      cursor: pointer;
    }
    .retention-seg input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .retention-seg span {
      display: inline-flex;
      align-items: center;
      min-height: 2rem;
      padding: 0.3rem 0.85rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-text-muted);
      transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    }
    .retention-seg input:checked + span {
      background: var(--color-bg-card);
      color: var(--color-text);
      box-shadow: var(--shadow-sm);
    }
    .import-dest-options {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }
    .import-check {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
    }
    /* Focus / Page / Bionic: fill the full reader stage width + height */
    #standard-text-view.standard-reader-view,
    #bionic-text-view.standard-reader-view,
    .reader-text-surface {
      width: 100%;
      max-width: none;
      box-sizing: border-box;
      max-height: min(58vh, 520px);
      overflow-y: auto;
      scroll-behavior: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
    }
    #reader-screen[data-reader-mode="focus"] #standard-text-view.standard-reader-view,
    #reader-screen[data-reader-mode="standard"] #standard-text-view.standard-reader-view,
    #reader-screen[data-reader-mode="bionic"] #bionic-text-view.standard-reader-view {
      /* Fill remaining viewport under chrome (header + modes + controls) */
      width: 100%;
      max-width: none;
      height: clamp(16rem, calc(100dvh - 20rem), 48rem);
      max-height: none;
      min-height: clamp(14rem, 40dvh, 22rem);
      font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.28rem);
      line-height: 1.75;
      padding: clamp(0.9rem, 2.5vw, 1.4rem);
    }
    /* Focus: no native scrollbar — transform steers the track to the eye line */
    #reader-screen[data-reader-mode="focus"] #standard-text-view.standard-reader-view {
      overflow: hidden;
    }
    #reader-screen[data-reader-mode="focus"] .reader-display-container,
    #reader-screen[data-reader-mode="standard"] .reader-display-container,
    #reader-screen[data-reader-mode="bionic"] .reader-display-container {
      min-height: 0;
      width: 100%;
    }
    #reader-screen[data-reader-mode="focus"] #standard-pane,
    #reader-screen[data-reader-mode="standard"] #standard-pane,
    #reader-screen[data-reader-mode="bionic"] #bionic-pane {
      width: 100%;
    }
    #reader-screen.glass {
      max-width: 100%;
    }
    .reader-display-container {
      max-width: 100%;
      width: 100%;
    }
    .reader-pane {
      width: 100%;
    }
    @media (max-width: 760px) {
      #reader-screen[data-reader-mode="focus"] #standard-text-view.standard-reader-view,
      #reader-screen[data-reader-mode="standard"] #standard-text-view.standard-reader-view,
      #reader-screen[data-reader-mode="bionic"] #bionic-text-view.standard-reader-view {
        height: clamp(12rem, calc(100dvh - 18rem), 70dvh);
        min-height: clamp(11rem, 42dvh, 18rem);
      }
    }
    @media (min-width: 1100px) {
      #reader-screen[data-reader-mode="focus"] #standard-text-view.standard-reader-view,
      #reader-screen[data-reader-mode="standard"] #standard-text-view.standard-reader-view,
      #reader-screen[data-reader-mode="bionic"] #bionic-text-view.standard-reader-view {
        height: clamp(16rem, calc(100dvh - 20rem), 48rem);
      }
    }
    .reader-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .reader-header-main h3 { margin: 0; }
    .reader-meta { margin: 0.2rem 0 0; font-size: 0.8rem; }
    .reader-header-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .reader-tools-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 0.85rem;
    }
    .chapter-map-wrap {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      min-width: min(100%, 260px);
      flex: 1;
    }
    .chapter-map-wrap label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--color-text-subtle);
    }
    .chapter-map-wrap select {
      width: 100%;
      border-radius: 10px;
      border: 1px solid var(--color-border);
      background: var(--color-bg, #fff);
      color: var(--color-text);
      padding: 0.45rem 0.6rem;
      font-size: 0.88rem;
    }
    .reader-tool-btns { display: flex; flex-wrap: wrap; gap: 0.35rem; }

    .retention-modal {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(8, 10, 18, 0.55);
      backdrop-filter: blur(6px);
    }
    .retention-modal.hidden,
    .retention-modal[hidden] { display: none !important; }
    .retention-card {
      width: min(520px, 100%);
      max-height: min(85vh, 640px);
      overflow: auto;
      padding: 1.25rem;
      border-radius: 18px;
    }
    .retention-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
    }
    .retention-card-head h3 { margin: 0; }
    .retention-body { display: flex; flex-direction: column; gap: 1rem; margin: 1rem 0; }
    .retention-prompt { margin: 0 0 0.45rem; font-weight: 600; font-size: 0.92rem; }
    .retention-opts { display: flex; flex-direction: column; gap: 0.35rem; }
    .retention-opt {
      display: flex;
      gap: 0.45rem;
      align-items: flex-start;
      font-size: 0.88rem;
      cursor: pointer;
    }
    .retention-open {
      width: 100%;
      border-radius: 10px;
      border: 1px solid var(--color-border);
      background: var(--color-bg, #fff);
      color: var(--color-text);
      padding: 0.55rem 0.65rem;
      font: inherit;
      resize: vertical;
    }
    .retention-actions { display: flex; justify-content: flex-end; }

    /* Product features inventory */
    .product-features {
      padding: 3.5rem 0 2rem;
    }
    .features-tier-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-top: 1.5rem;
    }
    .feature-tier {
      padding: 1.35rem 1.4rem;
      border-radius: 18px;
    }
    .feature-tier h3 {
      margin: 0 0 0.85rem;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .feature-tier ul {
      margin: 0;
      padding: 0 0 0 1.1rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      font-size: 0.9rem;
      line-height: 1.45;
      color: var(--color-text);
    }
    .feature-tier li strong { font-weight: 700; }
    .feature-tier-pro {
      border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 18%, transparent);
    }
    .feature-tier-pro .btn { margin-top: 1.15rem; width: 100%; }
    .feature-badge {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
    }
    .feature-badge.free {
      background: var(--color-bg-subtle, #f1f2f6);
      color: var(--color-text-muted);
    }
    .feature-badge.pro {
      background: var(--color-primary-muted, #e8eafc);
      color: var(--color-primary);
    }
    .features-detail-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.9rem;
      margin-top: 1.25rem;
    }
    .feature-card {
      padding: 1.1rem 1.15rem;
      border-radius: 16px;
    }
    .feature-card h4 {
      margin: 0 0 0.4rem;
      font-size: 0.95rem;
    }
    .feature-card p {
      margin: 0;
      font-size: 0.84rem;
      line-height: 1.5;
      color: var(--color-text-muted);
    }
    @media (max-width: 900px) {
      .features-tier-grid,
      .features-detail-grid { grid-template-columns: 1fr; }
    }

    /* Mobile reading */
    @media (max-width: 640px) {
      #workspace-card,
      #reader-screen,
      #importer-card {
        padding: 0.85rem !important;
        border-radius: 14px;
      }
      .reader-header-actions {
        width: 100%;
      }
      .reader-header-actions .btn {
        flex: 1 1 auto;
        min-height: 40px;
      }
      .mode-switcher {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }
      .mode-btn {
        flex: 1 1 auto;
        min-height: 40px;
        font-size: 0.8rem;
        padding: 0.4rem 0.55rem;
      }
      .playback-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }
      .playback-controls .control-btn {
        min-height: 44px;
        flex: 1 1 30%;
      }
      .playback-controls .play-btn {
        flex: 1 1 100%;
      }
      .tuner-grid {
        grid-template-columns: 1fr !important;
      }
      #standard-text-view.standard-reader-view:not(#reader-screen[data-reader-mode="focus"] #standard-text-view) {
        max-height: min(52vh, 420px);
      }
      .rsvp-word-container {
        min-height: 120px;
        padding-inline: 0.25rem;
      }
      .workspace-item {
        flex-direction: column;
      }
      .workspace-item-actions {
        width: 100%;
      }
      .workspace-item-actions .btn {
        flex: 1;
        min-height: 40px;
      }
      .url-input-container {
        flex-direction: column;
        align-items: stretch;
      }
      .url-input-container input,
      .url-input-container button {
        width: 100%;
        min-height: 44px;
      }
      #retention-modal .retention-card {
        padding: 1rem;
        max-height: 90vh;
      }
      .reader-tools-row {
        flex-direction: column;
        align-items: stretch;
      }
      .chapter-map-wrap select {
        min-height: 44px;
      }
    }

    @media (max-width: 420px) {
      .hero-import-option strong { font-size: 0.9rem; }
      .price-value { font-size: 2rem; }
    }
    .price-row {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .price-strike {
      text-decoration: line-through;
      color: var(--color-text-subtle);
      font-size: 1.25rem;
    }
    .price-value {
      font-size: 2.25rem;
      font-family: var(--font-sans);
      font-weight: 700;
      color: var(--color-text);
      line-height: 1;
      letter-spacing: -0.02em;
    }
    .price-term {
      color: var(--color-text-subtle);
      font-size: 0.9rem;
      font-weight: 500;
    }
    .pricing-guarantee {
      margin: 0;
      padding: 0.7rem 0.9rem;
      border: 1px solid var(--color-success-muted);
      border-radius: var(--radius-md);
      background: var(--color-success-muted);
      color: var(--color-text);
      font-size: 0.85rem;
      text-align: center;
      text-wrap: balance;
    }
    .pricing-guarantee strong { color: var(--color-success); }
    .pricing-features {
      list-style-type: none;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .pricing-features li::before {
      content: '✓ ';
      color: var(--color-primary);
      font-weight: bold;
    }
    
    /* SEO Content Layout */
    .seo-layout {
      max-width: 800px;
      margin: 0 auto;
      border-top: 1px solid var(--color-border);
      padding-top: 3.5rem;
    }
    .seo-text h2, .faq-container h2 {
      margin-top: 2rem;
      font-size: 1.5rem;
    }
    .seo-text p {
      margin-bottom: 1.25rem;
      color: var(--color-text-muted);
    }
    .faq-item {
      border-bottom: 1px solid var(--color-border);
      padding: 1.25rem 0;
    }
    .faq-item summary {
      font-family: var(--font-display);
      font-weight: 700;
      cursor: pointer;
      outline: none;
      font-size: 1.1rem;
    }
    .faq-answer {
      padding-top: 0.75rem;
      color: var(--color-text-muted);
      line-height: 1.7;
    }
    
    /* Modal styles */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(10, 10, 12, 0.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: var(--z-modal, 100);
      padding: 1rem;
    }
    .modal-content {
      background-color: var(--color-bg-card);
      border: 1px solid var(--color-border);
      padding: 2.5rem;
      border-radius: var(--radius-lg);
      max-width: 600px;
      width: 100%;
      text-align: center;
      box-shadow: var(--shadow-lg);
      /* On short viewports the card can be taller than the screen; scroll
         it instead of letting flex-centering clip both ends with no way
         to reach the rest. */
      max-height: calc(100dvh - 2rem);
      overflow-y: auto;
    }
    .share-modal-content {
      position: relative;
      max-width: 440px;
      padding: 1.75rem 1.5rem 1.5rem;
      text-align: left;
      border-radius: 18px;
      background:
        radial-gradient(ellipse 70% 40% at 100% 0%, var(--color-primary-muted), transparent 50%),
        var(--color-bg-card);
    }
    .share-modal-close {
      position: absolute;
      top: 0.85rem;
      right: 0.85rem;
      width: 2.25rem;
      height: 2.25rem;
