    .hero-import-rail {
      margin-top: 0;
      padding: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-bg-card);
      box-shadow: none;
      overflow: hidden;
    }
    .hero-import-heading {
