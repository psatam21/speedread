    .hero-import-option strong,
    .hero-import-option > span:last-child,
    .hero-import-option .import-idx { display: block; }
    .import-icon {
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 2.6rem;
      margin-bottom: 0.85rem;
      border-radius: 12px;
      background: var(--color-primary-muted);
      color: var(--color-primary);
      border: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
      animation: import-icon-float 3.2s ease-in-out infinite;
    }
    .import-icon svg {
      width: 1.25rem;
      height: 1.25rem;
      display: block;
    }
    .hero-import-option:nth-child(2) .import-icon { animation-delay: 0.35s; }
    .hero-import-option:nth-child(3) .import-icon { animation-delay: 0.7s; }
    .hero-import-option:nth-child(4) .import-icon { animation-delay: 1.05s; }
    .hero-import-option:hover .import-icon {
      background: rgba(255, 255, 255, 0.18);
      color: #fff;
      border-color: rgba(255, 255, 255, 0.22);
      animation: import-icon-pop 480ms var(--ease-out);
      transform: scale(1.08) rotate(-4deg);
