    .method-row small { margin-top: 0.2rem; color: var(--color-text-muted); line-height: 1.45; overflow-wrap: break-word; word-break: normal; }
    .method-index { color: var(--color-text-subtle); font-size: 0.75rem; font-variant-numeric: tabular-nums; }
