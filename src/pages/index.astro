---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';

const pageTitle = "Speed Reader with Audio Sync — RSVP + TTS | BriskRead";
const pageDescription = "Free dual-channel speed reader: RSVP flash reading locked to speech, plus Focus, Bionic, PDF/EPUB import, and OCR. Eyes and ears on the same stream — no account required.";
const siteUrl = new URL('/', Astro.site || Astro.url).href;
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'BriskRead',
  url: siteUrl,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '9',
    priceCurrency: 'USD',
    offerCount: '2',
  },
  description: 'Dual-channel speed reader with RSVP flash, synced text-to-speech, bionic reading, and local PDF/EPUB import.',
};

/** Hero ticker — only labels a new visitor can grasp mid-scroll */
const marqueeFeatures = [
  'Audio Sync',
  'Speed reading',
  'PDF & EPUB',
  'Chrome extension',
  'Read later',
  'Private & local',
  'Resume anywhere',
  'Reading queue',
  'Six reading modes',
  'Works offline',
];
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Top App Section: Interactive Reader Workspace -->
  <section class="app-section motion-stage">
    <div class="aurora" aria-hidden="true">
      <span class="aurora-blob a"></span>
      <span class="aurora-blob b"></span>
      <span class="aurora-blob c"></span>
    </div>
    <div class="container app-workspace">

      <!-- Hero: polished two-column (no long-scroll theater) -->
      <header class="hero">
        <div class="hero-copy">
          <p class="hero-kicker"><span class="hero-kicker-dot" aria-hidden="true"></span> Read faster without re-reading</p>
          <h1 class="hero-title">
            <span class="hero-line"><span class="hero-line-inner">See it. Hear it.</span></span>
            <span class="hero-line"><span class="hero-line-inner"> Finish it.</span></span>
          </h1>
          <p class="hero-sub">
            BriskRead plays your document one word at a time, right where your eyes already are — no scanning back and forth. That's <strong>RSVP</strong>, and BriskRead reads it aloud in sync as it flashes.
          </p>
          <ul class="hero-pitch" aria-label="How it works">
            <li>
              <span class="hero-pitch-tag">Step 1</span>
              <span>Drop in a PDF, EPUB, link, or pasted text — parsed in your browser.</span>
            </li>
            <li>
              <span class="hero-pitch-tag">Step 2</span>
              <span>Pick a pace. Words flash while the voice reads the same word.</span>
            </li>
            <li>
              <span class="hero-pitch-tag">Step 3</span>
              <span>Dense passage? Switch to Focus, Bionic, or full page mid-document.</span>
            </li>
          </ul>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#importer-card">Start with your text</a>
            <button class="btn btn-secondary" id="btn-hero-demo" type="button">Hear a sample</button>
          </div>
          <p class="hero-start-note">Free to try · No account required · Turn on <strong>Audio Sync</strong> in the reader to pair speech with Flash mode</p>
          <ul class="hero-trust" aria-label="Product benefits">
            <li><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg><span><strong>Audio Sync TTS</strong><small>Eyes + ears on the<br />same word stream.</small></span></li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-9 12h7l-1 8 10-13h-7l0-7Z" /></svg><span><strong>Up to 3× pace</strong><small>Clear the pile faster<br />without a second pass.</small></span></li>
            <li><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z"/><path d="M9 12l2 2 4-4"/></svg><span><strong>Private by default</strong><small>Files stay local.<br />You own the text.</small></span></li>
          </ul>
        </div>
        <div class="hero-stage">
          <div class="hero-reader-shell">
            <div class="hero-reader" aria-label="Animated RSVP reading preview">
              <div class="hero-reader-top">
                <div class="hero-reader-identity"><span aria-hidden="true"><i></i><i></i><i></i></span><strong>briskread_engine</strong></div>
                <div class="hero-reader-tools"><span>LOCAL / ACTIVE</span><button id="hero-play" type="button" aria-pressed="false" aria-label="Pause RSVP preview">Ⅱ</button></div>
              </div>
              <div class="hero-preview-stage">
                <div class="hero-slide is-active" data-hero-slide="rsvp">
                  <span class="hero-focus-line" aria-hidden="true"></span>
                  <span class="hero-reticle hero-reticle-top" aria-hidden="true"></span>
                  <span class="hero-reticle hero-reticle-bottom" aria-hidden="true"></span>
                  <p class="hero-slide-label"><i></i>Flash · optimal recognition point</p>
                  <div class="hero-word" aria-live="off"><span id="hero-word-left">cre</span><strong id="hero-word-orp">a</strong><span id="hero-word-right">te</span></div>
                </div>
                <div class="hero-slide" data-hero-slide="focus">
                  <p class="hero-slide-label"><i></i>Focus · fixed centre line</p>
                  <div class="hero-focus-demo" id="hero-focus-demo" aria-live="off">
                    <div class="hero-focus-eye" aria-hidden="true"></div>
                    <div class="hero-focus-track" id="hero-focus-track"></div>
                  </div>
                </div>
              </div>
              <div class="hero-deck-tabs" role="tablist" aria-label="Preview reading mode">
                <button type="button" class="is-active" data-hero-dot="rsvp" role="tab" aria-selected="true">Flash</button>
                <button type="button" data-hero-dot="focus" role="tab" aria-selected="false">Focus</button>
              </div>
              <div class="hero-demo-controls">
                <div class="hero-speed-control"><span>Velocity / WPM<strong id="hero-wpm-output">350</strong></span><div><input id="hero-wpm-slider" aria-label="Words per minute" type="range" min="100" max="600" step="10" value="350" /><div class="hero-wpm-ticks"><span>100</span><span>200</span><span>300</span><span>400</span><span>500</span><span>600</span></div></div></div>
              </div>
              <div class="hero-reader-bottom"><strong>How you compare</strong><div><span>Typical reading<b>~240 <small>WPM</small></b></span><i>→</i><span class="hero-rsvp-pace">RSVP with BriskRead<b><span id="hero-compare-wpm">350</span> <small>WPM</small></b></span></div><p>Based on average adult silent reading speed of 200–280 WPM.</p></div>
              <div class="hero-gain-stats" aria-live="polite">
                <span><strong id="hero-pace-gain">+46%</strong> faster pace</span>
                <span><strong id="hero-time-saved">7 min</strong> saved per 5,000 words</span>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="motion-marquee" aria-hidden="true">
        <div class="marquee-track">
          <div class="marquee-group">
            {marqueeFeatures.map((label) => (
              <span><i class="marquee-dot"></i>{label}</span>
            ))}
          </div>
          <div class="marquee-group">
            {marqueeFeatures.map((label) => (
              <span><i class="marquee-dot"></i>{label}</span>
            ))}
          </div>
        </div>
      </div>

      <section class="hero-import-rail" aria-labelledby="hero-import-title" data-motion="rise">
        <div class="hero-import-heading"><div><h2 id="hero-import-title">Bring in text</h2><p>Choose a source, then start reading in seconds.</p></div></div>
        <div class="hero-import-options" data-stagger>
          <button class="hero-import-option" type="button" data-open-tab="paste">
            <span class="import-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
            </span>
            <span class="import-idx">01</span><strong>Paste text</strong><span>Type or paste anything</span>
          </button>
          <button class="hero-import-option" type="button" data-open-tab="upload">
            <span class="import-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/></svg>
            </span>
            <span class="import-idx">02</span><strong>Upload a file</strong><span>PDF, EPUB, or TXT</span>
          </button>
          <button class="hero-import-option" type="button" data-open-tab="ocr">
            <span class="import-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V6a2 2 0 0 1 2-2h2"/><path d="M4 16v2a2 2 0 0 0 2 2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v2"/><path d="M16 20h2a2 2 0 0 0 2-2v-2"/><circle cx="12" cy="12" r="3"/><path d="M12 9v0"/></svg>
            </span>
            <span class="import-idx">03</span><strong>Scan an image</strong><span>On-device OCR</span>
          </button>
          <button class="hero-import-option" type="button" data-open-tab="url">
            <span class="import-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </span>
            <span class="import-idx">04</span><strong>Extract a web link</strong><span>Pull in an article</span>
          </button>
        </div>
      </section>

      <!-- ---------------- WORKSPACE: library / queue (simple) · advanced tucked away ---------------- -->
      <section class="workspace-shell mb-6" id="workspace-card" aria-labelledby="workspace-title">
        <div class="workspace-intro">
          <div>
            <p class="section-label">Continue later</p>
            <h2 id="workspace-title">Your library &amp; queue</h2>
            <p class="workspace-lede">Documents you open can save here. Resume when you’re ready — sign in to sync across devices.</p>
          </div>
          <div class="workspace-status-pills">
            <span class="workspace-pill" id="queue-summary" role="status">Queue empty</span>
            <span class="workspace-pill workspace-pill-muted" id="workspace-sync-status" role="status"></span>
          </div>
        </div>

        <div class="workspace-grid">
          <article class="workspace-panel glass">
            <div class="workspace-panel-head">
              <div>
                <h3>Saved</h3>
                <p class="workspace-panel-sub" id="library-cap-hint"></p>
              </div>
            </div>
            <ul class="workspace-list" id="library-list" aria-label="Saved documents"></ul>
            <div class="workspace-empty" id="library-empty">
              <strong>Nothing saved yet</strong>
              <p>Load text below — turn on “Save to library” if you want it here for later.</p>
            </div>
          </article>
          <article class="workspace-panel glass">
            <div class="workspace-panel-head">
              <div>
                <h3>Up next</h3>
                <p class="workspace-panel-sub">This week’s reading list</p>
              </div>
              <div class="workspace-panel-actions">
                <button type="button" class="btn btn-ghost btn-sm" id="btn-export-queue" title="Export queue as Markdown">Export</button>
                <button type="button" class="btn btn-ghost btn-sm" id="btn-clear-done-queue">Clear done</button>
              </div>
            </div>
            <ul class="workspace-list" id="queue-list" aria-label="Reading queue"></ul>
            <div class="workspace-empty" id="queue-empty">
              <strong>Queue is empty</strong>
              <p>Optional: add docs with “Add to queue” when you import, or from Saved.</p>
            </div>
          </article>
        </div>

        <details class="workspace-advanced glass">
          <summary>
            <span>Optional settings</span>
            <small>Profiles &amp; check-ins — skip if you’re just trying the reader</small>
          </summary>
          <div class="workspace-advanced-body">
            <div class="workspace-adv-block" role="group" aria-label="Reading profiles">
              <div class="workspace-adv-copy">
                <h4>Quick presets</h4>
                <p id="profile-hint">Save your current speed and mode under a name. Totally optional.</p>
              </div>
              <div class="profile-pills" id="profile-pills"></div>
              <button type="button" class="btn btn-secondary btn-sm" id="btn-save-profile" title="Save current mode, speed, and font into the selected profile">Save current settings</button>
            </div>
            <div class="workspace-adv-block" role="group" aria-label="Check-in settings">
              <div class="workspace-adv-copy">
                <h4>Comprehension check-ins</h4>
                <p>Short multiple-choice questions from the text you just read.</p>
              </div>
              <div class="retention-segment" role="radiogroup" aria-label="Check-in mode">
                <label class="retention-seg">
                  <input type="radio" name="retention-mode" value="auto" id="retention-mode-auto" />
                  <span>Auto · every 1,000 words</span>
                </label>
                <label class="retention-seg">
                  <input type="radio" name="retention-mode" value="manual" id="retention-mode-manual" />
                  <span>Manual only</span>
                </label>
              </div>
            </div>
          </div>
        </details>
      </section>

      <!-- ---------------- READER SCREEN ---------------- -->
      <div id="reader-screen" class="glass app-card hidden mb-6">
        <div class="reader-header">
          <div class="reader-header-main">
            <h3 id="reader-doc-title">Reader</h3>
            <p class="reader-meta muted" id="reader-meta"></p>
          </div>
          <div class="reader-header-actions">
            <button class="btn btn-secondary btn-sm" id="btn-save-library" type="button" title="Save to library">Save</button>
            <button class="btn btn-secondary btn-sm" id="btn-add-queue" type="button" title="Add to this week’s queue">Queue</button>
            <button class="btn btn-secondary btn-sm" id="btn-export-md" type="button" title="Export notes as Markdown">Export</button>
            <button class="btn btn-secondary btn-sm" id="btn-close-reader">✕ Close</button>
          </div>
        </div>

        <div class="reader-tools-row">
          <div class="chapter-map-wrap">
            <label for="chapter-select">Jump to section</label>
            <select id="chapter-select" aria-label="Chapter or section map">
              <option value="0">Beginning</option>
            </select>
          </div>
          <div class="reader-tool-btns">
            <button type="button" class="btn btn-secondary btn-sm" id="btn-highlight-word" title="Highlight current word or phrase">Highlight</button>
            <button type="button" class="btn btn-secondary btn-sm" id="btn-retention-check" title="Comprehension check-in">Check-in</button>
          </div>
        </div>

        <!-- Reading Mode Switcher -->
        <div class="mode-switcher mt-4">
          <button class="mode-btn active" data-mode="rsvp" title="One word at a fixed focal point">Flash</button>
          <button class="mode-btn" data-mode="focus" title="Full text with a moving focus highlight">Focus</button>
          <button class="mode-btn" data-mode="phrase" title="Three words at a time for more context">Phrase</button>
          <button class="mode-btn" data-mode="flow" title="Fixed focal point with paragraph context">Flow</button>
          <button class="mode-btn" data-mode="bionic">Bionic</button>
          <button class="mode-btn" data-mode="standard">Page</button>
        </div>
        <p class="mode-description" id="mode-description">One word at a fixed focal point for maximum speed.</p>

        <!-- Interactive Workspace -->
        <div class="reader-display-container">
          
          <!-- RSVP (Visual Flash) Pane -->
          <div id="rsvp-pane" class="reader-pane active">
            <div class="rsvp-word-container">
              <div class="rsvp-focus-line"></div>
              <div class="rsvp-horizontal-ticks">
                <div class="rsvp-tick"></div>
                <div class="rsvp-tick"></div>
              </div>
              <div class="word-wrapper">
                <span class="word-left" id="word-left">Ready</span>
                <span class="word-orp" id="word-orp">.</span>
                <span class="word-right" id="word-right"></span>
              </div>
            </div>
            <input class="reader-progress-scrubber" id="rsvp-progress" data-reader-scrubber type="range" min="0" max="100" value="0" aria-label="Reading position" />
          </div>

          <div id="flow-pane" class="reader-pane hidden">
            <div class="flow-reader-view">
              <p class="flow-context-line" id="flow-previous-line"></p>
              <div class="flow-anchor-stage">
                <span class="flow-focus-line" aria-hidden="true"></span>
                <div class="flow-anchor-line">
                  <span class="flow-left"><span id="flow-left-context"></span> <strong id="flow-word-left"></strong></span>
                  <b id="flow-word-orp"></b>
                  <span class="flow-right"><strong id="flow-word-right"></strong> <span id="flow-right-context"></span></span>
                </div>
              </div>
              <p class="flow-context-line" id="flow-next-line"></p>
            </div>
            <input class="reader-progress-scrubber" id="flow-progress" data-reader-scrubber type="range" min="0" max="100" value="0" aria-label="Reading position" />
          </div>

          <!-- Bionic Reader Pane -->
          <div id="bionic-pane" class="reader-pane hidden">
            <div class="standard-reader-view reader-text-surface" id="bionic-text-view">
              <!-- Highlighted bionic text gets loaded here -->
            </div>
          </div>

          <!-- Focus + Page Mode Pane -->
          <div id="standard-pane" class="reader-pane hidden">
            <div class="standard-reader-view reader-text-surface" id="standard-text-view">
              <!-- Focus: .focus-track + eye line. Page: sentences with click-to-jump -->
            </div>
          </div>

        </div>

        <!-- Controls HUD -->
        <div class="controls-hud mt-4">
          
          <!-- Playback controls -->
          <div class="playback-controls">
            <button class="control-btn" id="btn-rsvp-restart" title="Restart from the beginning">Restart</button>
            <button class="control-btn" id="btn-rsvp-prev" title="Rewind 10 words (ArrowLeft)">−10</button>
            <button class="control-btn play-btn" id="btn-rsvp-play" title="Play/Pause (Space)">▶ Play</button>
            <button class="control-btn" id="btn-rsvp-next" title="Forward 10 words (ArrowRight)">+10</button>
            <button class="control-btn" id="btn-rsvp-end" title="Jump to the final word">End</button>
            <button class="control-btn" id="btn-rsvp-tts" title="Toggle Text-to-Speech Audio">Audio Sync: Off</button>
            <button class="control-btn" id="btn-fullscreen" title="Toggle distraction-free fullscreen">Fullscreen</button>
          </div>

          <!-- Setting Tuners -->
          <div class="tuner-grid">
            <div class="tuner-card">
              <label for="slider-wpm">Reading Speed: <span id="wpm-display">350</span> WPM</label>
              <input type="range" id="slider-wpm" min="100" max="1000" step="25" value="350" />
            </div>
            
            <div class="tuner-card">
              <label>Theme Preset</label>
              <div class="theme-picker">
                <button class="theme-badge light" data-theme="light" title="Light theme">A</button>
                <button class="theme-badge sepia" data-theme="sepia" title="Sepia eye-comfort">A</button>
                <button class="theme-badge dark" data-theme="dark" title="Dark theme">A</button>
                <button class="theme-badge amoled" data-theme="amoled" title="AMOLED Black">A</button>
              </div>
            </div>

            <div class="tuner-card">
              <label for="select-font">Font Family</label>
              <select id="select-font">
                <option value="sans">Sans-Serif (Inter)</option>
                <option value="serif">Serif (Merriweather)</option>
                <option value="dyslexic">Dyslexic Aid (OpenDyslexic)</option>
              </select>
            </div>

            <div class="tuner-card">
              <label for="slider-font-size">Font Size: <span id="font-size-display">24</span>px</label>
              <input type="range" id="slider-font-size" min="16" max="48" step="2" value="24" />
            </div>

            <div class="tuner-card">
              <label for="select-voice">Audio Sync Voice</label>
              <select id="select-voice">
                <option value="">Default System Voice</option>
              </select>
              <span class="tuner-hint">Uses voices installed on your device. Add more in your system speech settings.</span>
            </div>

            <div class="tuner-card">
              <label for="slider-pitch">Voice Pitch: <span id="pitch-display">1.0</span></label>
              <input type="range" id="slider-pitch" min="0.5" max="2.0" step="0.1" value="1.0" />
            </div>
          </div>

          <!-- Position/Timeline slider -->
          <div class="timeline-row">
            <input type="range" id="slider-progress" data-reader-scrubber min="0" max="100" value="0" aria-label="Reading position" />
            <div class="timeline-labels">
              <span id="reading-time-left">0 min remaining</span>
              <span id="reading-percentage">Word 0 / 0 (0%)</span>
            </div>
          </div>

        </div>

        <!-- Retention check-in modal -->
        <div id="retention-modal" class="retention-modal hidden" role="dialog" aria-modal="true" aria-labelledby="retention-title" hidden>
          <div class="retention-card glass">
            <div class="retention-card-head">
              <h3 id="retention-title">Quick check-in</h3>
              <button type="button" class="btn btn-secondary btn-sm" id="btn-retention-skip">Skip</button>
            </div>
            <p class="muted" id="retention-sub">Lock in what you just read before continuing.</p>
            <div id="retention-body" class="retention-body"></div>
            <div class="retention-actions">
              <button type="button" class="btn btn-primary" id="btn-retention-save">Save &amp; continue</button>
            </div>
          </div>
        </div>

      </div>

      <!-- ---------------- IMPORTER CARD ---------------- -->
      <div class="glass app-card" id="importer-card">
        <div class="importer-heading">
          <div>
            <h2>Bring in text</h2>
            <p class="muted">Choose one source. AI works on the document you load here.</p>
          </div>
          <p class="document-status" id="document-status" role="status">No document loaded yet</p>
        </div>
        
        <div class="tabs" aria-label="Document sources">
          <button class="tab-btn active" data-tab="paste">Paste text</button>
          <button class="tab-btn" data-tab="upload">Upload file</button>
          <button class="tab-btn" data-tab="ocr">Image OCR</button>
          <button class="tab-btn" data-tab="url">Public URL</button>
        </div>

        <!-- Import Panels -->
        <div class="tab-contents">
          
          <!-- Paste Panel -->
          <div class="tab-content active" id="tab-paste">
            <textarea id="text-input" placeholder="Paste your article, book chapter, or text here to start speed reading..."></textarea>
            
            <!-- Find & Replace Accordion -->
            <details class="text-clean-details mt-2">
              <summary>Text cleaning tools (Find &amp; Replace)</summary>
              <div class="find-replace-grid mt-2">
                <input type="text" id="input-find" placeholder="Find text..." />
                <input type="text" id="input-replace" placeholder="Replace with..." />
                <button class="btn btn-secondary btn-sm" id="btn-run-replace">Replace All</button>
              </div>
            </details>

            <div class="import-dest-options mt-3" role="group" aria-label="Where to save this text">
              <label class="import-check"><input type="checkbox" id="opt-paste-library" checked /> Save to library</label>
