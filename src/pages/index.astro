      .hero-word { font-size: clamp(2.7rem, 13vw, 4rem); }
      .hero-speed-control { grid-template-columns: 5.5rem 1fr; gap: 0.65rem; }
      .hero-wpm-ticks span:nth-child(even) { display: none; }
      .hero-reader-bottom b { font-size: 1.35rem; }
      .hero-gain-stats span { padding: 0.75rem 1rem; }
      .hero-trust { grid-template-columns: 1fr; }
      .hero-trust { order: 3; margin: 2rem 0 0; }
      .hero-trust li { min-height: 3.75rem; padding: 0 0 1rem; border-right: 0; border-bottom: 1px solid var(--color-border); }
      .hero-import-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .outcomes-heading, .outcomes-grid { grid-template-columns: 1fr; }
      .outcomes-grid article + article { border-left: 0; border-top: 1px solid var(--color-border); }
      .testimonials-band::before, .testimonials-band::after { width: 1.5rem; }
      .launch-paths-heading { align-items: start; flex-direction: column; }
      .reading-methods-heading { grid-template-columns: 1fr; }
      .method-row { grid-template-columns: 2rem minmax(0, 1fr) 6.5rem; gap: 0.75rem; }
      .method-context { display: none; }
      .method-pace { justify-self: end; text-align: right; }
      .reading-fit { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-import-option, .method-row { transition: none; }
      .hero-import-option:hover, .method-row:hover { transform: none; }
