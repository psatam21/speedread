---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';

const pageTitle = "RSVP Reader Online: Free Speed Reading Tool | BriskRead";
const pageDescription = "Free RSVP reader online: flash one word at a time with an ORP highlight at 100-1000 WPM, plus optional synced voice. Paste text, PDF or EPUB. No signup.";
/** One source for the visible FAQ and its FAQPage schema. */
const faqs = [
  {
    q: 'What is an RSVP reader?',
    a: 'An RSVP reader flashes one word (or a short phrase) at a fixed screen position so you stop scanning horizontally. BriskRead is a free online RSVP reader with ORP letter highlight and optional Audio Sync TTS.',
  },
  {
    q: 'Is BriskRead’s RSVP reader free?',
    a: 'Yes. You can paste text or open PDFs in the browser without signup. Every feature is free, with no document length limits.',
  },
  {
    q: 'What speed should I start at?',
    a: 'Start near your normal reading pace, usually 250 to 350 WPM, then raise it in steps of about 50 once a passage feels easy. Take your baseline with the free reading speed test.',
  },
  {
    q: 'Does RSVP reading hurt comprehension?',
    a: 'It can at high speeds. RSVP removes the option to glance back, so dense or unfamiliar text suffers first. Use it for lighter material, and switch to Focus or Page mode when precision matters.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <section class="tool-seo mt-8">
    <div class="container max-w-3xl">
      <div class="glass content-card">
        <h1>RSVP Reader Online: Free Speed Reading Tool</h1>
        <div class="tldr">
          <strong>Quick answer:</strong> BriskRead is a free online RSVP speed reader. Words flash at a fixed point with ORP alignment; optional Audio Sync pairs browser TTS to the same stream. <a href="/#importer-card">Start reading</a> with no signup for core use.
        </div>
        <p class="lede">
          RSVP (Rapid Serial Visual Presentation) flashes one word at a time on a fixed point so you stop horizontal eye scanning. BriskRead adds Optimal Recognition Point (ORP) alignment, punctuation-aware pacing, and optional synced TTS.
        </p>
        <a href="/#importer-card" class="btn btn-primary mt-4">Start RSVP reading</a>

        <h2 class="mt-8">How RSVP speed reading works</h2>
        <p>
          Traditional reading forces saccades across each line. RSVP removes that motion: words appear in the same place, timed by your WPM setting. BriskRead highlights the ORP letter (usually near the start of the word) so recognition happens without hunting for the word center.
        </p>

        <h2 class="mt-8">How to use this RSVP reader</h2>
        <ol class="steps">
          <li>Paste text, upload PDF/EPUB/TXT, run image OCR, or extract a public URL.</li>
          <li>Click <strong>Start Reading</strong> (RSVP Mode is the default).</li>
          <li>Set WPM (100 to 1,000), press <kbd>Space</kbd> to play or pause, and use arrows to jump.</li>
          <li>Enable <strong>Audio Sync</strong> for dual-channel narration via your browser’s Web Speech API.</li>
        </ol>

        <h2 class="mt-8">Best use cases</h2>
        <ul>
          <li>Skimming long blog posts and news before a meeting</li>
          <li>Revising textbook chapters with TTS reinforcement</li>
          <li>Training higher WPM with demo text, then real documents</li>
          <li>Mobile reading with AMOLED theme and fullscreen focus</li>
        </ul>

        <h2 class="mt-8">Keyboard shortcuts</h2>
        <ul>
          <li><kbd>Space</kbd>: Play / Pause</li>
          <li><kbd>↑</kbd> / <kbd>↓</kbd>: Adjust WPM</li>
          <li><kbd>←</kbd> / <kbd>→</kbd>: Skip words</li>
          <li><kbd>D</kbd>: Cycle themes · <kbd>Esc</kbd>: Close reader</li>
        </ul>

        <h2 class="mt-8">RSVP reader FAQ</h2>
        {faqs.map(({ q, a }) => (
          <>
            <h3 class="faq-q">{q}</h3>
            <p>{a}</p>
          </>
        ))}

        <div class="related mt-8">
          <h2>Related free tools</h2>
          <p>
            <a href="/">Online speed reader</a> ·
            <a href="/reading-speed-test">Reading speed test</a> ·
            <a href="/bionic-reading">Bionic reading</a> ·
            <a href="/pdf-to-speech">PDF to speech</a> ·
            <a href="/words-to-minutes">Words to minutes</a> ·
            <a href="/teleprompter">Online teleprompter</a> ·
            <a href="/readability-checker">Readability checker</a> ·
            <a href="/extension">Chrome extension</a>
          </p>
          <p>
            Guides: <a href="/blog/rsvp-reading-explained">What is RSVP reading?</a> ·
            <a href="/blog/how-to-speed-read-online">How to speed read online</a> ·
            <a href="/blog/audio-sync-speed-reading">Speed reading with audio</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="ads-section mt-8">
    <div class="container max-w-3xl">
      <AdSlot placement="MID" format="auto" />
    </div>
  </section>
</Layout>

<style>
  .max-w-3xl { max-width: 800px; margin: 0 auto; }
  .content-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }
  .lede { font-size: 1.1rem; color: var(--color-text-muted); }
  .tldr {
    margin: 0.75rem 0 1rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  h1 { font-size: clamp(2rem, 5vw, 3.75rem); line-height: 1.05; letter-spacing: -0.035em; }
  h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .faq-q { font-size: 1rem; margin: 1rem 0 0.35rem; }
  .steps, ul { margin-left: 1.25rem; color: var(--color-text-muted); display: flex; flex-direction: column; gap: 0.5rem; }
  p { color: var(--color-text-muted); margin-bottom: 0.75rem; line-height: 1.7; }
  kbd {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.4rem;
    font-size: 0.85rem;
  }
  .mt-4 { margin-top: 1rem; }
  .mt-8 { margin-top: 2rem; }
  .related { border-top: 1px solid var(--color-border); padding-top: 1.5rem; }
  .btn { text-decoration: none; }
</style>
