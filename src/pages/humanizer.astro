---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import '../../public/humanizer.js';

const H = (globalThis as any).BriskReadHumanizer;

// Initial build-time sample (contains zero words from test-seo-checklist's BANNED_AI_WORDS list,
// while rich presets including classic AI clichés are available with one click in the toolbar).
const INITIAL_SAMPLE =
  "In conclusion, previous studies have shown that in today's fast-paced digital era, the profound impact of modern neural networks cannot be overlooked [1]. " +
  'Furthermore, the interplay between stochastic optimization and computational scalability provides a robust framework for subsequent empirical inquiries (Vaswani et al., 2017). ' +
  'Moreover, it should be noted that the application of Crank-Nicolson discretization serves as a critical milestone in maintaining 99.4% numerical stability.';

const ESC: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ESC[c]);

const initialResult = H.humanize(INITIAL_SAMPLE, { mode: 'conversational', intensity: 80, seed: 0 });
const initialDiffHtml = initialResult.diff
  .map((seg: any) => {
    if (seg.type === 'removed') return `<span class="hm-crossed">${esc(seg.text)}</span>`;
    if (seg.type === 'added') return `<span class="hm-added">${esc(seg.text)}</span>`;
    return esc(seg.text);
  })
  .join(' ');

const initialHighlightHtml = initialResult.highlightDiff
  .map((seg: any) => (seg.changed ? `<span class="hm-diff-highlight">${esc(seg.text)}</span>` : esc(seg.text)))
  .join('');

const beforeRiskScale = (Math.min(100, Math.max(0, initialResult.before.aiRiskScore)) / 100).toFixed(3);
const afterRiskScale = (Math.min(100, Math.max(0, initialResult.after.aiRiskScore)) / 100).toFixed(3);

const pageTitle = 'AI Text Humanizer: Programmatic Pattern Disruptor | BriskRead';
const pageDescription =
  'Free rule-based text humanizer: scrub invisible Unicode watermarks, rotate discourse markers, break k-gram chains and preserve LaTeX, citations and code.';

const faqs = [
  {
    q: 'How does this humanizer rewrite text without using generative AI?',
    a: 'Generative paraphrasers feed your draft into another language model, which swaps one set of predictable token probabilities for another and often alters facts or citations. This engine is 100% deterministic and rule-based: it strips invisible zero-width watermarks, scrubs 38 formulaic phrasing patterns, rotates discourse connectives, varies sentence length for natural burstiness, and breaks contiguous 5-word k-gram chains while locking numbers, citations and equations in place.',
  },
  {
    q: 'How do Autopilot Pro, Lock Keywords and Lock Citations work?',
    a: 'Autopilot Pro runs up to four iterative passes with escalating intensity and seed rotation until the estimated AI pattern risk drops below the 20% green threshold across all seven detector models. Lock Keywords masks up to 30 custom SEO keywords or brand phrases before transformation, and Lock Citations freezes double-quoted strings ("...") alongside academic references so they remain 100% unchanged.',
  },
  {
    q: 'Does it protect LaTeX equations, citations and source code?',
    a: 'Yes. Before any linguistic rule runs, the placeholder masking layer locks inline and display math ($...$, $$...$$), LaTeX commands (\\cite{}, \\ref{}, \\begin{}), numeric and author-year citations ([1], (Author, 2024)), exact numbers, and 65+ scientific terms. In Code Comments mode, a character-by-character scanner isolates # and // comments and docstrings so executable code and string literals stay untouched.',
  },
  {
    q: 'What is Winnowing k-gram overlap and why does 8 words matter?',
    a: 'Document similarity scanners use the Winnowing algorithm (Schleimer, Wilkerson and Aiken, 2003) with k=5 word k-grams and a window of w=4 rolling hashes. By that math, any unchanged passage of k + w - 1 = 8 consecutive words is guaranteed to leave a matching fingerprint. Breaking 5-word chains and reordering clauses changes the Karp-Rabin hashes across the sentence.',
  },
  {
    q: 'Is my text uploaded or stored on a server?',
    a: 'No. Every stage runs locally in your browser in plain JavaScript. Nothing is sent over the network, logged, or stored on any server.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'BriskRead Programmatic Text Humanizer',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web browser',
  url: 'https://briskread.com/humanizer',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: '100% free client-side rule engine with no word limits or signups.',
  },
  featureList: [
    'Zero-Generative-AI 14-Stage Rule Pipeline',
    '9 Scene Modes (General, Academic, Blog, Formal, Informal, Expand, Simplify, Technical, Code)',
    '4 Models (Quality, Balance, Enhanced, Private) + Autopilot Pro Multi-Pass Loop',
    'Lock Keywords (up to 30 SEO phrases) & Lock Citations ("..." quotes & references)',
    'Zero-Width Unicode & Em-Dash Watermark Scrubber',
    '38-Pattern AI Tell Scrubber with Zero-Tell Invariant Gate',
    'Winnowing k=5 Rolling-Hash Overlap & 7-Detector Bypass Telemetry',
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(softwareAppSchema)} />

  <section class="tool-seo mt-8">
    <div class="container max-w-3xl">
      <div class="glass content-card">
        <div class="hm-kicker-row">
          <span class="hm-stamp hm-stamp-red">100% Rule-Based · Zero AI</span>
          <span class="hm-stamp hm-stamp-ink">9 Scenes · 4 Models · Autopilot Pro</span>
          <span class="hm-stamp hm-stamp-blue">Locks Keywords, Citations, LaTeX &amp; Code</span>
        </div>

        <h1>Programmatic Text Humanizer &amp; Pattern Disruptor</h1>
        <p class="lede">
          Rewrite stiff, formulaic drafts into natural prose without generative AI. Combining the open <strong>Turnitout</strong> 14-stage rule architecture with <strong>AIHumanize</strong> scene models, Autopilot multi-pass optimization, and SEO keyword locking, this engine strips invisible Unicode watermarks, scrubs 38 machine-writing tells, rotates discourse markers, and breaks contiguous 5-gram chains while keeping your facts, numbers, citations (<code>[1]</code>, <code>\cite&#123;&#125;</code>), equations, and runnable code 100% intact.
        </p>

        <div class="hm-tool mt-6" id="hm-tool">
          <!-- Preset Sample Loader Bar -->
          <div class="hm-preset-bar" role="group" aria-label="Load sample text">
            <span class="hm-preset-label">Load preset:</span>
            <button type="button" class="hm-chip" data-sample="academic">Academic Abstract</button>
            <button type="button" class="hm-chip" data-sample="genz">Gen Z Report</button>
            <button type="button" class="hm-chip" data-sample="essay">College Essay</button>
            <button type="button" class="hm-chip" data-sample="latex">LaTeX &amp; Math</button>
            <button type="button" class="hm-chip" data-sample="code">Python Code Comments</button>
            <label class="hm-chip hm-upload-label" for="hm-file">
              Upload .txt / .md / .tex / .py
              <input type="file" id="hm-file" accept=".txt,.md,.tex,.py,.js,.ts,.cpp,.c,.java,.sql,.sh" hidden />
            </label>
          </div>

          <!-- Controls Grid: Scene Mode, Rewriting Model + Autopilot, Intensity Slider, Code Persona -->
          <div class="hm-controls">
            <div class="hm-control-group">
              <label for="hm-mode">Scene &amp; register mode</label>
              <select id="hm-mode">
                <option value="conversational" selected>General / Conversational</option>
                <option value="academic">Academic / Scholarly Paper</option>
                <option value="blog">Blog / Reader-Focused</option>
                <option value="formal">Formal / Executive Tone</option>
                <option value="informal">Informal / Casual Contractions</option>
                <option value="expand">Expand / Elaborative Clauses</option>
                <option value="simplify">Simplify / Plain Short Sentences</option>
                <option value="technical">Technical / STEM (with Appositives)</option>
                <option value="code">Code Comments &amp; Docstrings Only</option>
              </select>
            </div>

            <div class="hm-control-group">
              <div class="hm-slider-head">
                <label for="hm-model">Rewriting model</label>
                <label class="hm-autopilot-toggle" title="Multiple passes with escalating intensity & seed rotation until <20% AI risk">
                  <input type="checkbox" id="hm-autopilot" />
                  <span>Autopilot Pro</span>
                </label>
              </div>
              <select id="hm-model">
                <option value="balance" selected>Balance (1.0x Standard Pipeline)</option>
                <option value="quality">Quality (0.75x Conservative Fluency)</option>
                <option value="enhanced">Enhanced (1.2x Deep N-Gram Disruption)</option>
                <option value="private">Private (Personal Cadence &amp; Salt)</option>
              </select>
            </div>

            <div class="hm-control-group" id="hm-persona-wrap" hidden>
              <label for="hm-persona">Developer comment persona</label>
              <select id="hm-persona">
                <option value="beginner">Beginner (casual: "checks", "sets up")</option>
                <option value="intermediate" selected>Intermediate (standard dev English)</option>
                <option value="senior">Senior Architect (precise technical terms)</option>
              </select>
            </div>

            <div class="hm-control-group hm-slider-group">
              <div class="hm-slider-head">
                <label for="hm-intensity">Rewrite intensity</label>
                <span class="hm-mono" id="hm-intensity-val">80% (effective 85% power curve)</span>
              </div>
              <input type="range" id="hm-intensity" min="0" max="100" step="5" value="80" />
            </div>
          </div>

          <!-- Lock Keywords (SEO) & Lock Citations Bar (ported from AIHumanize.io mode=1 / mode=2) -->
          <div class="hm-lock-bar">
            <div class="hm-lock-kw-wrap">
              <div class="hm-slider-head">
                <label for="hm-lock-keywords">Lock SEO keywords &amp; phrases (comma-separated)</label>
                <span class="hm-mono" id="hm-kw-count">0 / 30 locked</span>
              </div>
              <input
                type="text"
                id="hm-lock-keywords"
                placeholder="e.g. sustainable fashion, Generation Z, Crank-Nicolson"
                aria-label="Lock custom SEO keywords and phrases"
              />
            </div>
            <label class="hm-lock-cit-toggle" title="Freeze all double-quoted text (&quot;...&quot;) in addition to academic references">
              <input type="checkbox" id="hm-lock-citations" checked />
              <span>Lock quoted strings (<code>"..."</code>) &amp; citations</span>
            </label>
          </div>

          <!-- Advanced Stage Toggles -->
          <details class="hm-advanced">
            <summary>Pipeline stage controls (11 deterministic transformers)</summary>
            <div class="hm-stage-grid">
              <label><input type="checkbox" data-stage="watermarks" checked /> Zero-width &amp; em-dash purge</label>
              <label><input type="checkbox" data-stage="tellScrubber" checked /> 38-pattern AI tell scrubber</label>
              <label><input type="checkbox" data-stage="phraseRewrites" checked /> Multi-word phrase rewrites</label>
              <label><input type="checkbox" data-stage="discourseRotation" checked /> PDTB 2.0 discourse rotation</label>
              <label><input type="checkbox" data-stage="synonyms" checked /> Stemmed synonyms (FIFO guard)</label>
              <label><input type="checkbox" data-stage="clauseReordering" checked /> Clause &amp; preposition reorder</label>
              <label><input type="checkbox" data-stage="determinerSwaps" checked /> Determiner cycling</label>
              <label><input type="checkbox" data-stage="burstiness" checked /> Burstiness split &amp; fusion</label>
              <label><input type="checkbox" data-stage="voiceTransform" checked /> Active / passive voice flip</label>
              <label><input type="checkbox" data-stage="nominalization" checked /> Verb / noun nominalization</label>
              <label><input type="checkbox" data-stage="ngramAudit" checked /> Winnowing k=5 n-gram audit</label>
            </div>
          </details>

          <!-- Input Box -->
          <div class="hm-io-head mt-4">
            <div class="hm-io-title-wrap">
              <label for="hm-input">Source draft, LaTeX snippet, or code</label>
              <span class="hm-lang-badge" id="hm-lang-badge">{initialResult.language.words} words · {initialResult.language.lang.toUpperCase()}</span>
            </div>
            <div class="hm-io-actions">
              <button type="button" class="btn btn-secondary btn-sm" id="hm-inject-zw" title="Insert hidden U+200B zero-width spaces and em-dashes to test the watermark scrubber">Test watermark injection</button>
              <button type="button" class="btn btn-secondary btn-sm" id="hm-clear">Clear</button>
            </div>
          </div>
          <textarea
            id="hm-input"
            rows="7"
            placeholder="Paste your text, LaTeX paragraph, or source code here. Leave empty to inspect the sample."
            aria-describedby="hm-hint"
          ></textarea>
          <div class="hm-bar">
            <p id="hm-hint" class="muted hm-hint">100% client-side execution. Citations, locked keywords, numbers, equations and code logic are protected before rewriting.</p>
            <div class="hm-primary-btns">
              <button type="button" class="btn btn-primary" id="hm-run">Humanize text →</button>
              <button type="button" class="btn btn-secondary btn-sm" id="hm-respin" title="Cycle deterministic PRNG seed for an alternative phrasing and push to version history">Re-spin variation ↻</button>
            </div>
          </div>

          <!-- Output Notebook Sheet: Red-Pen Diff, AIHumanize Inline Highlight, and Clean Text + Version History -->
          <div class="hm-notebook mt-6">
            <div class="hm-notebook-head">
              <div>
                <span class="hm-eyebrow">Output workbench</span>
                <h2 class="hm-notebook-title">Rule-Engine Transformation</h2>
              </div>
              <div class="hm-head-controls">
                <!-- Multi-version output history pagination (from aihumanize.io #outputHistoryPrev / #outputHistoryNext) -->
                <div class="hm-history-nav" aria-label="Output version history">
                  <button type="button" class="hm-hist-btn" id="hm-hist-prev" title="Previous generated version" disabled>&lsaquo;</button>
                  <span class="hm-mono" id="hm-hist-count">1 / 1</span>
                  <button type="button" class="hm-hist-btn" id="hm-hist-next" title="Next generated version" disabled>&rsaquo;</button>
                </div>
                <div class="hm-view-tabs" role="tablist" aria-label="Output view mode">
                  <button type="button" role="tab" aria-selected="true" class="hm-tab active" id="hm-tab-diff" data-view="diff">Red-Pen Diff</button>
                  <button type="button" role="tab" aria-selected="false" class="hm-tab" id="hm-tab-highlight" data-view="highlight">Inline Highlight</button>
                  <button type="button" role="tab" aria-selected="false" class="hm-tab" id="hm-tab-clean" data-view="clean">Clean Text</button>
                </div>
              </div>
            </div>

            <ul class="hm-legend" id="hm-legend" aria-label="Markup legend">
              <li id="hm-legend-crossed"><span class="hm-crossed">Crossed out</span> original AI tell or k-gram token</li>
              <li><span class="hm-added">Highlighted</span> deterministic replacement</li>
              <li><span class="hm-invariant-pill" id="hm-gate-pill">✓ Zero-Tell, Fact &amp; Keyword Gates Passed</span></li>
              <li><span class="hm-invariant-pill hm-autopilot-pill" id="hm-autopilot-badge">Basic · 1 pass</span></li>
            </ul>

            <div
              id="hm-diff-view"
              class="hm-paper-sheet"
              role="region"
              aria-label="Marked up transformation diff"
              tabindex="0"
              set:html={initialDiffHtml}
            ></div>

            <div
              id="hm-highlight-view"
              class="hm-paper-sheet"
              role="region"
              aria-label="Clean output with modified spans highlighted"
              tabindex="0"
              hidden
              set:html={initialHighlightHtml}
            ></div>

            <textarea
              id="hm-clean-view"
              class="hm-clean-textarea"
              rows="7"
              hidden
              aria-label="Clean humanized output text"
            >{initialResult.output}</textarea>

            <!-- 7-Detector Bypass Status Bar (ported from aihumanize.io post-rewrite detector strip) -->
            <div class="hm-detector-strip" aria-label="AI detector bypass simulation">
              <span class="hm-detector-label">Detector pass check (&lt;20% target):</span>
              <div class="hm-detector-pills" id="hm-detectors">
                {initialResult.detectors.map((d: any) => (
                  <span class={`hm-det-badge ${d.passed ? 'hm-det-pass' : 'hm-det-warn'}`}>
                    <span class="hm-det-dot" aria-hidden="true"></span>
                    {d.name} <strong>{d.score}%</strong>
                  </span>
                ))}
              </div>
            </div>

            <p class="hm-tutor-note" id="hm-tutor-note">
              "Read it out loud once. Fix any phrase that sounds unlike you. Every number, locked keyword, citation and equation was kept intact."
            </p>

            <div class="hm-notebook-foot">
              <div class="hm-cta-group">
                <button type="button" class="btn btn-primary btn-sm" id="hm-copy">Copy clean text</button>
                <button type="button" class="btn btn-secondary btn-sm" id="hm-download">Download .txt</button>
                <button type="button" class="btn btn-secondary btn-sm" id="hm-speedread">Speed read this text</button>
                <button type="button" class="btn btn-secondary btn-sm" id="hm-check-readability">Check readability →</button>
              </div>
              <span class="hm-status-msg" id="hm-status" role="status" aria-live="polite"></span>
            </div>
          </div>

          <!-- Telemetry & Verification Dashboard -->
          <div class="hm-hero mt-6" id="hm-hero" aria-live="polite" aria-atomic="true">
            <div class="hm-hero-split">
              <div>
                <p class="hm-eyebrow">Estimated AI pattern risk</p>
                <div class="hm-score-pair">
                  <span class="hm-score-before" id="hm-risk-before">{initialResult.before.aiRiskScore}%</span>
                  <span class="hm-score-arrow" aria-hidden="true">→</span>
                  <span class="hm-score-after" id="hm-risk-after">{initialResult.after.aiRiskScore}%</span>
                </div>
                <p class="hm-band" id="hm-verdict">
                  Pattern signature reduced by {Math.max(0, initialResult.before.aiRiskScore - initialResult.after.aiRiskScore)} percentage points ({initialResult.counts.totalChanges} rule transformations applied)
                </p>
              </div>
              <div class="hm-meters">
                <div class="hm-meter-row">
                  <span>Source draft risk</span>
                  <div class="hm-meter"><span class="hm-meter-fill hm-meter-danger" id="hm-meter-before" style={`transform: scaleX(${beforeRiskScale})`}></span></div>
                </div>
                <div class="hm-meter-row">
                  <span>Humanized output risk</span>
                  <div class="hm-meter"><span class="hm-meter-fill hm-meter-safe" id="hm-meter-after" style={`transform: scaleX(${afterRiskScale})`}></span></div>
                </div>
              </div>
            </div>
          </div>

          <h2 class="mt-6">Mathematical verification &amp; signal telemetry</h2>
          <dl class="hm-grid">
            <div class="hm-card hm-card-main">
              <dt>Winnowing k=5 overlap</dt>
              <dd class="hm-num" id="hm-winnow">{initialResult.winnowingOverlapPct}%</dd>
              <dd class="hm-desc">Surviving 5-word Karp-Rabin rolling-hash fingerprints (w=4 window).</dd>
            </div>
            <div class="hm-card">
              <dt>Burstiness index</dt>
              <dd class="hm-num" id="hm-burst">{initialResult.before.burstiness} → {initialResult.after.burstiness}</dd>
              <dd class="hm-desc">Sentence-length variation (coefficient of variation). Higher is more human.</dd>
            </div>
            <div class="hm-card">
              <dt>Lexical entropy</dt>
              <dd class="hm-num" id="hm-entropy">{initialResult.before.perplexityProxy} → {initialResult.after.perplexityProxy}</dd>
              <dd class="hm-desc">Type-token vocabulary diversity and word-length unpredictability.</dd>
            </div>
            <div class="hm-card">
              <dt>AI tells scrubbed</dt>
              <dd class="hm-num" id="hm-tells">{initialResult.counts.tellsScrubbed}</dd>
              <dd class="hm-desc">Clichés, copula dodges and chatbot preambles removed (remaining: <span id="hm-tells-left">{initialResult.after.tellsCount}</span>).</dd>
            </div>
            <div class="hm-card">
              <dt>Watermarks &amp; dashes</dt>
              <dd class="hm-num" id="hm-wm">{initialResult.counts.watermarksRemoved + initialResult.counts.emDashesReplaced}</dd>
              <dd class="hm-desc">Zero-width Unicode trackers (U+200B–U+FEFF) and em-dashes stripped.</dd>
            </div>
            <div class="hm-card">
              <dt>Word count delta</dt>
              <dd class="hm-num" id="hm-words">{initialResult.before.words} → {initialResult.after.words}</dd>
              <dd class="hm-desc">Sentences: <span id="hm-sents">{initialResult.before.sentences} → {initialResult.after.sentences}</span>. Facts &amp; locks: <span id="hm-facts">100%</span>.</dd>
            </div>
          </dl>

          <h2 class="mt-6">Stage firing telemetry</h2>
          <dl class="hm-counts">
            <div><dt>Phrase rewrites</dt><dd id="hm-c-phrase">{initialResult.counts.phraseRewrites}</dd></div>
            <div><dt>Discourse rotations</dt><dd id="hm-c-disc">{initialResult.counts.discourseRotations}</dd></div>
            <div><dt>Synonym swaps</dt><dd id="hm-c-syn">{initialResult.counts.synonymSwaps}</dd></div>
            <div><dt>Clause reorders</dt><dd id="hm-c-clause">{initialResult.counts.clauseReorders}</dd></div>
            <div><dt>Determiner swaps</dt><dd id="hm-c-det">{initialResult.counts.determinerSwaps}</dd></div>
            <div><dt>Splits &amp; fusions</dt><dd id="hm-c-burst">{initialResult.counts.sentenceSplits + initialResult.counts.sentenceFusions}</dd></div>
            <div><dt>Voice &amp; noun flips</dt><dd id="hm-c-voice">{initialResult.counts.voiceTransforms + initialResult.counts.nominalizations}</dd></div>
            <div><dt>N-gram audit breaks</dt><dd id="hm-c-ngram">{initialResult.counts.ngramBreaks}</dd></div>
          </dl>
        </div>

        <!-- Deep Technical Documentation from Turnitout + AIHumanize Architecture -->
        <h2 class="mt-8">How programmatic pattern disruption works</h2>
        <p>
          Commercial "AI humanizers" route your text through another large language model. Because every language model selects tokens from a smooth probability distribution, LLM-rewritten text carries a fresh machine signature, frequently alters numbers or citations, and breaks LaTeX or code syntax.
        </p>
        <p>
          This tool unifies the open <strong>Turnitout</strong> 14-stage deterministic rule pipeline with <strong>AIHumanize</strong> scene registers, rewriting models, Autopilot multi-pass optimization, and LCS inline diffing—targeting the three mathematical layers used by similarity and statistical classifiers.
        </p>

        <h3 class="mt-6">1. Layer 1: Lexical fingerprinting &amp; the Winnowing 8-word guarantee</h3>
        <p>
          Document similarity engines (such as Turnitin and iThenticate) build sparse document fingerprints using the <strong>Winnowing algorithm</strong> (Schleimer, Wilkerson &amp; Aiken, 2003):
        </p>
        <ol class="steps">
          <li><strong>Normalization:</strong> Text is lowercased and stripped of punctuation and formatting into a continuous word stream.</li>
          <li><strong>5-gram slicing:</strong> A sliding window extracts contiguous sequences of $k = 5$ words.</li>
          <li><strong>Karp-Rabin rolling hash:</strong> Each 5-gram is mapped to a numeric hash in $O(1)$ time. Changing a single word inside any 5-word window produces an unrelated hash.</li>
          <li><strong>Window minimum selection ($w = 4$):</strong> The scanner moves a window of $w = 4$ hashes and records the minimum hash in each window. Any matching passage of $k + w - 1 = 8$ consecutive words is mathematically guaranteed to share at least one fingerprint.</li>
        </ol>
        <p>
          Our pipeline runs multi-word phrase rewrites (which break up to five overlapping 5-gram windows at once), inflection-matched synonym swaps with a 15-word FIFO (first-in, first-out) repetition blocker, and a post-pass <strong>Source-Aware Winnowing Audit</strong> that checks the output against your original text and breaks surviving 5-gram chains.
        </p>

        <h3 class="mt-6">2. Layer 2: Syntax tree diversity, burstiness &amp; PDTB 2.0 discourse rotation</h3>
        <p>
          Statistical AI classifiers measure two core distributions across a draft: <strong>perplexity</strong> (how predictable word choices are) and <strong>burstiness</strong> (the variance in sentence length and clause structure). Language models produce uniform 18-to-24-word sentences and repeat the same transition openers (<em>Furthermore</em>, <em>Moreover</em>, <em>Additionally</em>, <em>In conclusion</em>).
        </p>
        <ul>
          <li><strong>PDTB 2.0 discourse rotation:</strong> Rotates formal connectors using the Penn Discourse Treebank taxonomy and tracks every replacement in a per-document set so the same transition never repeats.</li>
          <li><strong>Burstiness split &amp; fusion engine:</strong> Splits long compound sentences (24+ words, or 16+ words in Simplify mode) at coordinating conjunctions and fuses adjacent short sentences (&le;12 words), raising the coefficient of variation ($\sigma / \mu$) of sentence lengths.</li>
          <li><strong>Scene &amp; model calibration:</strong> Switch between General, Academic, Blog, Formal, Informal, Expand, Simplify, Technical, and Code Comments modes, paired with Quality (0.75x), Balance (1.0x), Enhanced (1.2x), or Private cadence models and Autopilot Pro multi-pass optimization.</li>
        </ul>

        <h3 class="mt-6">3. Layer 3: Zero-width watermark scrubbing &amp; invariant safety gates</h3>
        <p>
          Copied model outputs often carry invisible Unicode characters (`U+200B` zero-width space, `U+200C` non-joiner, `U+200D` joiner, `U+2060` word joiner, `U+FEFF` byte-order mark) and dense em-dashes (`—`). The scrubber strips these before running the <strong>38-Pattern AI Tell Scrubber</strong> and enforces three strict mathematical invariants:
        </p>
        <ul>
          <li><strong>Zero-Tell Invariant Gate (<code>tells(output) &le; tells(input)</code>):</strong> Verifies that no synonym or phrase swap ever introduces a machine cliché.</li>
          <li><strong>Fact &amp; Syntax Invariant Gate:</strong> Locks LaTeX math (<code>$...$</code>), citations (<code>[1]</code>, <code>\cite&#123;&#125;</code>), URLs, scientific constants, and numeric data inside placeholders before transformation and verifies 100% preservation afterward.</li>
          <li><strong>SEO Keyword &amp; Quoted Citation Lock Gate:</strong> Freezes up to 30 custom SEO phrases and double-quoted passages (<code>"..."</code>) so key terminology and direct quotations are never altered.</li>
        </ul>

        <h2 class="mt-8">Rule-based engine vs. LLM paraphrasers</h2>
        <div class="hm-table-wrap">
          <table class="hm-table">
            <caption class="hm-sr">Comparison of BriskRead programmatic humanizer and generative AI paraphrasers</caption>
            <thead>
              <tr>
                <th scope="col">Capability</th>
                <th scope="col">Programmatic Rule Engine (This Tool)</th>
                <th scope="col">LLM Paraphrasers (QuillBot / StealthGPT)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Underlying mechanism</strong></td>
                <td>100% deterministic linguistic rules (zero AI)</td>
                <td>Generative language model (adds new AI token distribution)</td>
              </tr>
              <tr>
                <td><strong>Fact, keyword &amp; quote accuracy</strong></td>
                <td>100% preserved via placeholder masking gate</td>
                <td>Prone to altering numbers, SEO keywords and direct quotes</td>
              </tr>
              <tr>
                <td><strong>LaTeX &amp; math equations</strong></td>
                <td>Strictly locked (<code>$...$</code>, <code>\cite&#123;&#125;</code> untouched)</td>
                <td>Often corrupts macros and equation delimiters</td>
              </tr>
              <tr>
                <td><strong>Source code safety</strong></td>
                <td>String-aware tokenizer rewrites comments only</td>
                <td>Modifies variable names or breaks syntax</td>
              </tr>
              <tr>
                <td><strong>Zero-width Unicode purge</strong></td>
                <td>Strips U+200B–U+FEFF and normalizes em-dashes</td>
                <td>Often leaves invisible characters intact</td>
              </tr>
              <tr>
                <td><strong>Privacy &amp; word limits</strong></td>
                <td>Unlimited words, runs 100% locally in browser</td>
                <td>Cloud-logged, paywalled or capped at 125–300 words</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 class="mt-8">Why non-native (ESL) writers get falsely flagged</h2>
        <p>
          A 2023 Stanford University study (<a href="https://doi.org/10.1016/j.patter.2023.100779" rel="noopener">Liang et al., <em>Patterns</em></a>) found that commercial AI detectors misclassified over 61% of TOEFL essays written by non-native English speakers as AI-generated. Because second-language writers often rely on standard transition words and steady sentence lengths, perplexity-based classifiers penalize clear, textbook prose. Adding natural sentence-length variety, plain verbs, and varied connectors helps restore a natural rhythm—especially when paired with our <a href="/readability-checker">readability checker</a>.
        </p>

        <h2 class="mt-8">Programmatic humanizer FAQ</h2>
        {faqs.map(({ q, a }) => (
          <>
            <h3 class="faq-q">{q}</h3>
            <p>{a}</p>
          </>
        ))}

        <div class="related mt-8">
          <h2>Related free tools &amp; guides</h2>
          <p>
            <a href="/">Online speed reader</a> ·
            <a href="/readability-checker">Readability checker</a> ·
            <a href="/words-to-minutes">Words to minutes</a> ·
            <a href="/teleprompter">Teleprompter</a> ·
            <a href="/reading-speed-test">Reading speed test</a> ·
            <a href="/bionic-reading">Bionic reading</a> ·
            <a href="/rsvp-reader">RSVP reader</a> ·
            <a href="/pdf-to-speech">PDF to speech</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="ads-section mt-8">
    <div class="container max-w-3xl">
      <AdSlot placement="MID" format="auto" />
    </div>
  </section>

  <script is:inline src="/humanizer.js"></script>
  <script is:inline>
    (() => {
      const H = globalThis.BriskReadHumanizer;
      if (!H) return;
      const $ = (id) => document.getElementById(id);

      const input = $('hm-input');
      const modeSel = $('hm-mode');
      const modelSel = $('hm-model');
      const autopilotCb = $('hm-autopilot');
      const lockKeywordsInput = $('hm-lock-keywords');
      const lockCitationsCb = $('hm-lock-citations');
      const kwCountEl = $('hm-kw-count');
      const langBadge = $('hm-lang-badge');
      const personaWrap = $('hm-persona-wrap');
      const personaSel = $('hm-persona');
      const intensitySlider = $('hm-intensity');
      const intensityVal = $('hm-intensity-val');
      const diffView = $('hm-diff-view');
      const highlightView = $('hm-highlight-view');
      const cleanView = $('hm-clean-view');
      const tabDiff = $('hm-tab-diff');
      const tabHighlight = $('hm-tab-highlight');
      const tabClean = $('hm-tab-clean');
      const legend = $('hm-legend');
      const legendCrossed = $('hm-legend-crossed');
      const gatePill = $('hm-gate-pill');
      const autopilotBadge = $('hm-autopilot-badge');
      const detectorsEl = $('hm-detectors');
      const histPrev = $('hm-hist-prev');
      const histNext = $('hm-hist-next');
      const histCount = $('hm-hist-count');
      const statusEl = $('hm-status');

      const INITIAL_SAMPLE =
        "In conclusion, previous studies have shown that in today's fast-paced digital era, the profound impact of modern neural networks cannot be overlooked [1]. " +
        'Furthermore, the interplay between stochastic optimization and computational scalability provides a robust framework for subsequent empirical inquiries (Vaswani et al., 2017). ' +
        'Moreover, it should be noted that the application of Crank-Nicolson discretization serves as a critical milestone in maintaining 99.4% numerical stability.';

      const ESC = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ESC[c]);
      const setText = (id, v) => {
        const el = $(id);
        if (el) el.textContent = String(v);
      };

      let currentSeed = 0;
      let activeView = 'diff'; // 'diff' | 'highlight' | 'clean'
      let lastResult = null;
      let outputHistory = [];
      let historyIndex = -1;
      let lastInputSignature = '';

      const parseLockedKeywords = () => {
        const raw = (lockKeywordsInput && lockKeywordsInput.value) || '';
        const list = raw
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean)
          .slice(0, 30);
        if (kwCountEl) kwCountEl.textContent = `${list.length} / 30 locked`;
        return list;
      };

      const getStageToggles = () => {
        const stages = {};
        document.querySelectorAll('input[data-stage]').forEach((cb) => {
          stages[cb.dataset.stage] = cb.checked;
        });
        return stages;
      };

      const setViewMode = (view) => {
        activeView = view;
        const isDiff = view === 'diff';
        const isHighlight = view === 'highlight';
        const isClean = view === 'clean';
        tabDiff.classList.toggle('active', isDiff);
        tabHighlight.classList.toggle('active', isHighlight);
        tabClean.classList.toggle('active', isClean);
        tabDiff.setAttribute('aria-selected', String(isDiff));
        tabHighlight.setAttribute('aria-selected', String(isHighlight));
        tabClean.setAttribute('aria-selected', String(isClean));
        diffView.hidden = !isDiff;
        highlightView.hidden = !isHighlight;
        cleanView.hidden = !isClean;
        legend.hidden = isClean;
        if (legendCrossed) legendCrossed.hidden = isHighlight;
      };

      const renderDiffHtml = (res, mode) => {
        if (mode === 'code') {
          return `<code>${esc(res.output)}</code>`;
        }
        if (!res.diff || !res.diff.length) {
          return esc(res.output);
        }
        return res.diff
          .map((seg) => {
            if (seg.type === 'removed') return `<span class="hm-crossed">${esc(seg.text)}</span>`;
            if (seg.type === 'added') return `<span class="hm-added">${esc(seg.text)}</span>`;
            return esc(seg.text);
          })
          .join(' ');
      };

      const renderHighlightHtml = (res, mode) => {
        if (mode === 'code') {
          return `<code>${esc(res.output)}</code>`;
        }
        if (!res.highlightDiff || !res.highlightDiff.length) {
          return esc(res.output);
        }
        return res.highlightDiff
          .map((seg) => (seg.changed ? `<span class="hm-diff-highlight">${esc(seg.text)}</span>` : esc(seg.text)))
          .join('');
      };

      const renderDetectors = (detectors) => {
        if (!detectorsEl || !Array.isArray(detectors)) return;
        detectorsEl.innerHTML = detectors
          .map(
            (d) =>
              `<span class="hm-det-badge ${d.passed ? 'hm-det-pass' : 'hm-det-warn'}"><span class="hm-det-dot" aria-hidden="true"></span>${esc(d.name)} <strong>${d.score}%</strong></span>`
          )
          .join('');
      };

      const updateHistoryControls = () => {
        if (!histCount || !histPrev || !histNext) return;
        const total = outputHistory.length || 1;
        const idx = historyIndex >= 0 ? historyIndex + 1 : 1;
        histCount.textContent = `${idx} / ${total}`;
        histPrev.disabled = idx <= 1;
        histNext.disabled = idx >= total;
      };

      const applyResultToDOM = (res, mode) => {
        lastResult = res;
        if (mode === 'code' && activeView !== 'clean') {
          setViewMode('clean');
        }

        diffView.innerHTML = renderDiffHtml(res, mode);
        highlightView.innerHTML = renderHighlightHtml(res, mode);
        cleanView.value = res.output;
        renderDetectors(res.detectors);

        if (langBadge && res.language) {
          const unit = res.language.isCJK ? 'CJK chars' : 'words';
          langBadge.textContent = `${res.language.words} ${unit} · ${res.language.lang.toUpperCase()}`;
        }

        const b = res.before;
        const a = res.after;
        const c = res.counts;

        setText('hm-risk-before', `${b.aiRiskScore}%`);
        setText('hm-risk-after', `${a.aiRiskScore}%`);
        const drop = Math.max(0, b.aiRiskScore - a.aiRiskScore);
        setText(
          'hm-verdict',
          mode === 'code'
            ? `Code safety guaranteed: ${c.commentsModified} comment block(s) humanized (${c.totalChanges} total rule edits), 100% executable syntax untouched.`
            : `Pattern signature reduced by ${drop} percentage points (${c.totalChanges} rule transformations applied)`
        );

        $('hm-meter-before').style.transform = `scaleX(${Math.min(100, Math.max(0, b.aiRiskScore)) / 100})`;
        $('hm-meter-after').style.transform = `scaleX(${Math.min(100, Math.max(0, a.aiRiskScore)) / 100})`;

        setText('hm-winnow', `${res.winnowingOverlapPct}%`);
        setText('hm-burst', `${b.burstiness} → ${a.burstiness}`);
        setText('hm-entropy', `${b.perplexityProxy} → ${a.perplexityProxy}`);
        setText('hm-tells', c.tellsScrubbed);
        setText('hm-tells-left', a.tellsCount);
        setText('hm-wm', c.watermarksRemoved + c.emDashesReplaced);
        setText('hm-words', `${b.words} → ${a.words}`);
        setText('hm-sents', `${b.sentences} → ${a.sentences}`);
        const allPreserved =
          res.invariants.factsPreserved &&
          res.invariants.keywordsPreserved &&
          res.invariants.citationsPreserved;
        setText('hm-facts', allPreserved ? '100%' : 'Check');

        if (gatePill) {
          gatePill.textContent =
            res.invariants.zeroTellPassed && allPreserved
              ? '✓ Zero-Tell, Fact & Keyword Gates Passed'
              : '✓ Transformation Complete';
        }

        if (autopilotBadge && res.autopilot) {
          autopilotBadge.textContent = res.autopilot.enabled
            ? `Autopilot Pro · ${res.autopilot.passesRun} pass(es) · ${res.autopilot.targetReached ? '<20% Passed' : 'Best pass'}`
            : `Basic · ${modelSel.value.charAt(0).toUpperCase() + modelSel.value.slice(1)}`;
        }

        setText('hm-c-phrase', c.phraseRewrites);
        setText('hm-c-disc', c.discourseRotations);
        setText('hm-c-syn', c.synonymSwaps);
        setText('hm-c-clause', c.clauseReorders);
        setText('hm-c-det', c.determinerSwaps);
        setText('hm-c-burst', c.sentenceSplits + c.sentenceFusions);
        setText('hm-c-voice', c.voiceTransforms + c.nominalizations);
        setText('hm-c-ngram', c.ngramBreaks);
      };

      const runEngine = (pushVersion = true) => {
        const userText = input.value;
        const text = userText.trim() ? userText : INITIAL_SAMPLE;
        const mode = modeSel.value;
        const model = modelSel ? modelSel.value : 'balance';
        const autopilot = Boolean(autopilotCb && autopilotCb.checked);
        const lockKeywords = parseLockedKeywords();
        const lockCitations = Boolean(lockCitationsCb && lockCitationsCb.checked);
        const intensity = Number(intensitySlider.value);
        const effPct = Math.round(H.effectiveIntensity(intensity) * 100);
        intensityVal.textContent = `${intensity}% (effective ${effPct}% power curve)`;
        personaWrap.hidden = mode !== 'code';

        const inputSig = `${text}::${mode}::${model}::${autopilot}::${lockKeywords.join('|')}::${lockCitations}`;
        if (inputSig !== lastInputSignature) {
          outputHistory = [];
          historyIndex = -1;
          lastInputSignature = inputSig;
        }

        const res = H.humanize(text, {
          mode,
          model,
          autopilot,
          lockKeywords,
          lockCitations,
          intensity,
          seed: currentSeed,
          persona: personaSel.value,
          stages: getStageToggles(),
        });

        if (pushVersion) {
          outputHistory.push({ res, mode });
          historyIndex = outputHistory.length - 1;
        }
        updateHistoryControls();
        applyResultToDOM(res, mode);
      };

      // Version history prev/next navigation
      histPrev?.addEventListener('click', () => {
        if (historyIndex > 0) {
          historyIndex -= 1;
          const item = outputHistory[historyIndex];
          updateHistoryControls();
          applyResultToDOM(item.res, item.mode);
          setText('hm-status', `Viewing version ${historyIndex + 1} of ${outputHistory.length}.`);
        }
      });

      histNext?.addEventListener('click', () => {
        if (historyIndex + 1 < outputHistory.length) {
          historyIndex += 1;
          const item = outputHistory[historyIndex];
          updateHistoryControls();
          applyResultToDOM(item.res, item.mode);
          setText('hm-status', `Viewing version ${historyIndex + 1} of ${outputHistory.length}.`);
        }
      });

      // Preset sample buttons
      document.querySelectorAll('[data-sample]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.sample;
          const sample = H.SAMPLES[key];
          if (!sample) return;
          input.value = sample;
          if (key === 'code') {
            modeSel.value = 'code';
            setViewMode('clean');
          } else if (key === 'latex') {
            modeSel.value = 'technical';
            setViewMode('diff');
          } else if (key === 'academic') {
            modeSel.value = 'academic';
            setViewMode('diff');
          } else if (key === 'genz') {
            modeSel.value = 'blog';
            setViewMode('highlight');
          } else {
            modeSel.value = 'conversational';
            setViewMode('diff');
          }
          currentSeed = 0;
          runEngine(true);
          setText('hm-status', `Loaded ${btn.textContent.trim()} preset.`);
        });
      });

      // File upload (.txt, .md, .tex, .py, .js, etc.)
      const fileInput = $('hm-file');
      fileInput?.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        const text = await file.text();
        input.value = text;
        const ext = (file.name.split('.').pop() || '').toLowerCase();
        if (['py', 'js', 'ts', 'cpp', 'c', 'java', 'sql', 'sh'].includes(ext)) {
          modeSel.value = 'code';
          setViewMode('clean');
        } else if (ext === 'tex') {
          modeSel.value = 'technical';
          setViewMode('diff');
        }
        currentSeed = 0;
        runEngine(true);
        setText('hm-status', `Loaded ${file.name} (${text.length.toLocaleString()} chars).`);
      });

      // Test watermark injection button
      $('hm-inject-zw')?.addEventListener('click', () => {
        const base = input.value.trim() || H.SAMPLES.academic;
        input.value = '\u200B' + base.replace(/\s+/g, (m, idx) => (idx % 5 === 0 ? '\u200B\u200C ' : m)) + ' — verified\uFEFF.';
        runEngine(true);
        setText('hm-status', 'Injected hidden zero-width Unicode (U+200B, U+200C, U+FEFF) and em-dash — and scrubbed them.');
      });

      $('hm-clear')?.addEventListener('click', () => {
        input.value = '';
        currentSeed = 0;
        outputHistory = [];
        historyIndex = -1;
        runEngine(true);
        input.focus();
        setText('hm-status', 'Reset to sample.');
      });

      $('hm-run')?.addEventListener('click', () => {
        runEngine(true);
        setText('hm-status', 'Rule pipeline executed.');
      });

      $('hm-respin')?.addEventListener('click', () => {
        currentSeed += 1;
        runEngine(true);
        setText('hm-status', `Variation #${outputHistory.length} generated (use < > to compare versions).`);
      });

      tabDiff?.addEventListener('click', () => setViewMode('diff'));
      tabHighlight?.addEventListener('click', () => setViewMode('highlight'));
      tabClean?.addEventListener('click', () => setViewMode('clean'));

      modeSel?.addEventListener('change', () => runEngine(true));
      modelSel?.addEventListener('change', () => runEngine(true));
      autopilotCb?.addEventListener('change', () => runEngine(true));
      lockCitationsCb?.addEventListener('change', () => runEngine(true));
      personaSel?.addEventListener('change', () => runEngine(true));
      intensitySlider?.addEventListener('input', () => runEngine(false));
      document.querySelectorAll('input[data-stage]').forEach((cb) => cb.addEventListener('change', () => runEngine(false)));

      let debounceTimer;
      input?.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => runEngine(true), 220);
      });
      lockKeywordsInput?.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => runEngine(true), 220);
      });

      // Initialize first history entry
      runEngine(true);

      // Copy clean text
      $('hm-copy')?.addEventListener('click', async () => {
        const textToCopy = cleanView.value || (lastResult && lastResult.output) || '';
        if (!textToCopy) return;
        try {
          await navigator.clipboard.writeText(textToCopy);
          setText('hm-status', 'Copied clean text to clipboard.');
        } catch {
          cleanView.hidden = false;
          cleanView.select();
          setText('hm-status', 'Selected text — press Ctrl+C to copy.');
        }
      });

      // Download clean text
      $('hm-download')?.addEventListener('click', () => {
        const textToSave = cleanView.value || (lastResult && lastResult.output) || '';
        if (!textToSave) return;
        const ext = modeSel.value === 'code' ? 'py' : modeSel.value === 'technical' ? 'tex' : 'txt';
        const blob = new Blob([textToSave], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `briskread-humanized.${ext}`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        setText('hm-status', `Downloaded briskread-humanized.${ext}`);
      });

      // Speed read handoff via sr_extension_article
      $('hm-speedread')?.addEventListener('click', () => {
        const text = (cleanView.value || (lastResult && lastResult.output) || '').trim();
        if (text.length < 20) {
          setText('hm-status', 'Add at least a sentence before sending to the speed reader.');
          return;
        }
        try {
          sessionStorage.setItem('sr_extension_article', JSON.stringify({ title: 'Humanized draft', text }));
          location.href = '/';
        } catch {
          setText('hm-status', 'Session storage blocked. Copy the text and paste it on the home reader.');
        }
      });

      // Readability checker handoff
      $('hm-check-readability')?.addEventListener('click', () => {
        const text = (cleanView.value || (lastResult && lastResult.output) || '').trim();
        try {
          sessionStorage.setItem('briskread_humanized_handoff', text);
        } catch {}
        location.href = '/readability-checker';
      });
    })();
  </script>
</Layout>

<style>
  .max-w-3xl { max-width: 860px; margin: 0 auto; }
  .content-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }
  .lede { font-size: 1.1rem; color: var(--color-text-muted); margin-bottom: 1rem; line-height: 1.65; }
  h1 { font-size: clamp(2rem, 4.6vw, 3.35rem); line-height: 1.06; letter-spacing: -0.035em; margin-top: 0.5rem; }
  h2 { font-size: 1.3rem; margin-bottom: 0.5rem; }
  h3 { font-size: 1.05rem; margin-bottom: 0.35rem; color: var(--color-text); }
  .faq-q { font-size: 1rem; margin: 1rem 0 0.35rem; }
  .steps, ul { margin-left: 1.25rem; color: var(--color-text-muted); display: flex; flex-direction: column; gap: 0.5rem; }
  p { color: var(--color-text-muted); margin-bottom: 0.75rem; line-height: 1.7; }
  li { line-height: 1.65; }
  li strong { color: var(--color-text); }
  .mt-4 { margin-top: 1rem; }
  .mt-6 { margin-top: 1.5rem; }
  .mt-8 { margin-top: 2rem; }
  .related { border-top: 1px solid var(--color-border); padding-top: 1.5rem; }
  .related p { line-height: 2; }
  .hm-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* Stamps / Kicker */
  .hm-kicker-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  .hm-stamp {
    display: inline-block; font-family: var(--font-mono, monospace); font-size: 0.72rem;
    font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem; border-radius: 3px; border: 1.5px solid currentColor;
  }
  .hm-stamp-red { color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 8%, transparent); }
  .hm-stamp-ink { color: var(--color-text); background: color-mix(in srgb, var(--color-text) 6%, transparent); }
  .hm-stamp-blue { color: var(--color-text-muted); }

  /* Preset chips */
  .hm-preset-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    padding: 0.65rem 0.85rem; border-radius: 0.5rem; border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .hm-preset-label { font-size: 0.82rem; font-weight: 600; color: var(--color-text-muted); margin-right: 0.25rem; }
  .hm-chip {
    font-size: 0.82rem; font-weight: 500; padding: 0.3rem 0.65rem; border-radius: 0.35rem;
    border: 1px solid var(--color-border); background: var(--color-bg-card); color: var(--color-text);
    cursor: pointer; transition: border-color 0.15s, background 0.15s;
  }
  .hm-chip:hover { border-color: var(--color-primary); }
  .hm-upload-label { margin-left: auto; cursor: pointer; }

