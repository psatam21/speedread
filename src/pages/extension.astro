---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Chrome Speed Reader Extension: Free RSVP | BriskRead";
const pageDescription = "Free Chrome speed reader extension: RSVP-read any tab or selection in one click, with a read-later queue. No account needed. Loads in developer mode for now.";

const faqs = [
  {
    q: 'Does the BriskRead Chrome extension require an account?',
    a: 'No. In-page RSVP reading, bionic formatting, read-aloud, and the read-later queue all work without signing in. An optional BriskRead account only syncs your library and stats across devices.',
  },
  {
    q: 'Does the extension track my browsing history?',
    a: 'No. The extension uses activeTab permission, which means it can only read the current page after you click the toolbar icon, use a keyboard shortcut, or pick a right-click menu item.',
  },
  {
    q: 'What are the keyboard shortcuts for the extension?',
    a: 'Press Alt+Shift+S to speed-read the current page or selection, and Alt+Shift+K to toggle bionic reading on the live page.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <section class="ext-page mt-8">
    <div class="container max-w-3xl">
      <div class="glass content-card">
        <h1>BriskRead speed reader for Chrome</h1>
        <p class="lede">
          Extract any article into the BriskRead workspace in one click, free. Sign in with a BriskRead account only if you want your library and progress synced across devices.
        </p>

        <div class="actions">
          <a class="btn btn-primary" href="#install">Install (developer mode)</a>
          <a class="btn btn-secondary" href="/">Open web app</a>
          <a class="btn btn-secondary" href="/account">Account</a>
        </div>

        <h2>How the extension behaves</h2>
        <ul>
          <li><strong>Right-click selected text or a page:</strong> opens a private RSVP popup right away. You stay on the current tab.</li>
          <li><strong>Speed read this page:</strong> extracts the page and opens the same local reader.</li>
          <li><strong>Open BriskRead app:</strong> opens the full website for files, OCR, <a href="/bionic-reading">bionic reading</a>, <a href="/pdf-to-speech">PDF to speech</a> and AI.</li>
          <li><strong>Options:</strong> developer endpoint settings. Normal users can leave the defaults unchanged.</li>
        </ul>

        <h2 id="install">Install in Developer mode</h2>
        <ol class="steps">
          <li>Download the release zip from the project release folder, or clone the repo and open <code>chrome-extension/</code>.</li>
          <li>Open <code>chrome://extensions</code> and enable <strong>Developer mode</strong>.</li>
          <li>Click <strong>Load unpacked</strong> and select the <code>chrome-extension</code> directory (unzipped, with <code>manifest.json</code> at the root).</li>
          <li>Pin BriskRead. Optional: right-click a page, select <strong>Speed read this page</strong>, or press <kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>S</kbd>.</li>
        </ol>

        <h2>Install from the Chrome Web Store</h2>
        <ol class="steps">
          <li>Open this page and choose <strong>Install from Chrome Web Store</strong> once the public listing is live.</li>
          <li>Chrome handles installation and future updates automatically.</li>
        </ol>
        <p class="muted">The Store button will appear here after Chrome approves the listing. Until then, use Developer mode above.</p>

        <h2>Optional sign-in for sync</h2>
        <ol class="steps">
          <li>Create or sign in to your free BriskRead account on the <a href="/account">Account</a> page.</li>
          <li>Open the extension popup and use the same email to keep reading progress connected.</li>
          <li>No account? Everything still works and stays on that device.</li>
        </ol>

        <h2>What we access</h2>
        <ul>
          <li><strong>Active tab</strong>: only when you click Speed read or use the context menu, to extract article text.</li>
          <li><strong>BriskRead</strong>: only if you sign in, to sync your library and totals across devices.</li>
          <li><strong>Storage</strong>: your settings stay on your machine in extension storage.</li>
        </ul>
        <p class="muted">
          Full policy: <a href="/privacy">Privacy Policy</a>. We do not sell browsing history.
        </p>

        <h2>Chrome extension FAQ</h2>
        {faqs.map(({ q, a }) => (
          <>
            <h3 class="faq-q">{q}</h3>
            <p class="muted">{a}</p>
          </>
        ))}

        <p class="muted">New to paced reading? Read <a href="/how-it-works">how speed reading works</a>, check your baseline on the <a href="/reading-speed-test">reading speed test</a>, or try the <a href="/rsvp-reader">RSVP reader</a> on this site first.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .max-w-3xl { max-width: 720px; margin: 0 auto; }
  .content-card {
    padding: 2.25rem;
    border-radius: 12px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }
  h1 { font-size: clamp(2rem, 5vw, 3.75rem); line-height: 1.05; letter-spacing: -0.035em; }
  .lede { color: var(--color-text-muted); font-size: 1.05rem; margin: 0.75rem 0 1.25rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem; }
  .actions a { text-decoration: none; }
  h2 { font-size: 1.15rem; margin-top: 1.75rem; margin-bottom: 0.5rem; }
  .steps, ul {
    margin: 0.5rem 0 0 1.2rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    line-height: 1.55;
  }
  code, kbd {
    font-size: 0.85em;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
  }
  .muted { color: var(--color-text-muted); margin-top: 0.75rem; font-size: 0.95rem; }
</style>
