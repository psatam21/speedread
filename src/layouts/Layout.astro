---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  /** 'article' for blog posts; adds article:* Open Graph tags. */
  ogType?: 'website' | 'article';
  /** Byline name for <meta name="author"> (blog posts pass the writer). */
  author?: string;
  /** ISO dates (YYYY-MM-DD), used when ogType is 'article'. */
  publishedTime?: string;
  modifiedTime?: string;
}

// Static builds report "/rsvp-reader/"; the site's one URL form is "/rsvp-reader"
// (vercel.json trailingSlash:false 308s the slash variant here).
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const {
  title,
  description,
  canonicalUrl = new URL(pathname, Astro.site || Astro.url).href,
  ogImage = '/images/og-default.png',
  noindex = false,
  ogType = 'website',
  author = 'BriskRead',
  publishedTime,
  modifiedTime,
} = Astro.props;

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID as string | undefined;
const adsenseAutoAds = import.meta.env.PUBLIC_ADSENSE_AUTO_ADS === 'true';
const adsenseVerification = import.meta.env.PUBLIC_ADSENSE_VERIFICATION as string | undefined;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const isHome = pathname === '/';
const allowAds = pathname !== '/account';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
const siteOrigin = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://briskread.com';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BriskRead',
  alternateName: ['Brisk Read', 'BriskRead speed reader'],
  url: siteOrigin,
  logo: `${siteOrigin}/images/brand-mark.png`,
  description:
    'Free dual-channel online speed reader with RSVP, Audio Sync, Focus, Bionic, PDF/EPUB import, and a Chrome extension.',
  email: 'support@briskread.com',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'support@briskread.com',
    url: `${siteOrigin}/contact`,
  },
  // Add social profile URLs here when public handles exist (helps entity matching in AI search).
  sameAs: [] as string[],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BriskRead',
  url: siteOrigin,
  description:
    'Online speed reader with Audio Sync, six reading modes, and local PDF/EPUB processing.',
  publisher: { '@type': 'Organization', name: 'BriskRead', url: siteOrigin },
  inLanguage: 'en',
};
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'BriskRead',
  applicationCategory: 'EducationalApplication',
  applicationSubCategory: 'Speed reading',
  operatingSystem: 'Web browser',
  url: siteOrigin,
  description:
    'Free dual-channel online speed reader: RSVP flash, Audio Sync TTS, Focus, Flow, Bionic, and Page modes with local PDF/EPUB processing.',
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Completely free — unlimited documents, all modes, account sync, and the full Chrome extension. Supported by ads.',
    },
  ],
  featureList: [
    'RSVP Flash with Optimal Recognition Point',
    'Audio Sync dual-channel TTS',
    'Focus, Phrase, Flow, Bionic, and Page modes',
    'Local PDF, EPUB, paste, and OCR',
    'Chrome extension for page capture',
  ],
  screenshot: `${siteOrigin}/images/og-default.png`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter600} as="font" type="font/woff2" crossorigin />
    
    <!-- Brand tab icon: prefer PNG/ICO (most browsers); SVG as progressive enhancement.
         ?v= busts aggressive favicon caches after brand updates. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png?v=2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/images/favicon-48.png?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* noindex + canonical is a mixed signal, so noindex pages get no canonical */}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#5e6ad2" />
    <meta name="author" content={author} />
    
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url).href} />
    <meta property="og:site_name" content="BriskRead" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site || Astro.url).href} />

    {adsenseVerification && (
      <meta name="google-adsense-account" content={adsenseVerification.startsWith('ca-pub') ? adsenseVerification : adsenseClient} />
    )}
    {adsenseClient && !adsenseVerification && (
      <meta name="google-adsense-account" content={adsenseClient} />
    )}

    <!-- Critical Theme Script: Avoids FOUC -->
    <script is:inline>
      const getStoredTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      };
      
      const getStoredFont = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('font')) {
          return localStorage.getItem('font');
        }
        return 'sans';
      };
      
      const theme = getStoredTheme();
      const font = getStoredFont();
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.setAttribute('data-font', font);

      // Merriweather is only for the reader's optional serif font, so fetch it on demand
      // (initial load or whenever the reader switches data-font) instead of on every page.
      const loadSerif = () => {
        if (document.documentElement.dataset.font !== 'serif' || document.getElementById('font-serif')) return;
        const link = document.createElement('link');
        link.id = 'font-serif';
        link.rel = 'stylesheet';
        link.href = 'https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap';
        document.head.appendChild(link);
      };
      loadSerif();
      new MutationObserver(loadSerif).observe(document.documentElement, { attributes: true, attributeFilter: ['data-font'] });
    </script>
    
    {gaId && (
      <>
        {/* Standard Google tag shape so GA “test your website” can detect it */}
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${gaId}');
`} />
      </>
    )}

    <!-- Google AdSense (Auto Ads + manual units) -->
    {adsenseClient && allowAds && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
        data-ad-client={adsenseClient}
        data-ad-frequency-hint={adsenseAutoAds ? '30s' : undefined}
      ></script>
    )}

    {/* Site-wide identity for search engines (SEO starter: help Google understand the site) */}
    {/* Site identity belongs on the homepage (Google's guidance); other pages add their own via slot="head" */}
    {isHome && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
      </>
    )}
    <slot name="head" />
    <link rel="alternate" type="text/plain" title="LLM site summary" href="/llms.txt" />
  </head>
  <body data-supabase-url={supabaseUrl} data-supabase-anon-key={supabaseAnonKey}>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cursor-glow" aria-hidden="true" data-surface="light">
      <span class="cursor-glow-layer cursor-glow-light"></span>
      <span class="cursor-glow-layer cursor-glow-dark"></span>
    </div>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="launch-strip">
      <div class="container launch-strip-inner">
        <span class="launch-pill" aria-hidden="true"></span>
        <span>Free reader · no account · files stay on your device</span>
        <a href="/#importer-card">Start reading <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <header class="site-header">
      <div class="container header-container">
        <a href="/" class="logo-link" aria-label="BriskRead home">
          <div class="logo-container">
            <img
              class="logo-mark-img"
              src="/images/brand-mark-96.png"
              width="28"
              height="28"
              alt=""
              decoding="async"
            />
            <span class="logo-text">BriskRead</span>
          </div>
        </a>
        
        <nav class="nav-links" aria-label="Primary">
          <a href="/" class:list={["nav-link", { active: isHome }]}>Reader</a>
          <a href="/#features" class="nav-link">Features</a>
          <a href="/how-it-works" class:list={["nav-link", { active: pathname === '/how-it-works' }]}>How it works</a>
          <a href="/rsvp-reader" class:list={["nav-link", { active: pathname === '/rsvp-reader' }]}>RSVP</a>
          <a href="/bionic-reading" class:list={["nav-link", { active: pathname === '/bionic-reading' }]}>Bionic</a>
          <a href="/extension" class:list={["nav-link", { active: pathname === '/extension' }]}>Chrome</a>
          <a href="/blog" class:list={["nav-link", { active: pathname.startsWith('/blog') }]}>Blog</a>
          <a href="/account" class:list={["nav-link", { active: pathname === '/account' }]}>Account</a>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to dark mode" aria-pressed="false">
            <span class="theme-toggle-icon" aria-hidden="true">◐</span>
          </button>
          <a href="/#importer-card" class="nav-cta">Read free</a>
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <div class="mobile-nav-panel">
            <a href="/">Reader</a>
            <a href="/#features">Features</a>
            <a href="/how-it-works">How it works</a>
            <a href="/rsvp-reader">RSVP</a>
            <a href="/bionic-reading">Bionic</a>
            <a href="/extension">Chrome extension</a>
            <a href="/blog">Blog</a>
            <a href="/account">Account</a>
            <a href="/#importer-card" class="mobile-nav-cta">Read free</a>
            <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to dark mode" aria-pressed="false">◐ Theme</button>
          </div>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Modals render here, outside <main>, so their fixed-position z-index
         is compared directly against the header instead of getting capped
         by <main>'s stacking context (a flex-item z-index quirk: even
         position:static flex children still establish one). -->
    <slot name="modal-portal" />

    <footer class="site-footer">
      <div class="container footer-container">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <img src="/images/brand-mark-96.png" width="22" height="22" alt="" decoding="async" class="footer-logo-mark" />
            BriskRead<span>.</span>
          </a>
          <p>Read the backlog, not the interface. RSVP, bionic reading, OCR and synced speech in one private browser tool.</p>
          <p class="footer-note">© {new Date().getFullYear()} BriskRead</p>
        </div>
        <div class="footer-group">
          <p>Read</p>
          <a href="/">Speed reader</a>
          <a href="/rsvp-reader">RSVP reader</a>
          <a href="/bionic-reading">Bionic reading</a>
          <a href="/pdf-to-speech">PDF to speech</a>
          <a href="/extension">Chrome extension</a>
        </div>
        <div class="footer-group">
          <p>Tools</p>
          <a href="/reading-speed-test">Reading speed test</a>
          <a href="/words-to-minutes">Words to minutes</a>
          <a href="/teleprompter">Online teleprompter</a>
          <a href="/readability-checker">Readability checker</a>
          <a href="/bionic-reading#converter">Bionic converter</a>
        </div>
        <div class="footer-group">
          <p>Learn</p>
          <a href="/how-it-works">How it works</a>
          <a href="/blog">Blog</a>
          <a href="/blog/best-online-speed-readers">Best online speed readers</a>
          <a href="/blog/how-to-speed-read-online">How to speed read online</a>
        </div>
        <div class="footer-group">
          <p>Company</p>
          <a href="/about">About</a>
          <a href="/account">Account &amp; sync</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const themeToggles = document.querySelectorAll('[data-theme-toggle]');
      const syncThemeToggle = () => {
        const isDark = document.documentElement.dataset.theme === 'dark' || document.documentElement.dataset.theme === 'amoled';
        themeToggles.forEach((toggle) => {
          toggle.setAttribute('aria-pressed', String(isDark));
          toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        });
      };
      themeToggles.forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', nextTheme);
          localStorage.setItem('theme', nextTheme);
          syncThemeToggle();
        });
      });
      syncThemeToggle();

      // The <details> menu stays open after in-page links (/#features) and ignores Esc; close it for both.
      const mobileNav = document.querySelector('.mobile-nav');
      mobileNav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { mobileNav.open = false; }));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileNav?.open) { mobileNav.open = false; mobileNav.querySelector('summary')?.focus(); }
      });
    </script>
    <script src="/site-motion.js" defer></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <script>
      import { createClient } from '@supabase/supabase-js';

      const url = document.body.dataset.supabaseUrl;
      const key = document.body.dataset.supabaseAnonKey;
      const supabase = url && key ? createClient(url, key) : null;

      (globalThis as any).briskreadSupabase = supabase;

      const renderAccount = async (session) => {
        const user = session?.user;
        globalThis.dispatchEvent(new CustomEvent('briskread:account', {
          detail: { user: user || null },
        }));
      };

      if (supabase) {
        const { data } = await supabase.auth.getSession();
        await renderAccount(data.session);
        supabase.auth.onAuthStateChange((_event, session) => {
          window.setTimeout(() => renderAccount(session), 0);
        });
      }
    </script>

    <style>
      .site-header {
        border-bottom: 1px solid color-mix(in srgb, var(--color-border) 85%, transparent);
        background-color: var(--color-bg-header);
        backdrop-filter: blur(16px) saturate(1.2);
        -webkit-backdrop-filter: blur(16px) saturate(1.2);
        position: sticky;
        top: 0;
        z-index: var(--z-sticky, 50);
      }
      .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 3.75rem;
      }
      .launch-strip {
        background: linear-gradient(90deg, #0a0a0c 0%, #12121a 50%, #0a0a0c 100%);
        color: rgba(255, 255, 255, 0.88);
        font-size: 0.72rem;
        font-weight: 550;
        letter-spacing: 0.01em;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }
      .launch-strip-inner {
        min-height: 2.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        text-align: center;
      }
      .launch-pill {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 50%;
        background: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(94, 106, 210, 0.28);
        animation: launch-pulse 2.4s var(--ease-out) infinite;
      }
      @keyframes launch-pulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(94, 106, 210, 0.22); opacity: 1; }
        50% { box-shadow: 0 0 0 6px rgba(94, 106, 210, 0.08); opacity: 0.85; }
      }
      .launch-strip a {
        color: #fff;
        text-decoration: none;
        font-weight: 650;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        transition: background-color 140ms var(--ease-out);
      }
      .launch-strip a:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }
      .skip-link {
        position: fixed;
        left: 1rem;
        top: 0.5rem;
        z-index: var(--z-toast);
        padding: 0.5rem 0.75rem;
        background: var(--color-bg-card);
        color: var(--color-text);
        transform: translateY(-150%);
      }
      .skip-link:focus { transform: translateY(0); }
      .logo-link {
        text-decoration: none;
        color: var(--color-text);
      }
      .logo-link:hover {
        text-decoration: none;
        color: var(--color-text);
      }
      .logo-container {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--font-sans);
        font-weight: 650;
        font-size: 1.05rem;
        letter-spacing: -0.03em;
      }
      .logo-mark-img {
        display: block;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 7px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.14);
      }
      .logo-text {
        color: var(--color-text);
      }
      .nav-links {
        display: flex;
        gap: 0.1rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
      }
      .nav-link {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: background-color 140ms var(--ease-out), color 140ms var(--ease-out);
        padding: 0.4rem 0.65rem;
        border-radius: 999px;
      }
      .nav-link:hover {
        color: var(--color-text);
        background-color: var(--color-bg-subtle);
        text-decoration: none;
      }
      .nav-link.active {
        color: var(--color-text);
        background: var(--color-primary-muted);
      }
      .theme-toggle {
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-bg-card);
        color: var(--color-text);
        cursor: pointer;
        font-size: 0.95rem;
        transition: border-color 140ms var(--ease-out), transform 140ms var(--ease-out);
      }
      .theme-toggle:hover { border-color: var(--color-text-subtle); transform: rotate(-12deg); }
      .nav-cta {
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        background: var(--color-primary);
        color: white;
        font-size: 0.78rem;
        font-weight: 650;
        letter-spacing: -0.01em;
        transition: background-color 140ms var(--ease-out), transform 140ms var(--ease-out), box-shadow 140ms var(--ease-out);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.12) inset;
      }
      .nav-cta:hover {
        background: var(--color-primary-hover);
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px -10px var(--color-primary-shadow);
      }
      .mobile-nav { display: none; position: relative; }
      .mobile-nav summary {
        display: grid;
        min-width: 3rem;
        min-height: 2.5rem;
        place-items: center;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-bg-card);
        color: var(--color-text);
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 650;
        list-style: none;
      }
      .mobile-nav summary::-webkit-details-marker { display: none; }
      .mobile-nav-panel {
        position: absolute;
        top: calc(100% + 0.55rem);
        right: 0;
        display: grid;
        width: min(19rem, calc(100vw - 2rem));
        padding: 0.45rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: var(--color-bg-card);
        box-shadow: var(--shadow-lg);
      }
      .mobile-nav-panel a, .mobile-nav-panel .theme-toggle {
        display: flex;
        width: 100%;
        min-height: 2.75rem;
        align-items: center;
        padding: 0.65rem 0.75rem;
        border: 0;
        border-radius: var(--radius-md);
        background: transparent;
        color: var(--color-text);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
      }
      .mobile-nav-panel a:hover, .mobile-nav-panel .theme-toggle:hover { background: var(--color-bg-subtle); }
      .mobile-nav-panel .mobile-nav-cta {
        background: var(--color-primary);
        color: white;
        border-radius: 999px;
        justify-content: center;
        margin-top: 0.15rem;
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: clamp(3.5rem, 8vw, 5.5rem) 0;
        margin-top: 5rem;
        font-size: 0.8125rem;
        color: var(--color-text-muted);
        background-color: var(--color-bg-footer);
      }
      .footer-container {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(100px, 1fr));
        align-items: start;
        gap: clamp(1.5rem, 4vw, 3rem);
        text-align: left;
      }
      .footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--color-text);
        font-size: 1.2rem;
        font-weight: 650;
        letter-spacing: -0.03em;
      }
      .footer-logo-mark {
        border-radius: 6px;
        object-fit: cover;
        flex-shrink: 0;
      }
      .footer-logo span { color: var(--color-primary); }
      .footer-brand > p { max-width: 40ch; margin-top: 0.75rem; line-height: 1.6; }
      .footer-note { font-size: 0.75rem; opacity: 0.8; }
      .footer-group { display: flex; flex-direction: column; gap: 0.55rem; }
      .footer-group p {
        color: var(--color-text);
        font-weight: 600;
        margin-bottom: 0.35rem;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .footer-group a {
        color: var(--color-text-muted);
        transition: color 140ms var(--ease-out), transform 140ms var(--ease-out);
      }
      .footer-group a:hover { color: var(--color-primary); transform: translateX(2px); }
      /* Dense nav collapses earlier so logo + CTA never crush mid-width */
      @media (max-width: 1080px) {
        .nav-links { display: none; }
        .mobile-nav { display: block; }
      }
      @media (max-width: 840px) {
        .header-container {
          min-height: 3.5rem;
          padding-block: 0.4rem;
        }
        .launch-strip-inner { justify-content: space-between; }
        .launch-strip-inner > span:not(.launch-pill) { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
        .launch-pill { display: none; }
        .footer-container { grid-template-columns: 1fr 1fr; }
        .footer-brand { grid-column: 1 / -1; }
      }
      @media (prefers-reduced-motion: reduce) {
        .launch-pill { animation: none; }
        .nav-cta:hover, .theme-toggle:hover, .footer-group a:hover { transform: none; }
      }
    </style>
